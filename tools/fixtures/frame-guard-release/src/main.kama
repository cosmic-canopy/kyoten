// tools/fixtures/frame-guard's 40,000-byte frame in a release build alone, over the engine's 32 KiB guard (components
// § Decided, question 6, choice 5): a debug build has a small frame instead. tools/test.sh builds it for the web at
// --release and expects the guard's refusal, `frame-larger-than`, so the guard is held at the level a game ships, and
// builds it in debug and expects it to build, so a release leg that lost its `--release` builds, and fails. The array is
// filled from the argument and summed, so no optimizer can drop it.

import { core::println, kyoten::version };

@compileFor(RELEASE)
fn int64 heavy(int32 seed) {
    InlineArray<int32>#(10000) big = [0; 10000];
    isize i = 0;
    while (i < 10000) {
        big[i] = seed + cast<int32>(i % 7);
        i = i + 1;
    }
    int64 sum = 0;
    i = 0;
    while (i < 10000) {
        sum = sum + cast<int64>(big[i]);
        i = i + 1;
    }
    return sum;
}

@compileFor(DEBUG)
fn int64 heavy(int32 seed) { return cast<int64>(seed); }

fn uint8 main() {
    int64 s = heavy(seed: 3);
    string v = version();
    println(s: "frame guard release fixture on kyoten ${v}: ${s}");
    return 0;
}
