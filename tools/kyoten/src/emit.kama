// The kama the first pass writes, into the game's `src/generated/` (components § Decided: the naming rule of
// 2026-11-07, and step 5.3's questions of 2026-11-09):
//
// - `actions.kama`: `Actions`, the engine's `player` and one field per action the game's modules declare, of its kind's
//   type.
// - `prefabs.kama`: each family's `<Base>Prefab`, a field per component, and `<Base>PrefabId`, a constructor per member
//   with the base as its default; then `Prefabs`, with one `<base>(id:)` per family. The loader fills `Prefabs` from
//   the content records (step 5.5).
//
// Before kama is asked which types the game declares, `prefabs.kama` holds only the names the records imply, a
// `<Name>Prefab` and a `<Name>PrefabId` for every prefab, so that the game's imports resolve (KY-28).
//
// Names a game writes are promised: `Actions` and its fields, the prefab types, their fields and ids, and
// `prefabs.<base>(id:)`. The rest (the lists inside `Prefabs`, an id's index, the import aliases) is the generator's own
// and may change in any release (rule 5).

import { std::collections::DynamicArray, std::collections::SortedMap, kyoten::records::ActionKind, Records, Family,
         Component, typeCase, headerLine };

export { actionsKama, prefabsStub, prefabsKama, actionListLines };

// The type of an action's field, its value before any input, and the `PlayerActions` reader that views it, by kind.
fn string fieldType(ActionKind k) {
    return match (k) {
        case Digital: "Digital"; case Analog: "float32"; case Vector2: "Vec2"; case Vector3: "Vec3"; case Pose: "Pose";
        case Text: "Text";
    };
}
fn string atRest(ActionKind k) {
    return match (k) {
        case Digital: "Digital.default()"; case Analog: "0.0"; case Vector2: "Vec2.zero()"; case Vector3: "Vec3.zero()";
        case Pose: "Pose.default()"; case Text: "Text.default()";
    };
}
fn string readerOf(ActionKind k) {
    return match (k) {
        case Digital: "digital"; case Analog: "analog"; case Vector2: "vector2"; case Vector3: "vector3"; case Pose: "pose";
        case Text: "text";
    };
}

fn string kindName(ActionKind k) {
    return match (k) {
        case Digital: "Digital"; case Analog: "Analog"; case Vector2: "Vector2"; case Vector3: "Vector3"; case Pose: "Pose";
        case Text: "Text";
    };
}

fn bool anyOf(const ref Records r, ActionKind k) {
    foreach (string a in r.actions()) { if (r.kindOf(action: a) == k) { return true; } }
    return false;
}

fn string actionsKama(const ref Records r) {
    string t = headerLine() + "\n";
    t = t + "// The game's actions, a field each, of its kind's type (components § Decided; design/input.md § Decided): a\n";
    t = t + "// `Digital`, an analog's `float32`, a `Vector2`'s `Vec2`, a `Vector3`'s `Vec3`, a `Pose` or a `Text`. The passes\n";
    t = t + "// fill them from the player the entity names before each processor that reads them runs, as that run sees them:\n";
    t = t + "// each edge, and each code point typed, once, on its first run at or after the step it landed in; a state as of\n";
    t = t + "// its step; and a delta, a distance moved, summed over every step since its last run (the first slice's step 8).\n\n";
    bool any = r.actions().length() > 0;
    string names = "";
    if (anyOf(r: r, k: ActionKind::Digital)) { names = "kyoten::frame::Digital, "; }
    if (anyOf(r: r, k: ActionKind::Pose)) { names = names + "kyoten::frame::Pose, "; }
    if (anyOf(r: r, k: ActionKind::Text)) { names = names + "kyoten::frame::Text, "; }
    if (anyOf(r: r, k: ActionKind::Vector2)) { names = names + "std::math::Vec2, "; }
    if (anyOf(r: r, k: ActionKind::Vector3)) { names = names + "std::math::Vec3, "; }
    if (any) { t = t + "import { " + names + "kyoten::frame::PlayerActions, kyoten::frame::Handoff };\n\n"; }
    t = t + "export { Actions, Views };\n\n";
    t = t + "@generate(Serializable, Deserializable)\ntype value Actions {\n";
    t = t + "    // The player whose input fills this entity's actions, numbered from 1.\n";
    t = t + "    @field public int32 player;\n";
    foreach (string a in r.actions()) {
        string module = copy r.actions().getRef(key: a);
        ActionKind k = r.kindOf(action: a);
        string delta = r.isDelta(action: a) ? ", a delta" : "";
        t = t + "    // A `" + kindName(k: k) + "`" + delta + ", declared by " + module + ".\n";
        t = t + "    @skip public " + fieldType(k: k) + " " + a + " = " + atRest(k: k) + ";\n";
    }
    t = t + "\n    public ctor forPlayer(int32 player) { this.player = player; }\n";
    if (!any) {
        t = t + "}\n";
        return t + viewsType(r: r);
    }
    t = t + "\n    // Each action as a run whose window is the steps after `after` up to `upTo` sees it, from the world's record\n";
    t = t + "    // of its player's: the generator's own, which the passes call.\n";
    t = t + "    public fn void viewFrom(const ref PlayerActions from, int64 after, int64 upTo) {\n";
    int32 digitals = 0;
    int32 analogs = 0;
    int32 vector2s = 0;
    int32 vector3s = 0;
    int32 poses = 0;
    int32 texts = 0;
    foreach (string a in r.actions()) {
        ActionKind k = r.kindOf(action: a);
        int32 index = match (k) {
            case Digital: digitals; case Analog: analogs; case Vector2: vector2s; case Vector3: vector3s; case Pose: poses;
            case Text: texts;
        };
        string window = k == ActionKind::Pose ? "upTo: upTo" : "after: after, upTo: upTo";
        t = t + "        this." + a + " = from." + readerOf(k: k) + "(player: this.player, action: ${index}, " + window + ");\n";
        match (k) {
            case Digital: { digitals = digitals + 1; } case Analog: { analogs = analogs + 1; }
            case Vector2: { vector2s = vector2s + 1; } case Vector3: { vector3s = vector3s + 1; }
            case Pose: { poses = poses + 1; } case Text: { texts = texts + 1; }
        };
    }
    t = t + "    }\n\n";
    t = t + "    // Each action as Output sees it: a digital's edges and a text's code points by steps, as a run whose window is\n";
    t = t + "    // the steps after `after` up to `upTo` does, and each value as `newest` holds it, the newest sample's\n";
    t = t + "    // (frame-phases § Decided): the generator's own, which the passes call.\n";
    t = t + "    public fn void viewNewest(const ref PlayerActions from, const ref Handoff newest, int64 after, int64 upTo) {\n";
    digitals = 0;
    analogs = 0;
    vector2s = 0;
    vector3s = 0;
    poses = 0;
    texts = 0;
    foreach (string a in r.actions()) {
        ActionKind k = r.kindOf(action: a);
        int32 index = match (k) {
            case Digital: digitals; case Analog: analogs; case Vector2: vector2s; case Vector3: vector3s; case Pose: poses;
            case Text: texts;
        };
        if (k == ActionKind::Digital || k == ActionKind::Text) {
            t = t + "        this." + a + " = from." + readerOf(k: k) + "(player: this.player, action: ${index}, after: after, upTo: upTo);\n";
        } else {
            t = t + "        this." + a + " = newest." + readerOf(k: k) + "(player: this.player, action: ${index});\n";
        }
        match (k) {
            case Digital: { digitals = digitals + 1; } case Analog: { analogs = analogs + 1; }
            case Vector2: { vector2s = vector2s + 1; } case Vector3: { vector3s = vector3s + 1; }
            case Pose: { poses = poses + 1; } case Text: { texts = texts + 1; }
        };
    }
    t = t + "    }\n}\n";
    return t + viewsType(r: r);
}

// The game's views, each the number a `DrawnView`'s `view` holds, in the order of their names, as a binding names one
// by its name (design/input.md § Decided, 2026-11-26, the sixth part's question 1).
fn string viewsType(const ref Records r) {
    string t = "\n// The game's views, each by the number whatever draws it writes in its `DrawnView`'s `view`, in the order of\n";
    t = t + "// their names; a binding names one by its name (`\"view\": \"world\"`).\n";
    t = t + "type value Views {\n";
    int32 i = 0;
    foreach (string v in r.views()) {
        string module = copy r.views().getRef(key: v);
        t = t + "    // Declared by " + module + ".\n";
        t = t + "    public comptime int32 " + v + " = ${i};\n";
        i = i + 1;
    }
    t = t + "}\n";
    return t;
}

// The body of the generated world's `actions()`: each action in the order of its name, which numbers each kind's
// actions as `Actions`' fields and `viewFrom` do, so the hand-off, the world's record and the binder agree.
fn string actionListLines(const ref Records r) {
    string t = "";
    foreach (string a in r.actions()) {
        ActionKind k = r.kindOf(action: a);
        string d = r.isDelta(action: a) ? "true" : "false";
        string line = match (k) {
            case Digital: "a.addDigital(name: \"" + a + "\");";
            case Analog: "a.addAnalog(name: \"" + a + "\", delta: " + d + ");";
            case Vector2: "a.addVector2(name: \"" + a + "\", delta: " + d + ");";
            case Vector3: "a.addVector3(name: \"" + a + "\", delta: " + d + ");";
            case Pose: "a.addPose(name: \"" + a + "\");";
            case Text: "a.addText(name: \"" + a + "\");";
        };
        t = t + "        " + line + "\n";
    }
    return t;
}

fn string prefabsStub(const ref Records r) {
    string t = headerLine() + "\n";
    t = t + "// The first pass's names, which the records alone imply, so kama can answer before the prefab types are written\n";
    t = t + "// whole.\n\n";
    DynamicArray<string> names = r.prefabNames();
    string exported = "";
    foreach (const ref string p in names.iterConst()) {
        string ty = typeCase(s: p);
        exported = exported + ty + "Prefab, " + ty + "PrefabId, ";
    }
    t = t + "export { " + exported + "Prefabs };\n\n";
    foreach (const ref string p in names.iterConst()) {
        string ty = typeCase(s: p);
        t = t + "type value " + ty + "Prefab { public default ctor make() { } }\n";
        t = t + "type value " + ty + "PrefabId { public default ctor make() { } }\n";
    }
    t = t + "type resource Prefabs { public ctor make() { } }\n";
    return t;
}

// The name a component's type is written by in prefabs.kama: its bare name, or, where two components share it, an
// alias made from its full path.
fn string aliasOf(const ref string path, const ref string name, const ref SortedMap<string, int32> uses) {
    if (uses.getRef(key: name) > 1) { return path.replace(old: "::", with: "_"); }
    return copy name;
}

fn string prefabsKama(const ref string game, const ref DynamicArray<Family> families) {
    string actionsPath = game + "::generated::Actions";
    // Every component, once, and how many share each bare name.
    SortedMap<string, string> named = SortedMap.empty();
    foreach (const ref Family f in families.iterConst()) {
        foreach (const ref Component c in f.components().iterConst()) {
            if (!named.contains(key: c.path())) { named.put(key: copy c.path(), value: copy c.name()); }
        }
    }
    SortedMap<string, int32> uses = SortedMap.empty();
    foreach (string p in named) {
        string n = copy named.getRef(key: p);
        int32 seen = uses.contains(key: n) ? uses.getRef(key: n) : 0;
        uses.put(key: give n, value: seen + 1);
    }
    string imports = "";
    foreach (string p in named) {
        string n = copy named.getRef(key: p);
        string entry = "";
        if (p == actionsPath) { entry = "Actions"; }
        else {
            string alias = aliasOf(path: p, name: n, uses: uses);
            entry = alias == n ? copy p : p + " as " + alias;
        }
        imports = imports + entry + ", ";
    }
    if (families.length() > 0) { imports = imports + "std::collections::DynamicArray, "; }

    string t = headerLine() + "\n";
    t = t + "// Each prefab family's type and id, and `Prefabs`, which holds the prefabs' values for a processor to start a new\n";
    t = t + "// entity from (components § Decided). The loader fills `Prefabs` from the content records (step 5.5).\n\n";
    if (!imports.isEmpty()) { t = t + "import { " + imports.substring(start: 0, end: imports.length() - 2) + " };\n\n"; }
    string exported = "";
    foreach (const ref Family f in families.iterConst()) {
        string ty = typeCase(s: f.root());
        exported = exported + ty + "Prefab, " + ty + "PrefabId, ";
    }
    t = t + "export { " + exported + "Prefabs };\n";
    foreach (const ref Family f in families.iterConst()) {
        string ty = typeCase(s: f.root());
        string members = "";
        foreach (const ref string m in f.members().iterConst()) {
            if (!members.isEmpty()) { members = members + ", "; }
            members = members + "`" + m + "`";
        }
        t = t + "\n// `" + f.root() + "`'s family: " + members + ".\n";
        t = t + "@generate(of)\ntype value " + ty + "Prefab {\n";
        foreach (const ref Component c in f.components().iterConst()) {
            string alias = c.path() == actionsPath ? "Actions" : aliasOf(path: c.path(), name: c.name(), uses: uses);
            // The visible mapping (components § Decided, question 8, 2026-11-06): where a required component came from.
            if (!c.requiredBy().isEmpty()) { t = t + "    // Required by `" + c.requiredBy() + "`.\n"; }
            t = t + "    public " + alias + " " + c.field() + ";\n";
        }
        t = t + "}\n\n";
        t = t + "// Which prefab of `" + f.root() + "`'s family a value starts from: `" + f.root() + "` unless it says.\n";
        t = t + "@generate(Equatable)\ntype value " + ty + "PrefabId {\n";
        t = t + "    isize index = 0;\n";
        t = t + "    friend Prefabs[index];\n\n";
        isize i = 0;
        foreach (const ref string m in f.members().iterConst()) {
            string kind = i == 0 ? "public default ctor " : "public ctor ";
            t = t + "    " + kind + m + "() { this.index = ${i}; }\n";
            i = i + 1;
        }
        t = t + "}\n";
    }
    t = t + "\n// The prefabs' values, a list per family in its members' order, built whole by the loader from the content records\n";
    t = t + "// (components § Decided, the loader's four questions of 2026-11-09).\n";
    t = t + "type resource Prefabs {\n";
    string ofParams = "";
    string ofBody = "";
    foreach (const ref Family f in families.iterConst()) {
        string ty = typeCase(s: f.root());
        t = t + "    DynamicArray<" + ty + "Prefab> of_" + f.root() + " = DynamicArray.empty();\n";
        ofParams = ofParams + (ofParams.isEmpty() ? "" : ", ") + "DynamicArray<" + ty + "Prefab> " + f.root();
        ofBody = ofBody + " this.of_" + f.root() + " = give " + f.root() + ";";
    }
    t = t + "\n    public ctor of(" + ofParams + ") {" + ofBody + " }\n";
    foreach (const ref Family f in families.iterConst()) {
        string ty = typeCase(s: f.root());
        t = t + "\n    // A prefab of `" + f.root() + "`'s family, to start a new entity from.\n";
        t = t + "    public const fn " + ty + "Prefab " + f.root() + "(" + ty + "PrefabId id) { return this.of_"
            + f.root() + "[id.index]; }\n";
    }
    t = t + "}\n";
    return t;
}
