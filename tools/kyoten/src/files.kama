// The generated files and the rule for clearing them (components § Decided, the naming rule of 2026-11-07, rule 1):
//
// - every generated file opens with the header;
// - each run writes the whole set, and deletes every file under `src/generated/` and every `*.generated.kama` under
//   `src/` that it did not write, so a renamed processor or a removed module leaves nothing stale;
// - a file under those names without the header is someone's own: it is refused, never deleted;
// - `kyoten clean` removes them all.

import { std::collections::DynamicArray, std::io::IoError, std::fs::readText, std::fs::writeText, std::fs::remove,
         std::fs::removeDir, std::fs::removeDirAll, std::fs::createDirAll, std::fs::exists, Manifest, Refusals,
         filesUnder, dirOf };

export { headerLine, Kept, generatedFiles, checkHeaders, writeIfChanged, removeFile };

// The first line of every generated file.
fn string headerLine() { return "// generated by kyoten: never edit, never commit"; }

// The generated files there are now, relative to the game's root: `src/generated/…` and `src/…/*.generated.kama`.
unsafe fn DynamicArray<string> generatedFiles(const ref Manifest game) {
    DynamicArray<string> all = filesUnder(dir: game.sourceDir());
    DynamicArray<string> found = DynamicArray.empty();
    foreach (const ref string rel in all.iterConst()) {
        if (rel.startsWith(prefix: "generated/") || rel.endsWith(suffix: ".generated.kama")) { found.add(item: "src/" + rel); }
    }
    return found;
}

unsafe fn string textOf(const ref string path) {
    Result<string, IoError> t = readText(path: path);
    return match (give t) { case Ok(value: s): give s; case Err(error: e): ""; };
}

// Refuse every generated name without the header.
unsafe fn void checkHeaders(const ref Manifest game, const ref DynamicArray<string> files, ref Refusals no) {
    foreach (const ref string f in files.iterConst()) {
        string text = textOf(path: game.root() + "/" + f);
        if (!text.startsWith(prefix: headerLine())) {
            no.add(where: f, what: "a generated name without kyoten's header, so it is not kyoten's to write or delete: rename or remove it");
        }
    }
}

// Write `text` at `path` unless it is there already, so an unchanged file keeps its time and kama its object.
unsafe fn void writeIfChanged(const ref string path, const ref string text) {
    if (exists(path: path) && textOf(path: path) == text) { return; }
    Result<Unit, IoError> made = createDirAll(path: dirOf(path: path));
    Result<isize, IoError> wrote = writeText(path: path, text: text);
}

unsafe fn void removeFile(const ref string path) {
    if (exists(path: path)) { Result<Unit, IoError> r = remove(path: path); }
}

// What a file held before a run touched it, to put back when the run is refused.
type resource Kept {
    string path = "";
    bool was = false;
    string text = "";

    public unsafe ctor of(string path) {
        this.was = exists(path: path);
        if (this.was) { this.text = textOf(path: path); }
        this.path = give path;
    }

    public unsafe fn void restore() {
        if (this.was) { writeIfChanged(path: this.path, text: this.text); }
        else {
            removeFile(path: this.path);
            Result<Unit, IoError> r = removeDir(path: dirOf(path: this.path));
        }
    }
}
