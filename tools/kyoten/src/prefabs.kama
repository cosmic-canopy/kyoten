// Prefabs resolved to their components and grouped into families (components § Decided: the naming rule's rule 4, a
// create queue's family, both of 2026-11-07; step 5.3's question 1 and step 5.5's four, of 2026-11-09).
//
// - A prefab's key names a component by its bare name, while exactly one type the game and its dependencies declare
//   has it, or by its full path, which always works. A component record's `requires` names one the same way.
// - A prefab's listed components are its base's, if it is a variant, with its own added and its `null`s dropped. Its
//   components are those, with every component they require, through a chain. A requirement adds what the prefab
//   lacks and never overwrites what it lists; one whose type elects no `default ctor` must be listed; and a prefab may
//   not drop what its other components require.
// - A family is a base prefab and every variant with the same components, directly or through a chain, and it has
//   one generated type. A variant that adds or drops a component has its own.
//
// Requirements come from the game's own component records; a dependency's and the engine's arrive with step 9.

import { std::collections::DynamicArray, std::collections::SortedMap, kyoten::records::Store, Records, PrefabDecl,
         CodeFile, Index, Refusals, fieldCase, isReserved, inModule, lastOf, moduleOfPath };

export { Component, Family, resolveFamilies, spellingsOf, shownName };

// A component as a prefab type holds it: its full path, its bare name, its field, and the component whose
// requirement added it ("" when the prefab lists it).
type resource Component {
    string fullPath = "";
    string bareName = "";
    string fieldName = "";
    string requirer = "";

    public ctor make(string path, string name, string field, string requiredBy) {
        this.fullPath = give path;
        this.bareName = give name;
        this.fieldName = give field;
        this.requirer = give requiredBy;
    }

    public const fn const ref string path() { return this.fullPath; }
    public const fn const ref string name() { return this.bareName; }
    public const fn const ref string field() { return this.fieldName; }
    public const fn const ref string requiredBy() { return this.requirer; }
}

// A family: its base prefab, its members (the base first, then the rest by name), and its components by field.
type resource Family {
    string origin = "";
    DynamicArray<string> memberNames = DynamicArray.empty();
    DynamicArray<Component> parts = DynamicArray.empty();

    public ctor make(string origin, DynamicArray<string> members, DynamicArray<Component> parts) {
        this.origin = give origin;
        this.memberNames = give members;
        this.parts = give parts;
    }

    public const fn const ref string root() { return this.origin; }
    public const fn const ref DynamicArray<string> members() { return this.memberNames; }
    public const fn const ref DynamicArray<Component> components() { return this.parts; }
}

// The refusal of a component its module does not export: the generated module imports every component, and kama
// would refuse that import in generated code, naming neither the record nor the fix.
unsafe fn void notExported(const ref string subject, const ref string key, const ref string path, const ref string file,
                           ref Refusals no) {
    string module = moduleOfPath(path: path);
    string name = lastOf(path: path);
    no.add(where: file, what: "${subject} names `${key}`, which module `${module}` does not export: add `${name}` to its file's `export { … }`, since a component is an exported `type value`");
}

// The full path a key names, or "" when it names none, which is refused. `subject` is what names it, as a refusal
// opens: "prefab `tower`", or "component `Gate`'s `requires`". A bare name resolves among the exported `type value`s,
// since no other module can name a type its module keeps, and kama says which are exported (KR-360).
unsafe fn string resolveKey(const ref Index idx, const ref string key, const ref string subject, const ref string file,
                            ref Refusals no) {
    if (key.contains(substring: "::")) {
        string kind = idx.kindAt(path: key);
        if (kind.isEmpty()) {
            no.add(where: file, what: "${subject} names `${key}`, which is no type the game or its dependencies declare");
            return "";
        }
        if (kind != "value") {
            no.add(where: file, what: "${subject} names `${key}`, a ${kind}, and a component is a `type value`");
            return "";
        }
        if (!idx.exportedAt(path: key)) {
            notExported(subject: subject, key: key, path: key, file: file, no: no);
            return "";
        }
        return copy key;
    }
    DynamicArray<string> paths = idx.named(name: key);
    DynamicArray<string> values = DynamicArray.empty();
    string hidden = "";
    string otherKind = "";
    foreach (const ref string p in paths.iterConst()) {
        string kind = idx.kindAt(path: p);
        if (kind != "value") { otherKind = copy kind; }
        else if (idx.exportedAt(path: p)) { values.add(item: copy p); }
        else { hidden = copy p; }
    }
    if (values.length() == 1) { return copy values[0]; }
    if (values.length() > 1) {
        string all = "";
        foreach (const ref string v in values.iterConst()) {
            if (!all.isEmpty()) { all = all + " and "; }
            all = all + "`" + v + "`";
        }
        no.add(where: file, what: "${subject} names `${key}`, which is ${all}: write the full path of the one it means");
        return "";
    }
    if (!hidden.isEmpty()) {
        notExported(subject: subject, key: key, path: hidden, file: file, no: no);
        return "";
    }
    if (!otherKind.isEmpty()) {
        no.add(where: file, what: "${subject} names `${key}`, a ${otherKind}, and a component is a `type value`");
        return "";
    }
    no.add(where: file, what: "${subject} names `${key}`, which is no type the game or its dependencies declare: a component is an exported `type value`");
    return "";
}

// Each prefab's own keys resolved, refusing one component written twice; `dropped` gets its `null`s the same way.
unsafe fn void resolveOwn(const ref Records r, const ref Index idx, ref SortedMap<string, DynamicArray<string>> added,
                          ref SortedMap<string, DynamicArray<string>> dropped, ref Refusals no) {
    DynamicArray<string> names = r.prefabNames();
    foreach (const ref string p in names.iterConst()) {
        string file = copy r.prefabs().getRef(key: p).where();
        string subject = "prefab `" + p + "`";
        SortedMap<string, string> spelled = SortedMap.empty();
        DynamicArray<string> keys = copy r.prefabs().getRef(key: p).added();
        foreach (const ref string k in keys.iterConst()) {
            string path = resolveKey(idx: idx, key: k, subject: subject, file: file, no: no);
            if (path.isEmpty()) { continue; }
            if (spelled.contains(key: path)) {
                string first = copy spelled.getRef(key: path);
                no.add(where: file, what: "prefab `${p}` writes `${path}` twice, as `${first}` and `${k}`");
                continue;
            }
            spelled.put(key: copy path, value: copy k);
        }
        added.put(key: copy p, value: spelled.keys());
        SortedMap<string, bool> gone = SortedMap.empty();
        DynamicArray<string> nulls = copy r.prefabs().getRef(key: p).dropped();
        foreach (const ref string k in nulls.iterConst()) {
            string path = resolveKey(idx: idx, key: k, subject: subject, file: file, no: no);
            if (!path.isEmpty()) { gone.put(key: copy path, value: true); }
        }
        dropped.put(key: copy p, value: gone.keys());
    }
}

// What each component record requires, by the full path of the component whose record it is, resolved. Refused: a
// world component that requires anything, since no entity holds it; a requirement that does not resolve; and one that
// names a world component, which the world holds once rather than each entity.
unsafe fn SortedMap<string, DynamicArray<string>> requirements(const ref Records r, const ref Index idx, ref Refusals no) {
    SortedMap<string, bool> world = SortedMap.empty();
    foreach (const ref CodeFile f in r.code().iterConst()) {
        DynamicArray<string> names = f.record().components().keys();
        foreach (const ref string c in names.iterConst()) {
            match (f.record().components().getRef(key: c).store()) {
                case World: { world.put(key: inModule(module: f.module(), name: c), value: true); }
                case _: { }
            };
        }
    }
    SortedMap<string, DynamicArray<string>> made = SortedMap.empty();
    foreach (const ref CodeFile f in r.code().iterConst()) {
        DynamicArray<string> names = f.record().components().keys();
        foreach (const ref string c in names.iterConst()) {
            DynamicArray<string> wanted = copy f.record().components().getRef(key: c).requires();
            if (wanted.length() == 0) { continue; }
            string path = inModule(module: f.module(), name: c);
            if (world.contains(key: path)) {
                no.add(where: f.file(), what: "component `${c}` is a world component, which no entity holds, so it requires nothing: drop its `requires`");
                continue;
            }
            string subject = "component `" + c + "`'s `requires`";
            DynamicArray<string> resolved = DynamicArray.empty();
            foreach (const ref string w in wanted.iterConst()) {
                string to = resolveKey(idx: idx, key: w, subject: subject, file: f.file(), no: no);
                if (to.isEmpty()) { continue; }
                if (world.contains(key: to)) {
                    no.add(where: f.file(), what: "${subject} names `${w}`, a world component: the world holds one, not each entity");
                    continue;
                }
                if (!resolved.contains(item: to)) { resolved.add(item: copy to); }
            }
            made.put(key: give path, value: give resolved);
        }
    }
    return made;
}

// A prefab's listed components, by full path, sorted: its base's, with its own added and its `null`s dropped.
unsafe fn DynamicArray<string> listedOf(const ref string p, const ref Records r,
                                        const ref SortedMap<string, DynamicArray<string>> added,
                                        const ref SortedMap<string, DynamicArray<string>> dropped,
                                        ref SortedMap<string, DynamicArray<string>> memo) {
    if (memo.contains(key: p)) { return copy memo.getRef(key: p); }
    SortedMap<string, bool> s = SortedMap.empty();
    string origin = copy r.prefabs().getRef(key: p).from();
    if (!origin.isEmpty()) {
        DynamicArray<string> inherited = listedOf(p: origin, r: r, added: added, dropped: dropped, memo: memo);
        foreach (const ref string c in inherited.iterConst()) { s.put(key: copy c, value: true); }
    }
    foreach (const ref string c in added.getRef(key: p).iterConst()) { s.put(key: copy c, value: true); }
    foreach (const ref string c in dropped.getRef(key: p).iterConst()) { Optional<bool> was = s.remove(key: c); }
    DynamicArray<string> made = s.keys();
    memo.put(key: copy p, value: copy made);
    return made;
}

// Listed components with every one they require, through a chain, sorted; a circle ends, since each is added once.
// `requiredBy` gets, for each component a requirement added, the component whose requirement added it first.
fn DynamicArray<string> closed(const ref DynamicArray<string> listed,
                               const ref SortedMap<string, DynamicArray<string>> requires,
                               ref SortedMap<string, string> requiredBy) {
    SortedMap<string, bool> have = SortedMap.empty();
    DynamicArray<string> queue = DynamicArray.empty();
    foreach (const ref string c in listed.iterConst()) { have.put(key: copy c, value: true); queue.add(item: copy c); }
    isize i = 0;
    while (i < queue.length()) {
        string c = copy queue[i];
        if (requires.contains(key: c)) {
            foreach (const ref string needed in requires.getRef(key: c).iterConst()) {
                if (have.contains(key: needed)) { continue; }
                have.put(key: copy needed, value: true);
                requiredBy.put(key: copy needed, value: copy c);
                queue.add(item: copy needed);
            }
        }
        i = i + 1;
    }
    return have.keys();
}

// The base of a prefab's family: itself, unless it is a variant with its base's components.
unsafe fn string familyOf(const ref string p, const ref Records r, const ref SortedMap<string, DynamicArray<string>> sets) {
    string origin = copy r.prefabs().getRef(key: p).from();
    if (origin.isEmpty()) { return copy p; }
    if (sets.getRef(key: p).equals(other: sets.getRef(key: origin))) { return familyOf(p: origin, r: r, sets: sets); }
    return copy p;
}

// The families the content's prefabs make, refusing what does not resolve. A key that does not resolve is left out and
// the rest go on, so one run names every problem; a refused run's families are not used.
unsafe fn DynamicArray<Family> resolveFamilies(const ref Records r, const ref Index idx, ref Refusals no) {
    SortedMap<string, DynamicArray<string>> added = SortedMap.empty();
    SortedMap<string, DynamicArray<string>> dropped = SortedMap.empty();
    resolveOwn(r: r, idx: idx, added: added, dropped: dropped, no: no);
    SortedMap<string, DynamicArray<string>> requires = requirements(r: r, idx: idx, no: no);
    DynamicArray<Family> families = DynamicArray.empty();
    SortedMap<string, DynamicArray<string>> listedSets = SortedMap.empty();
    SortedMap<string, DynamicArray<string>> sets = SortedMap.empty();
    SortedMap<string, SortedMap<string, string>> requirers = SortedMap.empty();
    DynamicArray<string> names = r.prefabNames();
    foreach (const ref string p in names.iterConst()) {
        DynamicArray<string> listed = listedOf(p: p, r: r, added: added, dropped: dropped, memo: listedSets);
        SortedMap<string, string> by = SortedMap.empty();
        DynamicArray<string> all = closed(listed: listed, requires: requires, requiredBy: by);
        string file = copy r.prefabs().getRef(key: p).where();
        // A `null` drops nothing a remaining component requires (step 5.5's question 2).
        foreach (const ref string d in dropped.getRef(key: p).iterConst()) {
            if (!by.contains(key: d)) { continue; }
            string who = copy by.getRef(key: d);
            no.add(where: file, what: "prefab `${p}` drops `${d}`, but `${who}` requires it: drop `${who}` too, or keep `${d}`");
        }
        // A requirement adds a component from its defaults, so one without must be listed (question 8, 2026-11-06).
        DynamicArray<string> required = by.keys();
        foreach (const ref string a in required.iterConst()) {
            if (idx.defaultAt(path: a)) { continue; }
            string who = copy by.getRef(key: a);
            no.add(where: file, what: "prefab `${p}` lacks `${a}`, which `${who}` requires and which elects no `default ctor`: list it in the prefab, with its values");
        }
        sets.put(key: copy p, value: give all);
        requirers.put(key: copy p, value: give by);
    }
    SortedMap<string, DynamicArray<string>> membersOf = SortedMap.empty();
    foreach (const ref string p in names.iterConst()) {
        string root = familyOf(p: p, r: r, sets: sets);
        if (!membersOf.contains(key: root)) {
            DynamicArray<string> first = DynamicArray.empty();
            first.add(item: copy root);
            membersOf.put(key: copy root, value: give first);
        }
        if (p != root) { membersOf.getRefMut(key: root).add(item: copy p); }
    }
    DynamicArray<string> roots = membersOf.keys();
    foreach (const ref string root in roots.iterConst()) {
        string file = copy r.prefabs().getRef(key: root).where();
        SortedMap<string, string> byField = SortedMap.empty();
        SortedMap<string, string> nameOf = SortedMap.empty();
        foreach (const ref string path in sets.getRef(key: root).iterConst()) {
            string name = idx.nameAt(path: path);
            string field = fieldCase(s: name);
            if (byField.contains(key: field)) {
                string other = copy byField.getRef(key: field);
                no.add(where: file, what: "prefab `${root}` has two components named `${name}` (`${other}` and `${path}`), and how a prefab type spells two such fields is not decided yet: give one another name");
                continue;
            }
            if (isReserved(s: field) || field == "of") {
                no.add(where: file, what: "prefab `${root}`: component `${path}` would be the field `${field}`, a reserved word in kama or C: rename the type");
                continue;
            }
            byField.put(key: copy field, value: copy path);
            nameOf.put(key: copy field, value: give name);
        }
        DynamicArray<Component> parts = DynamicArray.empty();
        DynamicArray<string> fields = byField.keys();
        foreach (const ref string f in fields.iterConst()) {
            string path = copy byField.getRef(key: f);
            string by = requirers.getRef(key: root).contains(key: path) ? copy requirers.getRef(key: root).getRef(key: path) : "";
            parts.add(item: Component.make(path: give path, name: copy nameOf.getRef(key: f), field: copy f, requiredBy: give by));
        }
        families.add(item: Family.make(origin: copy root, members: copy membersOf.getRef(key: root), parts: give parts));
    }
    return families;
}

// Whether a bare name reads as one component: exactly one exported `type value` has it, as `resolveKey` reads a key.
fn bool bareResolves(const ref Index idx, const ref string name) {
    DynamicArray<string> paths = idx.named(name: name);
    int32 n = 0;
    foreach (const ref string p in paths.iterConst()) {
        if (idx.kindAt(path: p) == "value" && idx.exportedAt(path: p)) { n = n + 1; }
    }
    return n == 1;
}

// The keys a record may name a component by, as the loader matches them: its bare name while it reads as one
// component, and its full path always.
fn DynamicArray<string> spellingsOf(const ref Component c, const ref Index idx) {
    DynamicArray<string> keys = DynamicArray.empty();
    if (bareResolves(idx: idx, name: c.name())) { keys.add(item: copy c.name()); }
    keys.add(item: copy c.path());
    return keys;
}

// A component as a refusal names it: its bare name while that reads as one component, else its full path.
fn string shownName(const ref Component c, const ref Index idx) {
    if (bareResolves(idx: idx, name: c.name())) { return copy c.name(); }
    return copy c.path();
}
