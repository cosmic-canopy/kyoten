// The spin fixture, the hello cube without Mesh (step 9's): what the first pass writes, the header rule, the
// dependency cache, and the commands (components § Decided, the naming rule of 2026-11-07 and step 5.3's questions of
// 2026-11-09); then the second pass's world, stepped 60 times through the frame's driver, each cube's rate and
// rotation the same bits as the same turns made by hand (step 5.4).

import { Tally, Setup, Ran, has, read, write, erase, eraseDir, linesAfter, lastAfter, std::collections::DynamicArray };

export { spinTests, ranAs, none, check };

fn DynamicArray<string> none() { return DynamicArray.empty(); }

// A case on one run: it exited `want` and said `says` ("" for anything).
fn void ranAs(ref Tally t, const ref string name, const ref Ran r, int64 want, const ref string says) {
    int64 got = r.code();
    string said = copy r.said();
    if (got != want) { t.verdict(name: name, why: "exit ${got}, wanted ${want}: ${said}"); return; }
    if (!says.isEmpty() && !r.says(what: says)) { t.verdict(name: name, why: "no `${says}` in: ${said}"); return; }
    t.verdict(name: name, why: "");
}

// A case on a condition. A failing case's reason is often a run's output, which is empty when the output went missing,
// and the tally reads an empty reason as a pass, so a failure is never given one.
fn void check(ref Tally t, const ref string name, bool ok, const ref string why) {
    if (ok) { t.verdict(name: name, why: ""); return; }
    if (why.isEmpty()) { t.verdict(name: name, why: "failed, and nothing was said"); return; }
    t.verdict(name: name, why: why);
}

// `main` loads the content after the turns by hand, and prints this line before the placed world's Output.
fn string placedMarker() { return "spin: placed world"; }

// The text before `marker`, or all of it; and the text from it on, or "".
fn string before(const ref string text, const ref string marker) {
    match (text.find(substring: marker)) { case Some(value: at): { return text.substring(start: 0, end: at); } case None: { return copy text; } };
}
fn string after(const ref string text, const ref string marker) {
    match (text.find(substring: marker)) { case Some(value: at): { return text.substring(start: at, end: text.length()); } case None: { return ""; } };
}

// The loader (step 5.5): the content folder read through the stack; each family's prefabs laid in layer order, a
// variant over its base; the first scene's placements made rows, a placement's values over its prefab's, which the
// placed world's Output shows; and a mod's content, held in memory, refused at load by its file, prefab and component.
fn void loaded(ref Tally t, const ref string leg, const ref Ran r) {
    string said = copy r.said();
    check(t: t, name: "spin: ${leg}: the loader lays each prefab's components over their defaults, a variant over its base",
          ok: r.says(what: "loaded: cube rate 2 player 1, fastCube rate 4, bigCube rate 2 size 2"), why: said);
    string placed = after(text: said, marker: placedMarker());
    DynamicArray<string> shown = linesAfter(text: placed, prefix: "shown: ");
    // 2.0 is 0x40000000, 5.0 is 0x40a00000, 4.0 is 0x40800000 and 1.0 is 0x3f800000: `cube` at its prefab's rate,
    // `fast` at its own over `fastCube`'s, and `quick`, with no values, at `fastCube`'s.
    bool rows = shown.length() == 3 && shown[0] == "slot 0 rate 1073741824 rotation 0 0 0 1065353216 at 0"
        && shown[1] == "slot 1 rate 1084227584 rotation 0 0 0 1065353216 at 0"
        && shown[2] == "slot 2 rate 1082130432 rotation 0 0 0 1065353216 at 0";
    check(t: t, name: "spin: ${leg}: the first scene's placements become rows, each from its prefab's values, its own over them",
          ok: rows && r.says(what: "spin: placed world, 3 placed"), why: placed);
    check(t: t, name: "spin: ${leg}: a mod's misspelt field is refused at load, naming its file, prefab and component",
          ok: r.says(what: "refused at load: mod/cube.records.json: prefab `cube`, `Spin`: unknown field `rat`"), why: said);
    check(t: t, name: "spin: ${leg}: a mod's component with no default and a missing field is refused at load",
          ok: r.says(what: "refused at load: mod/cube.records.json: prefab `cube`, `Actions`: missing field `player`"), why: said);
    check(t: t, name: "spin: ${leg}: a mod's prefab that is not in the build is refused at load",
          ok: r.says(what: "refused at load: mod/cube.records.json: prefab `extra` is not in this build"), why: said);
    check(t: t, name: "spin: ${leg}: a mod's key naming no component of its prefab's family is refused at load",
          ok: r.says(what: "refused at load: mod/cube.records.json: prefab `bigCube` names `Glw`, which is no component of its family"),
          why: said);
}

// What the generated world did with the two cubes, against the same turns by hand: `show`, an Output processor, prints
// each cube's rate and rotation as bits, and `main` prints what `turn` gives when the same steps are taken by hand.
fn void sameTurns(ref Tally t, const ref string leg, const ref Ran r) {
    string said = before(text: r.said(), marker: placedMarker());
    DynamicArray<string> shown = linesAfter(text: said, prefix: "shown: ");
    DynamicArray<string> expected = linesAfter(text: said, prefix: "expect: ");
    string why = "";
    if (shown.length() != 2 || expected.length() != 2) {
        isize ns = shown.length();
        isize ne = expected.length();
        why = "${ns} shown and ${ne} expected lines, wanted 2 of each: ${said}";
    } else if (shown[0] != expected[0]) {
        string a = copy shown[0];
        string b = copy expected[0];
        why = "the cube at rest: shown `${a}`, by hand `${b}`";
    } else if (shown[1] != expected[1]) {
        string a = copy shown[1];
        string b = copy expected[1];
        why = "the cube whose `faster` is held: shown `${a}`, by hand `${b}`";
    }
    t.verdict(name: "spin: ${leg}: 60 steps of the generated world turn each cube as `turn` does by hand, bit for bit", why: why);
    check(t: t, name: "spin: ${leg}: the base clock is 60 Hz, the one rate its processors run at",
          ok: r.says(what: "spin: base 60 Hz"), why: said);
}

unsafe fn void spinTests(ref Tally t, ref Setup s) {
    string header = "// generated by kyoten: never edit, never commit";
    string gen = s.fixture(at: "spin/src/generated");
    string actions = gen + "/actions.kama";
    string prefabs = gen + "/prefabs.kama";
    string moduleFile = s.fixture(at: "spin/src/cube/cube.generated.kama");
    string mine = s.fixture(at: "spin/src/cube/notes.generated.kama");
    DynamicArray<string> install = DynamicArray.empty();
    install.add(item: "pkg");
    install.add(item: "install");
    install.add(item: s.fixture(at: "spin/kama.json"));
    Ran installed = s.kamaRun(argv: install);
    ranAs(t: t, name: "spin: kama pkg install", r: installed, want: 0, says: "");

    // A fresh clone has nothing generated, so kama alone cannot even resolve the game's imports (KY-28), and no `out/`,
    // where the tool caches what kama said of each dependency.
    eraseDir(path: gen);
    erase(path: moduleFile);
    eraseDir(path: s.fixture(at: "spin/out"));
    Ran fresh = s.kyoten(command: "check", game: "spin", more: none());
    ranAs(t: t, name: "spin: on a fresh clone, `kyoten check` generates, then kama checks", r: fresh, want: 0, says: "OK");
    string actionsText = read(path: actions);
    string prefabsText = read(path: prefabs);
    check(t: t, name: "spin: actions.kama and prefabs.kama open with the header",
          ok: actionsText.startsWith(prefix: header) && prefabsText.startsWith(prefix: header),
          why: "no header in: ${actionsText}\n${prefabsText}");
    check(t: t, name: "spin: each dependency's components are asked for the first time",
          ok: fresh.says(what: "components of kyoten: asked") && fresh.says(what: "components of glow: asked"),
          why: fresh.said());

    Ran again = s.kyoten(command: "generate", game: "spin", more: none());
    ranAs(t: t, name: "spin: `kyoten generate` again", r: again, want: 0, says: "");
    string actionsAgain = read(path: actions);
    string prefabsAgain = read(path: prefabs);
    check(t: t, name: "spin: a second run writes the same files",
          ok: actionsAgain == actionsText && prefabsAgain == prefabsText, why: "the files changed");
    check(t: t, name: "spin: unchanged dependencies come from the cache",
          ok: again.says(what: "components of kyoten: cached") && again.says(what: "components of glow: cached"),
          why: again.said());

    string stamp = s.fixture(at: "glow/src/stamp.kama");
    write(path: stamp, text: "// a change to glow's sources, made by the kyoten tool's tests and removed by them\n");
    Ran changed = s.kyoten(command: "generate", game: "spin", more: none());
    erase(path: stamp);
    check(t: t, name: "spin: a change to a dependency's sources asks kama again, for that dependency alone",
          ok: changed.code() == 0 && changed.says(what: "components of glow: asked")
              && changed.says(what: "components of kyoten: cached"),
          why: changed.said());
    // A cached answer of another format is asked again, so a cache written before the tool learned something new (step
    // 5.5: each type's `default ctor`; KR-360: whether it is exported) is never read as if it knew it.
    // The run above cached glow's answer with the stamp in its sources, so it is asked again once, to cache it as it is
    // now; then only the format differs.
    Ran recached = s.kyoten(command: "generate", game: "spin", more: none());
    Ran warm = s.kyoten(command: "generate", game: "spin", more: none());
    string cached = s.fixture(at: "spin/out/kyoten/components/glow.json");
    string answer = read(path: cached);
    write(path: cached, text: answer.replace(old: "\"format\":2", with: "\"format\":1"));
    Ran reformatted = s.kyoten(command: "generate", game: "spin", more: none());
    check(t: t, name: "spin: a cached answer of another format is asked again",
          ok: recached.code() == 0 && warm.says(what: "components of glow: cached")
              && answer.contains(substring: "\"format\":2") && answer.contains(substring: "\"exported\":true")
              && reformatted.code() == 0
              && reformatted.says(what: "components of glow: asked") && reformatted.says(what: "components of kyoten: cached"),
          why: warm.said() + "\n" + reformatted.said() + "\n" + answer);

    Ran ran = s.kyoten(command: "run", game: "spin", more: none());
    ranAs(t: t, name: "spin: `kyoten run`, whose main reads every generated name", r: ran, want: 0,
          says: "spin: player 1, faster held false, cube spin 1, big cube size 1 glow 1, ids true true");
    sameTurns(t: t, leg: "native", r: ran);
    loaded(t: t, leg: "native", r: ran);
    string tables = read(path: gen + "/tables.kama");
    string passes = read(path: gen + "/passes.kama");
    string world = read(path: gen + "/world.kama");
    check(t: t, name: "spin: tables.kama, passes.kama and world.kama open with the header",
          ok: tables.startsWith(prefix: header) && passes.startsWith(prefix: header) && world.startsWith(prefix: header),
          why: "a file is missing or has no header");
    // The naming rule's rule 5: a column may not share a processor's name in one file, so only passes.kama imports
    // processors.
    check(t: t, name: "spin: only passes.kama imports the processors",
          ok: passes.contains(substring: "spin::cube::turn") && passes.contains(substring: "spin::view::show")
              && !tables.contains(substring: "spin::cube::turn") && !world.contains(substring: "spin::cube::turn")
              && !tables.contains(substring: "spin::view::show") && !world.contains(substring: "spin::view::show"),
          why: tables + "\n" + world);
    DynamicArray<string> release = DynamicArray.empty();
    release.add(item: "--release");
    Ran ranRelease = s.kyoten(command: "run", game: "spin", more: release);
    ranAs(t: t, name: "spin: `kyoten run --release` passes its flag to kama", r: ranRelease, want: 0,
          says: "spin: player 1, faster held false");
    sameTurns(t: t, leg: "native release", r: ranRelease);
    loaded(t: t, leg: "native release", r: ranRelease);
    if (s.wasm()) {
        string js = s.fixture(at: "spin/out/web/spin.js");
        DynamicArray<string> web = DynamicArray.empty();
        web.add(item: "--target");
        web.add(item: "WASM");
        web.add(item: "-o");
        web.add(item: copy js);
        Ran built = s.kyoten(command: "build", game: "spin", more: web);
        ranAs(t: t, name: "spin: `kyoten build --target WASM`", r: built, want: 0, says: "");
        DynamicArray<string> node = DynamicArray.empty();
        node.add(item: "spin.js");
        Ran underNode = s.runProgramIn(program: "node", argv: node, dir: s.fixture(at: "spin/out/web"));
        ranAs(t: t, name: "spin: the web build runs under node", r: underNode, want: 0,
              says: "spin: player 1, faster held false");
        sameTurns(t: t, leg: "wasm under node", r: underNode);
        loaded(t: t, leg: "wasm under node", r: underNode);
    }

    // The naming rule's clearing (2026-11-07): each run deletes what it did not write, if it carries the header.
    write(path: gen + "/old.kama", text: header + "\n");
    write(path: moduleFile, text: header + "\n");
    Ran cleared = s.kyoten(command: "generate", game: "spin", more: none());
    check(t: t, name: "spin: generated files a run did not write are deleted",
          ok: cleared.code() == 0 && !has(path: gen + "/old.kama") && !has(path: moduleFile) && has(path: actions),
          why: cleared.said());

    // A file under a generated name without the header is someone's own: refused, never deleted, nothing written.
    eraseDir(path: gen);
    write(path: mine, text: "// mine\n");
    Ran foreign = s.kyoten(command: "generate", game: "spin", more: none());
    ranAs(t: t, name: "spin: a *.generated.kama without the header is refused, by name", r: foreign, want: 1,
          says: "notes.generated.kama");
    check(t: t, name: "spin: ...and kept, and nothing is written", ok: has(path: mine) && !has(path: actions),
          why: "the file was deleted, or actions.kama written");
    erase(path: mine);
    write(path: gen + "/mine.kama", text: "// mine\n");
    Ran foreignGen = s.kyoten(command: "generate", game: "spin", more: none());
    ranAs(t: t, name: "spin: a file in src/generated without the header is refused, by name", r: foreignGen,
          want: 1, says: "mine.kama");
    check(t: t, name: "spin: ...and kept", ok: has(path: gen + "/mine.kama"), why: "deleted");
    erase(path: gen + "/mine.kama");

    // The compiler is the one --kama names, else $KAMA, else kama on PATH (step 5.3, question 4).
    DynamicArray<string> missing = DynamicArray.empty();
    missing.add(item: "check");
    missing.add(item: s.fixture(at: "spin/kama.json"));
    missing.add(item: "--kama");
    missing.add(item: s.fixture(at: "no-such-kama"));
    Ran noKama = s.kyotenWith(argv: missing);
    check(t: t, name: "spin: `--kama` names the compiler, and a missing one is said so",
          ok: noKama.code() != 0 && noKama.says(what: "no-such-kama"), why: noKama.said());

    // `kyoten clean` removes every generated file and nothing else, as `git clean -fX` would.
    Ran regenerated = s.kyoten(command: "generate", game: "spin", more: none());
    write(path: moduleFile, text: header + "\n");
    Ran cleaned = s.kyoten(command: "clean", game: "spin", more: none());
    check(t: t, name: "spin: `kyoten clean` removes every generated file",
          ok: regenerated.code() == 0 && cleaned.code() == 0 && !has(path: actions) && !has(path: prefabs)
              && !has(path: moduleFile),
          why: cleaned.said());
    check(t: t, name: "spin: ...and nothing else",
          ok: has(path: s.fixture(at: "spin/src/app.kama")) && has(path: s.fixture(at: "spin/src/cube/cube.kama"))
              && has(path: s.fixture(at: "spin/src/cube/cube.records.json"))
              && has(path: s.fixture(at: "spin/content/cube.records.json")) && has(path: s.fixture(at: "spin/kama.json")),
          why: "a source or a record was deleted");
    write(path: mine, text: "// mine\n");
    Ran cleanMine = s.kyoten(command: "clean", game: "spin", more: none());
    ranAs(t: t, name: "spin: `kyoten clean` refuses a generated name without the header", r: cleanMine, want: 1,
          says: "notes.generated.kama");
    check(t: t, name: "spin: ...and keeps it", ok: has(path: mine), why: "deleted");
    erase(path: mine);
}
