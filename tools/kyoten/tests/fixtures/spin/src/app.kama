// The fixture's own main. It reads every name the first pass generates, so a missing or misshapen one fails the build;
// then it builds the generated world, creates two cubes by hand, one driven by player 1, steps it 60 times through the
// frame's driver with player 1's `faster` pressed on step 1 and held from then on, and runs Output twice, whose `show` prints each cube. Beside that it prints what `turn` gives when the
// same turns are made by hand, for the tool's tests to compare bit for bit. Then it loads the content (step 5.5), and
// last it calls the generated `run`, as a game's `main` does (step 7), which the tests run under
// `--headless --fixed-fps 60 --quit-after 30`.

import { core::println, kyoten::world::Transform, kyoten::world::Handle, kyoten::frame::Time, kyoten::frame::Rate,
         kyoten::frame::step, kyoten::frame::Handoff, kyoten::frame::Digital, kyoten::content::RecordSource, kyoten::content::LayerStack, kyoten::content::Content,
         kyoten::content::LoadRefusals, kyoten::content::readContent, std::collections::DynamicArray,
         std::collections::SortedMap, std::io::IoError, std::io::IoErrorKind, std::memory::Owned, glow::Glow, glow::Spark,
         spin::cube::Spin, spin::cube::Size, spin::cube::Taps, spin::cube::Aim, spin::cube::SlowAim, spin::cube::Steering,
         std::math::Vec2, kyoten::frame::Scheme, kyoten::frame::TextEntry, kyoten::frame::Text, kyoten::frame::Requests,
         kyoten::frame::DrawnView, spin::generated::Views,
         spin::generated::Actions, spin::generated::CubePrefab,
         spin::generated::CubePrefabId, spin::generated::BigCubePrefab, spin::generated::BigCubePrefabId,
         spin::generated::Prefabs, kyoten::platform::OpenPlatform, GameWorld, openContent, loadPrefabs,
         placeFirstScene, run };

// A mod's content, held in memory: a source the loader is handed like the game's folder (dependencies are injected).
type resource MemorySource implements RecordSource {
    string label = "";
    SortedMap<string, string> texts = SortedMap.empty();

    public ctor make(string label) { this.label = give label; }
    public fn void put(const ref string path, const ref string text) { this.texts.put(key: copy path, value: copy text); }

    public const fn string name() { return copy this.label; }
    public const fn DynamicArray<string> files() {
        DynamicArray<string> paths = DynamicArray.empty();
        foreach (string p in this.texts) { paths.add(item: give p); }
        return paths;
    }
    public const fn Result<string, IoError> text(const ref string path) {
        if (!this.texts.contains(key: path)) { return Result::Err(error: IoError.make(kind: IoErrorKind::NotFound)); }
        return Result::Ok(value: copy this.texts.getRef(key: path));
    }
}

fn void refused(const ref LoadRefusals no) {
    foreach (const ref string l in no.lines().iterConst()) { println(s: "refused at load: ${l}"); }
}

// The loader (step 5.5): the game's content folder through the stack, each family's prefabs laid in layer order, and
// the first scene's placements made rows in a world of their own, whose Output shows them.
fn void load() {
    OpenPlatform platform = OpenPlatform.make();
    Result<LayerStack, LoadRefusals> opened = openContent(platform: platform);
    LayerStack stack = LayerStack.make();
    match (give opened) { case Ok(value: s): { stack = give s; } case Err(error: no): { refused(no: no); return; } };
    LoadRefusals no = LoadRefusals.make();
    Content content = readContent(stack: stack, no: no);
    if (no.any()) { refused(no: no); return; }
    Result<Prefabs, LoadRefusals> loaded = loadPrefabs(content: content);
    match (give loaded) {
        case Ok(value: prefabs): {
            CubePrefab cube = prefabs.cube(id: CubePrefabId.cube());
            CubePrefab fast = prefabs.cube(id: CubePrefabId.fastCube());
            BigCubePrefab big = prefabs.bigCube(id: BigCubePrefabId.bigCube());
            println(s: "loaded: cube rate ${cube.spin.rate} player ${cube.actions.player}, fastCube rate ${fast.spin.rate}, bigCube rate ${big.spin.rate} size ${big.size.by}");
            GameWorld world = GameWorld.make();
            Result<isize, LoadRefusals> placed = placeFirstScene(world: world, prefabs: prefabs, content: content);
            match (give placed) {
                case Ok(value: n): { println(s: "spin: placed world, ${n} placed"); }
                case Err(error: e): { refused(no: e); }
            };
            int32 baseHz = GameWorld::baseHz;
            Rate clock = Rate.of(hz: baseHz, over: baseHz);
            Handoff quiet = Handoff.make(players: GameWorld::players, actions: GameWorld::actions());
            world.output(time: clock.at(step: 0), newest: quiet);
        }
        case Err(error: e): { refused(no: e); }
    };
}

// A mod laid as the only layer, whose prefabs the loader refuses: a misspelt field and a misspelt component, one
// with no default missing a field, and a prefab no build knows.
fn void loadMod() {
    MemorySource mod = MemorySource.make(label: "mod");
    mod.put(path: "cube.records.json", text: "{ \"prefabs\": { \"cube\": { \"Transform\": {}, \"Spin\": { \"rat\": 3 }, \"Actions\": {} }, \"fastCube\": { \"from\": \"cube\" }, \"bigCube\": { \"from\": \"cube\", \"spin::cube::Size\": {}, \"Glow\": {}, \"Glw\": {} }, \"extra\": { \"Spin\": {} } } }");
    LayerStack stack = LayerStack.make();
    Owned<RecordSource> boxed = give mod;
    stack.push(source: give boxed);
    LoadRefusals no = LoadRefusals.make();
    Content content = readContent(stack: stack, no: no);
    refused(no: no);
    Result<Prefabs, LoadRefusals> loaded = loadPrefabs(content: content);
    match (give loaded) { case Ok(value: p): { println(s: "the mod loaded"); } case Err(error: e): { refused(no: e); } };
}

// A processor starts a new entity from a prefab's values this way (REFERENCE.md § What a processor takes).
fn CubePrefab startFrom(const ref Prefabs prefabs, CubePrefabId id) { return prefabs.cube(id: id); }
fn BigCubePrefab startBig(const ref Prefabs prefabs, BigCubePrefabId id) { return prefabs.bigCube(id: id); }

// `turn`, by hand: `steps` steps at `dt` from a rate of 2, with `faster` held from step `heldFrom` on.
fn void expect(uint32 slot, int64 heldFrom, float32 dt, int64 steps) {
    Transform t = Transform.default();
    float32 rate = 2;
    int64 i = 0;
    while (i < steps) {
        if (i >= heldFrom) { rate = rate + dt; }
        t.rotateY(by: rate * dt);
        i = i + 1;
    }
    uint32 r = bitcast<uint32>(rate);
    uint32 x = bitcast<uint32>(t.rotation.x);
    uint32 y = bitcast<uint32>(t.rotation.y);
    uint32 z = bitcast<uint32>(t.rotation.z);
    uint32 w = bitcast<uint32>(t.rotation.w);
    int64 last = steps - 1;
    println(s: "expect: slot ${slot} rate ${r} rotation ${x} ${y} ${z} ${w} at ${last}");
}

// What `run` shows of a placed cube at `rate` after `steps` steps, its `faster` never held, by hand: `show`'s line.
fn void expectRun(uint32 slot, float32 rate, float32 dt, int64 steps) {
    Transform t = Transform.default();
    int64 i = 0;
    while (i < steps) {
        t.rotateY(by: rate * dt);
        i = i + 1;
    }
    uint32 r = bitcast<uint32>(rate);
    uint32 x = bitcast<uint32>(t.rotation.x);
    uint32 y = bitcast<uint32>(t.rotation.y);
    uint32 z = bitcast<uint32>(t.rotation.z);
    uint32 w = bitcast<uint32>(t.rotation.w);
    int64 last = steps - 1;
    println(s: "expect run: slot ${slot} rate ${r} rotation ${x} ${y} ${z} ${w} at ${last}");
}

fn uint8 main() {
    Actions a = Actions.forPlayer(player: 1);
    int32 player = a.player;
    bool held = a.faster.held;
    CubePrefab c = CubePrefab.of(actions: a, aim: Aim.default(), drawnView: DrawnView.default(), slowAim: SlowAim.default(),
                                 spin: Spin.default(), steering: Steering.default(), taps: Taps.default(),
                                 textEntry: TextEntry.default(), transform: Transform.default());
    float32 rate = c.spin.rate;
    BigCubePrefab b = BigCubePrefab.of(actions: a, aim: Aim.default(), drawnView: DrawnView.default(), glow: Glow.default(),
                                       size: Size.default(),
                                       slowAim: SlowAim.default(), spark: Spark.default(), spin: Spin.default(),
                                       steering: Steering.default(),
                                       taps: Taps.default(), textEntry: TextEntry.default(), transform: Transform.default());
    float32 by = b.size.by;
    float32 strength = b.glow.strength;
    bool differ = CubePrefabId.fastCube() != CubePrefabId.default();
    bool same = BigCubePrefabId.bigCube() == BigCubePrefabId.default();
    println(s: "spin: player ${player}, faster held ${held}, cube spin ${rate}, big cube size ${by} glow ${strength}, ids ${differ} ${same}");
    // The game's views, numbered in the order of their names (the sixth part of step 8).
    int32 hud = Views::hud;
    int32 worldView = Views::world;
    int32 views = GameWorld::viewCount;
    println(s: "spin: views: hud ${hud}, world ${worldView}, ${views} in all");

    // The first cube names no player (0), so no input reaches it; the second names player 1, whose `faster` is
    // pressed on step 1, an odd step, and held from then on (the first slice's step 8). The 30 Hz `tally` runs on the
    // even steps, so it sees the press once, on step 2; Output, run twice at the end, sees it on its first run alone.
    GameWorld world = GameWorld.make();
    Spin two = Spin.default();
    two.rate = 2;
    Actions calm = Actions.forPlayer(player: 0);
    Actions pressed = Actions.forPlayer(player: 1);
    // Player 1's text entry, Output's own state, which `typing` turns on while `faster` is held (the fifth part of step 8).
    TextEntry typist = TextEntry.default();
    typist.player = 1;
    // Player 1's view of the world, Output's own state, which `framed` draws (the sixth part of step 8); the calm cube's
    // names the game's `hud` and no player, which the world gathers no request for.
    DrawnView seen = DrawnView.default();
    seen.player = 1;
    seen.view = worldView;
    DrawnView unseen = DrawnView.default();
    unseen.view = hud;
    Optional<Handle> one = world.create_cube(prefab: CubePrefab.of(actions: calm, aim: Aim.default(), drawnView: unseen,
                                                                   slowAim: SlowAim.default(), spin: two,
                                                                   steering: Steering.default(), taps: Taps.default(),
                                                                   textEntry: TextEntry.default(), transform: Transform.default()));
    Optional<Handle> other = world.create_cube(prefab: CubePrefab.of(actions: pressed, aim: Aim.default(), drawnView: seen,
                                                                     slowAim: SlowAim.default(), spin: two,
                                                                     steering: Steering.default(), taps: Taps.default(),
                                                                     textEntry: typist, transform: Transform.default()));
    int32 baseHz = GameWorld::baseHz;
    Rate clock = Rate.of(hz: baseHz, over: baseHz);
    Handoff input = Handoff.make(players: GameWorld::players, actions: GameWorld::actions());
    // Player 1 types into `chat` "ab" on step 2, then "hi" on step 57 and "!" on step 58 (the fifth part of step 8): the
    // 30 Hz `tally` sees all five, each once; Output, run twice at the end, sees "hi!" on its first run alone, since the
    // world keeps 6 steps (the 10 Hz `aimTally`'s window).
    Text ab = Text.empty();
    _ = ab.add(point: 'a');
    _ = ab.add(point: 'b');
    Text hi = Text.empty();
    _ = hi.add(point: 'h');
    _ = hi.add(point: 'i');
    Text bang = Text.empty();
    _ = bang.add(point: '!');
    int64 i = 0;
    while (i < 60) {
        Digital down = Digital.off();
        down.held = i >= 1;
        down.pressed = i == 1;
        // A gesture's progress, a state as of each step: 0.015625 a step, so Output on step 59 sees 59 of them.
        down.progress = cast<float32>(i) / 64.0;
        input.setDigital(player: 1, action: 0, value: down);
        // `steer`, an analog state, 0.25 from step 10; `look`, a delta, (1, 0.5) each step (the second part of step 8).
        input.setAnalog(player: 1, action: 0, value: i >= 10 ? 0.25 : 0.0);
        input.setVector2(player: 1, action: 0, value: Vec2.of(x: 1.0, y: 0.5));
        // Player 1 on the keyboard and the mouse for steps 0 to 19, then on a pad: unequal, so a gate on the wrong
        // scheme shows.
        input.setScheme(player: 1, value: i >= 20 ? Scheme::Gamepad : Scheme::KeyboardMouse);
        input.setText(player: 1, action: 0, value: i == 2 ? ab : (i == 57 ? hi : (i == 58 ? bang : Text.empty())));
        Time at = clock.at(step: i);
        step(world: world, time: at, handoff: input);
        i = i + 1;
    }
    // Output is handed the newest hand-off, whatever the steps took (frame-phases § Decided): `look` at (7, 8), then at
    // rest, so what Output prints of a value is the newest's.
    Handoff newest = Handoff.make(players: GameWorld::players, actions: GameWorld::actions());
    newest.setVector2(player: 1, action: 0, value: Vec2.of(x: 7.0, y: 8.0));
    world.output(time: clock.at(step: 59), newest: newest);
    // What the world asks of its devices after Output: player 1 typing, since `typing` turned their entry on.
    Requests asked = Requests.make();
    world.requests(into: asked);
    bool typing = asked.typing(player: 1);
    int32 named = asked.players();
    println(s: "spin: requests: ${named} player, player 1 typing ${typing}");
    isize drawn = asked.viewCount();
    Optional<DrawnView> theirs = asked.viewOf(player: 1, view: worldView);
    string world1 = "none";
    match (theirs) {
        case Some(value: d): {
            int32 wide = cast<int32>(d.size.x);
            int32 high = cast<int32>(d.size.y);
            float32 behind = d.position.z;
            world1 = "${wide} x ${high}, its camera at z ${behind}";
        }
        case None: { }
    };
    println(s: "spin: requests: ${drawn} view, player 1's world ${world1}");
    println(s: "spin: Output again, on the same step");
    newest.clear();
    world.output(time: clock.at(step: 59), newest: newest);
    float32 dt = Time::dtAt(hz: 60);
    expect(slot: 0, heldFrom: 60, dt: dt, steps: 60);
    expect(slot: 1, heldFrom: 1, dt: dt, steps: 60);
    println(s: "spin: base ${baseHz} Hz");
    load();
    loadMod();
    expectRun(slot: 0, rate: 2, dt: dt, steps: 29);
    expectRun(slot: 1, rate: 5, dt: dt, steps: 29);
    expectRun(slot: 2, rate: 4, dt: dt, steps: 29);
    println(s: "spin: the run");
    return run();
}
