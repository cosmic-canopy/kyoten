import { kyoten::world::Transform, kyoten::frame::Time, spin::generated::Actions };
export { Spin, Size, Taps, Aim, SlowAim, turn, tally, aimTrack, aimTally };
@generate(Serializable, Deserializable)
type value Spin { @field public float32 rate = 1; public default ctor make() { } }
@generate(Serializable, Deserializable)
type value Size { @field public float32 by = 1; public default ctor make() { } }
// The presses `tally` saw: a spinning cube's, by requirement.
@generate(Serializable, Deserializable)
type value Taps { @field public int32 slow = 0; public default ctor make() { } }
fn void turn(ref Transform t, ref Spin s, const ref Actions input, const ref Time time) {
    if (input.faster.held) { s.rate = s.rate + time.dt; }
    t.rotateY(by: s.rate * time.dt);
}
// At 30 Hz, half the base rate: each press of `faster` is seen once, on the first run at or after its step.
fn void tally(ref Taps taps, const ref Actions input) {
    if (input.faster.pressed) { taps.slow = taps.slow + 1; }
}
// What a cube's player gave its `look`, a delta, and its `steer`, an analog state (the first slice's step 8, its second
// part): `aimTrack` adds each step's look at the base rate, and `aimTally` at 10 Hz every step's since its last run, so
// neither loses motion nor counts any twice; `steer` as of each step.
@generate(Serializable, Deserializable)
type value Aim {
    @field public float32 yaw = 0;
    @field public float32 pitch = 0;
    @field public float32 steer = 0;
    public default ctor make() { }
}
@generate(Serializable, Deserializable)
type value SlowAim { @field public float32 yaw = 0; public default ctor make() { } }
fn void aimTrack(ref Aim aim, const ref Actions input) {
    aim.yaw = aim.yaw + input.look.x;
    aim.pitch = aim.pitch + input.look.y;
    aim.steer = input.steer;
}
fn void aimTally(ref SlowAim aim, const ref Actions input) { aim.yaw = aim.yaw + input.look.x; }
