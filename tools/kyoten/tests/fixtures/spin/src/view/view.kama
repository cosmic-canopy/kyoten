// What Output will do with the hello cube once render exists (step 9), as text: each cube's rate and rotation, bit for
// bit, so the tool's tests can compare them with the same turns made by hand; and, the first slice's step 8, what
// Output sees of each cube's `faster` (every step since its last frame) and how many presses the 30 Hz `tally` saw.

import { core::println, kyoten::world::Transform, kyoten::world::Handle, kyoten::frame::Time, kyoten::frame::TextEntry,
         kyoten::frame::DrawnView, std::math::Vec2, std::math::Vec3,
         spin::cube::Spin,
         spin::cube::Taps, spin::cube::Aim, spin::cube::SlowAim, spin::cube::Steering, spin::generated::Actions };

export { show, seen, aimed, schemed, typing, framed };

fn void show(const ref Transform t, const ref Spin s, Handle me, const ref Time time) {
    uint32 slot = me.slot();
    uint32 rate = bitcast<uint32>(s.rate);
    uint32 x = bitcast<uint32>(t.rotation.x);
    uint32 y = bitcast<uint32>(t.rotation.y);
    uint32 z = bitcast<uint32>(t.rotation.z);
    uint32 w = bitcast<uint32>(t.rotation.w);
    println(s: "shown: slot ${slot} rate ${rate} rotation ${x} ${y} ${z} ${w} at ${time.step}");
}

fn void seen(const ref Actions input, const ref Taps taps, Handle me) {
    uint32 slot = me.slot();
    bool pressed = input.faster.pressed;
    bool held = input.faster.held;
    float32 progress = input.faster.progress;
    int32 slow = taps.slow;
    int32 typed = taps.typed;
    int32 last = taps.last;
    string said = "";
    input.chat.appendTo(text: said);
    string noted = "";
    input.note.appendTo(text: noted);
    println(s: "seen: slot ${slot} pressed ${pressed} held ${held} progress ${progress} slow ${slow} typed ${typed} last ${last} chat [${said}] note [${noted}]");
}

// What `aimTrack` and `aimTally` made of each cube's look and steer, and what Output itself sees of `look`: every step's
// since its last frame.
fn void aimed(const ref Aim aim, const ref SlowAim slow, const ref Actions input, Handle me) {
    uint32 slot = me.slot();
    float32 yaw = aim.yaw;
    float32 pitch = aim.pitch;
    float32 slowYaw = slow.yaw;
    float32 steer = aim.steer;
    float32 lookX = input.look.x;
    float32 lookY = input.look.y;
    println(s: "aimed: slot ${slot} yaw ${yaw} pitch ${pitch} slow ${slowYaw} steer ${steer} look ${lookX} ${lookY}");
}

// The steps each scheme's Input processor ran for each cube.
fn void schemed(const ref Steering s, Handle me) {
    uint32 slot = me.slot();
    int32 keys = s.keys;
    int32 pad = s.pad;
    println(s: "schemed: slot ${slot} keys ${keys} pad ${pad}");
}

// Output's own state (design/input.md § Decided, 2026-11-25, the fifth part's question 3): the engine's `TextEntry`,
// which Output writes and keeps from one frame to the next, here on while `faster` is held. It prints what the frame
// before left and what this one writes.
fn void typing(ref TextEntry e, const ref Actions input, Handle me) {
    uint32 slot = me.slot();
    int32 player = e.player;
    bool was = e.on;
    e.on = input.faster.held;
    bool now = e.on;
    println(s: "typed: slot ${slot} player ${player} was ${was} on ${now}");
}

// Output's own state (design/input.md § Decided, 2026-11-26, the sixth part's question 1): the engine's `DrawnView`, as
// render will write one for each camera. A cube whose view names a player and one of the game's views draws it 1440 x
// 810 over the whole window, its camera 5 m behind the cube and turned as it is; one naming no player, or no view yet,
// draws nothing.
fn void framed(ref DrawnView v, const ref Transform t, Handle me) {
    if (v.player < 1 || v.view < 0) { return; }
    v.size = Vec2.of(x: 1440.0, y: 810.0);
    v.position = Vec3.of(x: 0.0, y: 0.0, z: 5.0);
    v.rotation = t.rotation;
    uint32 slot = me.slot();
    int32 player = v.player;
    int32 which = v.view;
    println(s: "framed: slot ${slot} player ${player} view ${which}");
}
