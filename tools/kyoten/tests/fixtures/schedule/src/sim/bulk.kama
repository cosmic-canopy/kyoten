// A large component, so `crate`'s chunk is at the 16 KiB target: a row of 120 bytes (28 floats and the list's length)
// and its 8-byte handle gives 128 rows of 128 bytes. The world builds such a chunk in its table's block; the 32 KiB
// frame guard holds it off the stack on wasm.

import { std::collections::InlineDynamicArray };

export { Bulk };

@generate(Serializable, Deserializable)
type value Bulk { @field public InlineDynamicArray<float32>#(28) xs = InlineDynamicArray.empty(); public default ctor make() { } }
