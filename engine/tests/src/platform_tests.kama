// kyoten::platform (the first slice's step 7, KYR-8; target-platforms § Decided, 2026-11-20): the run's three options,
// read from a command line, and the loop, driven by hand on every leg as std::app would drive it, with a world and a
// platform of the test's own (dependencies are injected): the phases a tick from the platform's timestamps, the window
// asked for once on `SurfaceReady`, `Resumed` after `Suspended` owing no burst, and each way the run ends. And the
// input (the first slice's step 8): the loop handing its source each tick's samples, at a fixed tick's own timestamp
// under `--fixed-fps`, and the open platforms' pump turning a headless window's events into samples at their times.

import { Tally, std::app::Lifecycle, std::collections::DynamicArray, std::memory::Shared, std::time::Instant,
         std::time::Duration, std::time::monotonicNow, kyoten::frame::World, kyoten::frame::Time, kyoten::frame::Handoff, kyoten::frame::ActionList,
         kyoten::frame::InputSource, kyoten::frame::Sample, kyoten::frame::SampleKind, kyoten::frame::Device,
         kyoten::platform::Platform, kyoten::platform::RunOptions, kyoten::platform::RunOptionError,
         kyoten::platform::Ending, kyoten::platform::Play, kyoten::platform::play, kyoten::platform::fixedTimestamp,
         kyoten::platform::OpenPlatform, kyoten::platform::pumpInto, kyoten::platform::PadReadings, window::Window,
         window::Event, window::Key, window::Pointer, window::PointerKind, window::PointerButton, window::PadButton,
         window::PadAxis, window::Gamepad, kyoten::frame::Requests, kyoten::frame::DrawnView, std::math::Vec3, window::Size,
         kyoten::frame::CursorMode, kyoten::platform::CursorAsk, kyoten::platform::askCursor, kyoten::platform::windowMode,
         window::CursorMode as WindowCursor, modeWord };

export { platformTests };

comptime int64 STEP = 16666667;     // a 60 Hz step's nanoseconds, rounded up
comptime int64 T0 = 5000000000;     // an arbitrary first timestamp

// What the test's platform and world were asked, and what the platform answers: shared with the test, since the loop
// owns both.
type resource Log {
    DynamicArray<string> argList = DynamicArray.empty();
    DynamicArray<int64> timeList = DynamicArray.empty();
    bool openAnswer = true;
    int32 closeAt = 0;              // `pumped()` is false from this pump on; 0 never
    int32 openCount = 0;
    string openedAs = "";
    int32 pumpCount = 0;
    int32 nowCount = 0;
    int32 endCount = 0;
    int32 endCode = -1;
    int64 outputCount = 0;
    DynamicArray<Sample> toPump = DynamicArray.empty();   // handed in at the next pump
    string takenAt = "";                                  // each sample the source took, at its time
    bool asking = false;                                  // whether the world asks that player 1 types
    string entries = "";                                  // each text entry handed on: `S1+@t` the source's, `P1+` the platform's
    bool drawing = false;                                 // whether the world draws player 1's view 0, at `drawnX`
    float32 drawnX = 0.0;
    bool drawingSecond = false;                           // and their view 1
    CursorMode cursorOne = CursorMode::Normal;            // the cursor mode the world asks for player 1, and for player 2
    CursorMode cursorTwo = CursorMode::Normal;

    public ctor make() { }

    public fn void takeArgs(DynamicArray<string> args) { this.argList = give args; }
    public fn void takeTimes(DynamicArray<int64> times) { this.timeList = give times; }
    public fn void refuseWindow() { this.openAnswer = false; }
    public fn void closeOnPump(int32 at) { this.closeAt = at; }

    public const fn DynamicArray<string> args() { return copy this.argList; }
    public fn bool open(const ref string title, int32 width, int32 height, bool headless, bool focused) {
        this.openCount = this.openCount + 1;
        string h = headless ? "headless" : "windowed";
        string f = focused ? "focused" : "unfocused";
        this.openedAs = "${title} ${width}x${height} ${h} ${f}";
        return this.openAnswer;
    }
    public fn void pumpNext(Sample s) { this.toPump.add(item: s); }
    public fn bool pump(ref DynamicArray<Sample> into) {
        this.pumpCount = this.pumpCount + 1;
        foreach (Sample s in this.toPump) { into.add(item: s); }
        this.toPump.clear();
        return this.closeAt == 0 || this.pumpCount < this.closeAt;
    }
    public fn void took(const ref DynamicArray<Sample> samples) {
        foreach (Sample s in samples) {
            int64 at = s.at;
            string was = copy this.takenAt;
            this.takenAt = "${was}${at} ";
        }
    }
    public const fn string taken() { return copy this.takenAt; }
    // Each answer in turn, then the last again; 0 with none.
    public fn int64 time() {
        isize n = this.timeList.length();
        isize at = cast<isize>(this.nowCount);
        this.nowCount = this.nowCount + 1;
        if (n == 0) { return 0; }
        if (at >= n) { return this.timeList[n - 1]; }
        return this.timeList[at];
    }
    public fn void end(uint8 code) {
        this.endCount = this.endCount + 1;
        this.endCode = cast<int32>(code);
    }
    public fn void output() { this.outputCount = this.outputCount + 1; }
    public fn void askTyping(bool on) { this.asking = on; }
    public const fn bool asksTyping() { return this.asking; }
    public fn void drawView(float32 x, bool second) {
        this.drawing = true;
        this.drawnX = x;
        this.drawingSecond = second;
    }
    public const fn bool draws() { return this.drawing; }
    public const fn float32 drawnAt() { return this.drawnX; }
    public const fn bool drawsSecond() { return this.drawingSecond; }
    public fn void askCursor(int32 player, CursorMode mode) {
        if (player == 1) { this.cursorOne = mode; } else { this.cursorTwo = mode; }
    }
    public const fn CursorMode cursorOf(int32 player) { return player == 1 ? this.cursorOne : this.cursorTwo; }
    public fn void entry(const ref string what) {
        string was = copy this.entries;
        this.entries = was + what + " ";
    }
    public const fn string entriesSeen() { return copy this.entries; }

    public const fn int64 openings() { return cast<int64>(this.openCount); }
    public const fn string opened() { return copy this.openedAs; }
    public const fn int64 pumps() { return cast<int64>(this.pumpCount); }
    public const fn int64 nows() { return cast<int64>(this.nowCount); }
    public const fn int64 endings() { return cast<int64>(this.endCount); }
    public const fn int64 endedWith() { return cast<int64>(this.endCode); }
    public const fn int64 outputs() { return this.outputCount; }
}

type resource FakePlatform implements Platform {
    Shared<Log> log;

    public ctor make(Shared<Log> log) { this.log = give log; }

    public const fn string contentFolder(const ref string package, const ref string native) { return copy native; }
    public const fn DynamicArray<string> arguments() { return this.log.deref().args(); }
    public fn bool openWindow(const ref string title, int32 width, int32 height, bool headless, bool focused) {
        return this.log.derefMut().open(title: title, width: width, height: height, headless: headless, focused: focused);
    }
    public fn bool pumped(ref DynamicArray<Sample> into) { return this.log.derefMut().pump(into: into); }
    public fn int64 now() { return this.log.derefMut().time(); }
    public fn void textEntry(int32 player, bool on) {
        string s = on ? "+" : "-";
        this.log.derefMut().entry(what: "P${player}${s}");
    }
    public fn void cursor(int32 player, CursorMode mode) {
        string m = modeWord(m: mode);
        this.log.derefMut().entry(what: "C${player}${m}");
    }
    public fn void ended(uint8 code) { this.log.derefMut().end(code: code); }
}

// Counts its Output runs into the log; the steps are the loop's clock's to count.
type resource Counter implements World {
    Shared<Log> log;

    public ctor make(Shared<Log> log) { this.log = give log; }

    public fn void input(const ref Time time, const ref Handoff handoff) { }
    public fn void update(const ref Time time) { }
    public fn void constraints(const ref Time time) { }
    public fn void output(const ref Time time, const ref Handoff newest) { this.log.derefMut().output(); }
    // Player 1 typing while the log says the world asks it, and each of two players' cursor as the log asks it.
    public fn void requests(ref Requests into) {
        into.reset(players: 2);
        if (this.log.deref().asksTyping()) { into.setTyping(player: 1, on: true); }
        into.askCursor(player: 1, mode: this.log.deref().cursorOf(player: 1));
        into.askCursor(player: 2, mode: this.log.deref().cursorOf(player: 2));
        if (this.log.deref().draws()) {
            DrawnView v = DrawnView.default();
            v.player = 1;
            v.view = 0;
            v.position = Vec3.of(x: this.log.deref().drawnAt(), y: 0.0, z: 0.0);
            into.setView(view: v);
        }
        if (this.log.deref().drawsSecond()) {
            DrawnView v = DrawnView.default();
            v.player = 1;
            v.view = 1;
            into.setView(view: v);
        }
    }
}

// Records the samples the loop hands it into the log; its hand-offs are empty.
type resource Taker implements InputSource {
    Shared<Log> log;
    Handoff out = Handoff.make(players: 1, actions: ActionList.make());

    public ctor make(Shared<Log> log) { this.log = give log; }

    public fn void take(const ref DynamicArray<Sample> samples) { this.log.derefMut().took(samples: samples); }
    public fn const ref Handoff handoff(int64 index, int64 until) { return this.out; }
    public fn const ref Handoff newest(float32 seconds) { return this.out; }
    public fn void textEntry(int32 player, bool on, int64 at) {
        string s = on ? "+" : "-";
        this.log.derefMut().entry(what: "S${player}${s}@${at}");
    }
    public fn void drawn(const ref DrawnView view, int64 at) {
        int32 p = view.player;
        int32 which = view.view;
        int32 x = cast<int32>(view.position.x);
        this.log.derefMut().entry(what: "V${p}.${which}x${x}@${at}");
    }
}

fn void expectCount(ref Tally t, const ref string name, int64 got, int64 want) {
    if (got == want) { t.verdict(name: name, why: ""); }
    else { t.verdict(name: name, why: "got ${got}, want ${want}"); }
}

// A command line from its words, split at each space.
fn DynamicArray<string> argsOf(const ref string line) {
    DynamicArray<string> made = DynamicArray.empty();
    isize start = 0;
    isize n = line.length();
    while (start < n) {
        isize end = match (line.findFrom(substring: " ", start: start)) { case Some(value: v): v; case None: n; };
        if (end > start) { made.add(item: line.substring(start: start, end: end)); }
        start = end + 1;
    }
    return made;
}

// The options read from `line`, or the refusal's words prefixed "refused: ".
fn string readFrom(const ref string line) {
    DynamicArray<string> args = argsOf(line: line);
    Result<RunOptions, RunOptionError> r = RunOptions.fromArguments(args: args);
    match (give r) {
        case Ok(value: o): {
            string h = o.headless ? "headless" : "windowed";
            int64 q = o.quitAfter;
            int32 f = o.fixedFps;
            return "${h} quit-after ${q} fixed-fps ${f}";
        }
        case Err(error: e): { string w = e.message(); return "refused: " + w; }
    };
}

fn void expectRead(ref Tally t, const ref string name, const ref string line, const ref string want) {
    string got = readFrom(line: line);
    if (got == want) { t.verdict(name: name, why: ""); }
    else { t.verdict(name: name, why: "`${line}` read as `${got}`, want `${want}`"); }
}

fn void expectRefused(ref Tally t, const ref string name, const ref string line, const ref string words) {
    string got = readFrom(line: line);
    bool ok = got.startsWith(prefix: "refused: ") && got.contains(substring: words);
    t.verdict(name: name, why: ok ? "" : "`${line}` read as `${got}`, want a refusal naming `${words}`");
}

fn void optionCases(ref Tally t) {
    expectRead(t: t, name: "options: none given is a window, no limit and the host's clock", line: "",
               want: "windowed quit-after 0 fixed-fps 0");
    expectRead(t: t, name: "options: the three read, in any order", line: "--fixed-fps 60 --quit-after 30 --headless",
               want: "headless quit-after 30 fixed-fps 60");
    expectRead(t: t, name: "options: the game's own arguments are left to it", line: "--level 3 --headless map.json",
               want: "headless quit-after 0 fixed-fps 0");
    expectRead(t: t, name: "options: `--quit-after 0` is no limit, as Godot's", line: "--quit-after 0",
               want: "windowed quit-after 0 fixed-fps 0");
    expectRefused(t: t, name: "options: `--quit-after` with no number is refused", line: "--quit-after",
                  words: "`--quit-after` wants a number after it");
    expectRefused(t: t, name: "options: `--quit-after` with a word is refused", line: "--quit-after x",
                  words: "`--quit-after x`: the frames to run");
    expectRefused(t: t, name: "options: a negative `--quit-after` is refused", line: "--quit-after -1",
                  words: "`--quit-after -1`");
    expectRefused(t: t, name: "options: `--fixed-fps 0` is refused", line: "--fixed-fps 0", words: "`--fixed-fps 0`");
    expectRefused(t: t, name: "options: a `--fixed-fps` past a million is refused", line: "--fixed-fps 1000001",
                  words: "`--fixed-fps 1000001`");
    expectRead(t: t, name: "options: `--fixed-fps 1000000` is read", line: "--fixed-fps 1000000",
               want: "windowed quit-after 0 fixed-fps 1000000");
    expectRefused(t: t, name: "options: an option written with `=` is refused, naming the two-argument form",
                  line: "--quit-after=30", words: "two arguments");
}

fn void timestampCases(ref Tally t) {
    expectCount(t: t, name: "fixed timestamps: the first frame is at 0", got: fixedTimestamp(index: 0, fps: 60), want: 0);
    expectCount(t: t, name: "fixed timestamps: a frame at 60 fps is a 60th of a second, rounded up",
                got: fixedTimestamp(index: 1, fps: 60), want: STEP);
    expectCount(t: t, name: "fixed timestamps: 60 frames at 60 fps are exactly a second",
                got: fixedTimestamp(index: 60, fps: 60), want: 1000000000);
    expectCount(t: t, name: "fixed timestamps: a frame whose nanoseconds times the index would overflow does not",
                got: fixedTimestamp(index: 60000000000, fps: 60), want: 1000000000000000000);
}

// A loop on the test's world and platform, as `play` makes it, the options read from `line`.
fn Play<Counter, FakePlatform, Taker> loopOn(Shared<Log> log, const ref string line) {
    Result<RunOptions, RunOptionError> r = RunOptions.fromArguments(args: argsOf(line: line));
    RunOptions o = RunOptions.empty();
    match (give r) { case Ok(value: v): { o = v; } case Err(error: e): { } };
    Shared<Log> forWorld = copy log;
    Shared<Log> forInput = copy log;
    Shared<Log> forPlatform = give log;
    Shared<Ending> ending = new Ending.make();
    return Play.make(world: Counter.make(log: give forWorld),
                     platform: FakePlatform.make(log: give forPlatform), input: Taker.make(log: give forInput),
                     options: o, hz: 60, title: "probe", width: 640, height: 400, ending: give ending);
}

// The host's start, as every host says it before the first tick.
fn void hostStarts(ref Play<Counter, FakePlatform, Taker> p) {
    p.lifecycle(event: Lifecycle::Resumed);
    p.lifecycle(event: Lifecycle::SurfaceReady);
}

fn void windowCases(ref Tally t) {
    Shared<Log> log = new Log.make();
    Play<Counter, FakePlatform, Taker> p = loopOn(log: copy log, line: "");
    expectCount(t: t, name: "loop: no window is asked for before the host says surfaces may be made",
                got: log.deref().openings(), want: 0);
    hostStarts(p: p);
    p.lifecycle(event: Lifecycle::SurfaceReady);
    expectCount(t: t, name: "loop: the window is asked for once, on SurfaceReady", got: log.deref().openings(), want: 1);
    string opened = log.deref().opened();
    t.verdict(name: "loop: with no option, the app's window is a system window that takes the focus",
              why: opened == "probe 640x400 windowed focused" ? "" : "asked for `${opened}`");

    Shared<Log> quiet = new Log.make();
    Play<Counter, FakePlatform, Taker> q = loopOn(log: copy quiet, line: "--headless --quit-after 5");
    hostStarts(p: q);
    string asked = quiet.deref().opened();
    t.verdict(name: "loop: under `--headless --quit-after`, the window is headless and takes no focus",
              why: asked == "probe 640x400 headless unfocused" ? "" : "asked for `${asked}`");
    Shared<Log> unfocused = new Log.make();
    Play<Counter, FakePlatform, Taker> u = loopOn(log: copy unfocused, line: "--quit-after 5");
    hostStarts(p: u);
    string shown = unfocused.deref().opened();
    t.verdict(name: "loop: under `--quit-after` alone, a system window that takes no focus",
              why: shown == "probe 640x400 windowed unfocused" ? "" : "asked for `${shown}`");
}

fn void phaseCases(ref Tally t) {
    Shared<Log> log = new Log.make();
    DynamicArray<int64> times = DynamicArray.empty();
    times.add(item: T0);
    times.add(item: T0 + STEP);
    times.add(item: T0 + 3 * STEP);
    log.derefMut().takeTimes(times: give times);
    Play<Counter, FakePlatform, Taker> p = loopOn(log: copy log, line: "");
    hostStarts(p: p);
    bool going = p.tick() && p.tick() && p.tick();
    t.verdict(name: "loop: a tick goes on while the window is open", why: going ? "" : "a tick ended the run");
    expectCount(t: t, name: "loop: each tick is a frame on the platform's timestamp, 3 steps owed over 3 frames",
                got: p.stepsSettled(), want: 3);
    expectCount(t: t, name: "loop: each tick reads the platform's timestamp once", got: log.deref().nows(), want: 3);
    expectCount(t: t, name: "loop: and pumps its window once", got: log.deref().pumps(), want: 3);
    expectCount(t: t, name: "loop: and runs the world's Output once", got: log.deref().outputs(), want: 3);
}

fn void lifecycleCases(ref Tally t) {
    Shared<Log> log = new Log.make();
    DynamicArray<int64> times = DynamicArray.empty();
    times.add(item: T0);
    times.add(item: T0 + STEP);
    times.add(item: T0 + 10000000000);
    times.add(item: T0 + 10000000000 + STEP);
    log.derefMut().takeTimes(times: give times);
    Play<Counter, FakePlatform, Taker> p = loopOn(log: copy log, line: "");
    hostStarts(p: p);
    p.tick();
    p.tick();
    p.lifecycle(event: Lifecycle::Suspended);
    p.lifecycle(event: Lifecycle::Resumed);
    p.tick();
    expectCount(t: t, name: "loop: Resumed after Suspended owes nothing for the time away", got: p.stepsSettled(), want: 1);
    p.tick();
    expectCount(t: t, name: "loop: and a step later one is owed again", got: p.stepsSettled(), want: 2);

    Shared<Log> plain = new Log.make();
    DynamicArray<int64> gap = DynamicArray.empty();
    gap.add(item: T0);
    gap.add(item: T0 + STEP);
    gap.add(item: T0 + 10000000000);
    plain.derefMut().takeTimes(times: give gap);
    Play<Counter, FakePlatform, Taker> r = loopOn(log: copy plain, line: "");
    hostStarts(p: r);
    r.tick();
    r.tick();
    r.lifecycle(event: Lifecycle::Resumed);
    r.tick();
    expectCount(t: t, name: "loop: a Resumed with no Suspended before it resets nothing, so the gap owes the cap",
                got: r.stepsSettled(), want: 6);
}

fn void endCases(ref Tally t) {
    Shared<Log> log = new Log.make();
    log.derefMut().closeOnPump(at: 3);
    Play<Counter, FakePlatform, Taker> p = loopOn(log: copy log, line: "");
    hostStarts(p: p);
    bool one = p.tick();
    bool two = p.tick();
    bool three = p.tick();
    bool closed = one && two && !three;
    t.verdict(name: "loop: the window closing ends the run", why: closed ? "" : "ticks ${one} ${two} ${three}");
    expectCount(t: t, name: "loop: with status 0, said to the platform", got: log.deref().endedWith(), want: 0);
    expectCount(t: t, name: "loop: and the frame it closed on runs nothing", got: log.deref().outputs(), want: 2);

    Shared<Log> refused = new Log.make();
    refused.derefMut().refuseWindow();
    Play<Counter, FakePlatform, Taker> r = loopOn(log: copy refused, line: "");
    hostStarts(p: r);
    bool ran = r.tick();
    t.verdict(name: "loop: a window that could not be opened ends the run at the first tick",
              why: ran ? "the tick went on" : "");
    expectCount(t: t, name: "loop: with status 1", got: refused.deref().endedWith(), want: 1);
    expectCount(t: t, name: "loop: and runs no frame", got: refused.deref().outputs(), want: 0);

    Shared<Log> counted = new Log.make();
    Play<Counter, FakePlatform, Taker> c = loopOn(log: copy counted, line: "--quit-after 3");
    hostStarts(p: c);
    bool a = c.tick();
    bool b = c.tick();
    bool last = c.tick();
    bool quitting = a && b && !last;
    t.verdict(name: "loop: `--quit-after 3` ends the run on its third frame", why: quitting ? "" : "ticks ${a} ${b} ${last}");
    expectCount(t: t, name: "loop: with status 0", got: counted.deref().endedWith(), want: 0);
    expectCount(t: t, name: "loop: after running all three", got: counted.deref().outputs(), want: 3);
    expectCount(t: t, name: "loop: and says the end once", got: counted.deref().endings(), want: 1);
}

fn void fixedCases(ref Tally t) {
    Shared<Log> log = new Log.make();
    Play<Counter, FakePlatform, Taker> p = loopOn(log: copy log, line: "--headless --fixed-fps 60 --quit-after 30");
    hostStarts(p: p);
    while (p.tick()) { }
    expectCount(t: t, name: "loop: under `--fixed-fps 60 --quit-after 30`, 30 frames run", got: log.deref().outputs(), want: 30);
    expectCount(t: t, name: "loop: owing exactly 29 steps at 60 Hz, the first frame setting the baseline",
                got: p.stepsSettled(), want: 29);
    expectCount(t: t, name: "loop: and reading no host clock", got: log.deref().nows(), want: 0);

    Shared<Log> half = new Log.make();
    Play<Counter, FakePlatform, Taker> h = loopOn(log: copy half, line: "--fixed-fps 30 --quit-after 11");
    hostStarts(p: h);
    while (h.tick()) { }
    expectCount(t: t, name: "loop: under `--fixed-fps 30`, each frame owes two 60 Hz steps", got: h.stepsSettled(), want: 20);
}

// `play` itself, before its loop: a malformed option ends the run with 2, and asks for no window.
fn void playCases(ref Tally t) {
    Shared<Log> log = new Log.make();
    log.derefMut().takeArgs(args: argsOf(line: "--quit-after soon"));
    Shared<Log> forWorld = copy log;
    Shared<Log> forPlatform = copy log;
    Shared<Log> forInput = copy log;
    uint8 code = play(world: Counter.make(log: give forWorld), platform: FakePlatform.make(log: give forPlatform),
                      input: Taker.make(log: give forInput), hz: 60, title: "probe", width: 640, height: 400);
    expectCount(t: t, name: "play: a malformed option ends the run with 2", got: cast<int64>(code), want: 2);
    expectCount(t: t, name: "play: before its loop, so no window is asked for", got: log.deref().openings(), want: 0);
}

// Where a package's content folder is in this build: `/<package>/content` on the web, where its manifest's
// `preloadFiles` packs it, and the folder the generator found natively. The tests may name a target; the engine's code
// names one only in kyoten::platform.
@compileFor(ARCH_WASM32)
fn string expectedFolder() { return "/hello/content"; }
@compileFor(!ARCH_WASM32)
fn string expectedFolder() { return "C:/games/hello/content"; }

fn void openCases(ref Tally t) {
    OpenPlatform here = OpenPlatform.make();
    string at = here.contentFolder(package: "hello", native: "C:/games/hello/content");
    string want = expectedFolder();
    t.verdict(name: "OpenPlatform: a package's content folder in the build being made, the platform's per target",
              why: at == want ? "" : "`${at}`, wanted `${want}`");
}

// The loop hands its source the samples each tick's pump handed in, at the times they carry; under `--fixed-fps`, at
// the tick's own made-up timestamp, so they land in its last owed step.
fn void inputCases(ref Tally t) {
    Shared<Log> log = new Log.make();
    DynamicArray<int64> times = DynamicArray.empty();
    times.add(item: T0);
    times.add(item: T0 + STEP);
    log.derefMut().takeTimes(times: give times);
    Play<Counter, FakePlatform, Taker> p = loopOn(log: copy log, line: "");
    hostStarts(p: p);
    log.derefMut().pumpNext(s: Sample.make(device: Device::Keyboard, slot: 0, control: 82, value: 1.0, at: T0 - 5));
    p.tick();
    log.derefMut().pumpNext(s: Sample.make(device: Device::Keyboard, slot: 0, control: 82, value: 0.0, at: T0 + 7));
    log.derefMut().pumpNext(s: Sample.make(device: Device::Gamepad, slot: 1, control: 5, value: 1.0, at: T0 + 9));
    p.tick();
    string taken = log.deref().taken();
    t.verdict(name: "loop: each tick hands its source the samples its pump handed in, at their own times",
              why: taken == "4999999995 5000000007 5000000009 " ? "" : "took `${taken}`");

    Shared<Log> fixed = new Log.make();
    Play<Counter, FakePlatform, Taker> f = loopOn(log: copy fixed, line: "--fixed-fps 60 --quit-after 5");
    hostStarts(p: f);
    f.tick();
    fixed.derefMut().pumpNext(s: Sample.make(device: Device::Keyboard, slot: 0, control: 82, value: 1.0, at: 12345));
    f.tick();
    string stamped = fixed.deref().taken();
    t.verdict(name: "loop: under `--fixed-fps`, a tick's samples are taken at its own timestamp",
              why: stamped == "16666667 " ? "" : "took `${stamped}`");
}

// What the world asks of its devices after each frame (design/input.md § Decided, 2026-11-25, the fifth part's question
// 3): each change in a player's text entry handed to the source at the frame's timestamp and to the platform, and an
// unchanged one handed to neither.
fn void requestLoopCases(ref Tally t) {
    Shared<Log> log = new Log.make();
    DynamicArray<int64> times = DynamicArray.empty();
    times.add(item: T0);
    times.add(item: T0 + STEP);
    times.add(item: T0 + 2 * STEP);
    times.add(item: T0 + 3 * STEP);
    log.derefMut().takeTimes(times: give times);
    Play<Counter, FakePlatform, Taker> p = loopOn(log: copy log, line: "");
    hostStarts(p: p);
    p.tick();
    string quiet = log.deref().entriesSeen();
    t.verdict(name: "loop: a world that asks nothing hands no text entry on", why: quiet.isEmpty() ? "" : "handed `${quiet}`");
    log.derefMut().askTyping(on: true);
    p.tick();
    p.tick();
    log.derefMut().askTyping(on: false);
    p.tick();
    string seen = log.deref().entriesSeen();
    t.verdict(name: "loop: a text entry turned on and off is handed on once each, at its frame's timestamp",
              why: seen == "S1+@5016666667 P1+ S1-@5050000001 P1- " ? "" : "handed `${seen}`");
}

// The views the world drew after each frame (design/input.md § Decided, 2026-11-26, the sixth part's question 1): each
// one new or drawn otherwise is handed to the source at its frame's timestamp, and one drawn as before is not.
fn void viewLoopCases(ref Tally t) {
    Shared<Log> log = new Log.make();
    DynamicArray<int64> times = DynamicArray.empty();
    times.add(item: T0);
    times.add(item: T0 + STEP);
    times.add(item: T0 + 2 * STEP);
    times.add(item: T0 + 3 * STEP);
    times.add(item: T0 + 4 * STEP);
    log.derefMut().takeTimes(times: give times);
    Play<Counter, FakePlatform, Taker> p = loopOn(log: copy log, line: "");
    hostStarts(p: p);
    p.tick();
    string quiet = log.deref().entriesSeen();
    t.verdict(name: "loop: a world that draws no view hands none on", why: quiet.isEmpty() ? "" : "handed `${quiet}`");
    log.derefMut().drawView(x: 1.0, second: false);
    p.tick();
    p.tick();
    log.derefMut().drawView(x: 2.0, second: true);
    p.tick();
    p.tick();
    string seen = log.deref().entriesSeen();
    t.verdict(name: "loop: a view is handed on when first drawn and when drawn otherwise, at its frame's timestamp, never as before",
              why: seen == "V1.0x1@5016666667 V1.0x2@5050000001 V1.1x0@5050000001 " ? "" : "handed `${seen}`");
}

// Each player's cursor mode the world asks after each frame (design/input.md § Decided, 2026-11-26, the sixth part's
// question 2): each change handed to the platform, an unchanged one not, each player's apart.
fn void cursorLoopCases(ref Tally t) {
    Shared<Log> log = new Log.make();
    DynamicArray<int64> times = DynamicArray.empty();
    times.add(item: T0);
    times.add(item: T0 + STEP);
    times.add(item: T0 + 2 * STEP);
    times.add(item: T0 + 3 * STEP);
    times.add(item: T0 + 4 * STEP);
    log.derefMut().takeTimes(times: give times);
    Play<Counter, FakePlatform, Taker> p = loopOn(log: copy log, line: "");
    hostStarts(p: p);
    p.tick();
    string quiet = log.deref().entriesSeen();
    t.verdict(name: "loop: a world that asks every cursor Normal hands none on", why: quiet.isEmpty() ? "" : "handed `${quiet}`");
    log.derefMut().askCursor(player: 1, mode: CursorMode::Locked);
    p.tick();
    p.tick();
    log.derefMut().askCursor(player: 2, mode: CursorMode::Hidden);
    p.tick();
    log.derefMut().askCursor(player: 1, mode: CursorMode::Normal);
    p.tick();
    string seen = log.deref().entriesSeen();
    t.verdict(name: "loop: each player's cursor mode is handed to the platform as it changes, never as before",
              why: seen == "C1Locked C2Hidden C1Normal " ? "" : "handed `${seen}`");
}

// The lock samples among `samples`, each its 1 or 0, in order.
fn string locksOf(const ref DynamicArray<Sample> samples) {
    string got = "";
    foreach (const ref Sample s in samples.iterConst()) {
        if (s.kind != SampleKind::Lock) { continue; }
        string one = s.value >= 0.5 ? "1" : "0";
        got = got.isEmpty() ? copy one : got + " " + one;
    }
    return got;
}

// `w`'s events since the last pump, under `ask`'s rule, its lock samples spelled.
unsafe fn string pumpedLocks(ref Window w, Instant began, ref CursorAsk ask) {
    DynamicArray<Sample> samples = DynamicArray.empty();
    PadReadings pads = PadReadings.make();
    Size size = w.size();
    bool open = pumpInto(w: w, began: began, into: samples, pads: pads, size: size, cursor: ask);
    return locksOf(samples: samples);
}

// The cursor's mode on the window (the sixth part's question 2), on headless windows, each rule held on every leg: the
// game's mode set at once; a lock the window drops while the game still asks `Locked` asked for again, natively when the
// focus comes back and on the web at once; the game's own release, and a mode that is not `Locked`, never.
unsafe fn void cursorAskCases(ref Tally t) {
    Instant began = monotonicNow();
    Window w = Window.headless(width: 64, height: 48);
    CursorAsk native = CursorAsk.make(againAtOnce: false);
    askCursor(w: w, cursor: native, mode: CursorMode::Locked);
    string locked = pumpedLocks(w: w, began: began, ask: native);
    string kept = modeWord(m: native.wanted);
    t.verdict(name: "OpenPlatform: the game's Locked locks the window, and is kept", why: locked == "1" && kept == "Locked" ? "" : "locks `${locked}`, kept ${kept}");
    w.post(event: Event::Focus(focused: false), at: msAfter(began: began, ms: 5));
    string lost = pumpedLocks(w: w, began: began, ask: native);
    t.verdict(name: "OpenPlatform: natively a focus loss drops the lock, which is not asked for again while unfocused",
              why: lost == "0" ? "" : "locks `${lost}`");
    w.post(event: Event::Focus(focused: true), at: msAfter(began: began, ms: 6));
    string back = pumpedLocks(w: w, began: began, ask: native);
    t.verdict(name: "OpenPlatform: natively the lock is asked for again when the focus comes back", why: back == "1" ? "" : "locks `${back}`");
    askCursor(w: w, cursor: native, mode: CursorMode::Hidden);
    string hidden = pumpedLocks(w: w, began: began, ask: native);
    w.post(event: Event::Focus(focused: false), at: msAfter(began: began, ms: 7));
    w.post(event: Event::Focus(focused: true), at: msAfter(began: began, ms: 8));
    string unasked = pumpedLocks(w: w, began: began, ask: native);
    t.verdict(name: "OpenPlatform: natively the game's own release, to Hidden, is never asked again",
              why: hidden == "0" && unasked.isEmpty() ? "" : "locks `${hidden}`, then `${unasked}`");

    Window v = Window.headless(width: 64, height: 48);
    CursorAsk web = CursorAsk.make(againAtOnce: true);
    askCursor(w: v, cursor: web, mode: CursorMode::Locked);
    string first = pumpedLocks(w: v, began: began, ask: web);
    v.post(event: Event::Focus(focused: false), at: msAfter(began: began, ms: 5));
    string again = pumpedLocks(w: v, began: began, ask: web);
    t.verdict(name: "OpenPlatform: on the web's rule a dropped lock is asked for again at once",
              why: first == "1" && again == "0 1" ? "" : "locks `${first}`, then `${again}`");
    askCursor(w: v, cursor: web, mode: CursorMode::Normal);
    string released = pumpedLocks(w: v, began: began, ask: web);
    t.verdict(name: "OpenPlatform: on the web's rule the game's own release, to Normal, is not asked again",
              why: released == "0" ? "" : "locks `${released}`");

    // A lock wanted and not held, with no lock dropped in the pump: only the native rule asks at the focus's return.
    Window x = Window.headless(width: 64, height: 48);
    CursorAsk webWants = CursorAsk.make(againAtOnce: true);
    webWants.wanted = CursorMode::Locked;
    x.post(event: Event::Focus(focused: true), at: msAfter(began: began, ms: 9));
    string webFocus = pumpedLocks(w: x, began: began, ask: webWants);
    Window y = Window.headless(width: 64, height: 48);
    CursorAsk nativeWants = CursorAsk.make(againAtOnce: false);
    nativeWants.wanted = CursorMode::Locked;
    y.post(event: Event::Focus(focused: true), at: msAfter(began: began, ms: 9));
    string nativeFocus = pumpedLocks(w: y, began: began, ask: nativeWants);
    t.verdict(name: "OpenPlatform: the focus's return asks for the lock on the native rule alone",
              why: webFocus.isEmpty() && nativeFocus == "1" ? "" : "web `${webFocus}`, native `${nativeFocus}`");
    Window z = Window.headless(width: 64, height: 48);
    CursorAsk shown = CursorAsk.make(againAtOnce: false);
    z.post(event: Event::Focus(focused: true), at: msAfter(began: began, ms: 9));
    string normal = pumpedLocks(w: z, began: began, ask: shown);
    t.verdict(name: "OpenPlatform: the focus's return asks nothing while the game asks Normal", why: normal.isEmpty() ? "" : "locks `${normal}`");

    bool same = windowMode(mode: CursorMode::Normal) == WindowCursor::Normal && windowMode(mode: CursorMode::Hidden) == WindowCursor::Hidden
        && windowMode(mode: CursorMode::Locked) == WindowCursor::Locked;
    t.verdict(name: "OpenPlatform: each of kyoten's cursor modes is the window's of the same name", why: same ? "" : "one is another");
}

// Each open platform's rule: the web's asks again at once, a native desktop's at the focus's return.
@compileFor(ARCH_WASM32)
fn bool expectedAgainAtOnce() { return true; }
@compileFor(!ARCH_WASM32)
fn bool expectedAgainAtOnce() { return false; }

// The open platform itself, on a headless window: player 1's mode set on its window and kept, another player's on none.
unsafe fn void cursorPlatformCases(ref Tally t) {
    OpenPlatform here = OpenPlatform.make();
    bool rule = here.askedCursor().againAtOnce;
    t.verdict(name: "OpenPlatform: its rule for asking again is its target's", why: rule == expectedAgainAtOnce() ? "" : "the other's");
    bool opened = here.openWindow(title: "cursor", width: 64, height: 48, headless: true, focused: false);
    here.cursor(player: 1, mode: CursorMode::Locked);
    DynamicArray<Sample> first = DynamicArray.empty();
    bool open = here.pumped(into: first);
    string locked = locksOf(samples: first);
    string kept = modeWord(m: here.askedCursor().wanted);
    t.verdict(name: "OpenPlatform: player 1's Locked locks its window, and is kept",
              why: opened && open && locked == "1" && kept == "Locked" ? "" : "locks `${locked}`, kept ${kept}");
    here.cursor(player: 2, mode: CursorMode::Normal);
    DynamicArray<Sample> second = DynamicArray.empty();
    bool still = here.pumped(into: second);
    string other = locksOf(samples: second);
    string after = modeWord(m: here.askedCursor().wanted);
    t.verdict(name: "OpenPlatform: another player's cursor is no window's", why: other.isEmpty() && after == "Locked" ? "" : "locks `${other}`, kept ${after}");
    OpenPlatform closed = OpenPlatform.make();
    closed.cursor(player: 1, mode: CursorMode::Hidden);
    string waiting = modeWord(m: closed.askedCursor().wanted);
    t.verdict(name: "OpenPlatform: a mode asked before its window opens is kept", why: waiting == "Hidden" ? "" : "kept ${waiting}");
}

// A sample spelled: K, M or P for its device, a pad's slot and a colon, the control, `=` and its value; a pad's
// connection `+` or `-`; then `@` and its time in milliseconds after `began`.
fn string sampleText(const ref Sample s) {
    int64 ms = s.at / 1000000;
    int32 slot = s.slot;
    int32 control = s.control;
    string on = s.value >= 0.5 ? "1" : "0";
    float32 v = s.value;
    match (s.kind) {
        case Connected: { return "P${slot}+@${ms}"; }
        case Disconnected: { return "P${slot}-@${ms}"; }
        case Travel: { return "T${slot}:${control}=${v}@${ms}"; }
        case Axis: { return "A${slot}:${control}=${v}@${ms}"; }
        case Motion: { return "D${control}=${v}@${ms}"; }
        case Text: { return "X${control}@${ms}"; }
        case Repeat: { return "R${control}@${ms}"; }
        case Cursor: { return "C${control}=${v}@${ms}"; }
        case Lock: { return "L=${on}@${ms}"; }
        case Control: { }
    };
    return match (s.device) {
        case Keyboard: "K${control}=${on}@${ms}";
        case Mouse: "M${control}=${on}@${ms}";
        case Gamepad: "P${slot}:${control}=${on}@${ms}";
    };
}

fn Instant msAfter(Instant began, int64 ms) { return began + Duration.fromMillis(ms: ms); }

// The open platforms' pump, on a headless window with posted events: a key, a mouse's button, a pad's button and its
// connection, each a sample at its event's time; a key's system repeat a sample of its own; a touch none; a close request
// ends it.
unsafe fn void pumpCases(ref Tally t) {
    Window w = Window.headless(width: 64, height: 48);
    Instant began = monotonicNow();
    w.post(event: Event::KeyDown(key: Key::ArrowUp, mods: 0, repeat: false), at: msAfter(began: began, ms: 5));
    w.post(event: Event::KeyDown(key: Key::ArrowUp, mods: 0, repeat: true), at: msAfter(began: began, ms: 6));
    w.post(event: Event::KeyUp(key: Key::ArrowUp, mods: 0), at: msAfter(began: began, ms: 7));
    w.post(event: Event::PointerDown(pointer: Pointer.at(id: 1, kind: PointerKind::Mouse, x: 16.0, y: 12.0),
                                     button: PointerButton::Left, mods: 0), at: msAfter(began: began, ms: 8));
    w.post(event: Event::PointerUp(pointer: Pointer.at(id: 1, kind: PointerKind::Mouse, x: 16.0, y: 12.0),
                                   button: PointerButton::Left, mods: 0), at: msAfter(began: began, ms: 9));
    w.post(event: Event::PointerDown(pointer: Pointer.at(id: 4, kind: PointerKind::Touch, x: 1.0, y: 2.0),
                                     button: PointerButton::Left, mods: 0), at: msAfter(began: began, ms: 10));
    w.post(event: Event::PointerUp(pointer: Pointer.at(id: 4, kind: PointerKind::Touch, x: 1.0, y: 2.0),
                                   button: PointerButton::Left, mods: 0), at: msAfter(began: began, ms: 11));
    w.post(event: Event::PadConnected(slot: 2), at: msAfter(began: began, ms: 12));
    w.post(event: Event::PadButtonDown(slot: 2, button: PadButton::RightShoulder), at: msAfter(began: began, ms: 13));
    w.post(event: Event::PadButtonUp(slot: 2, button: PadButton::RightShoulder), at: msAfter(began: began, ms: 14));
    w.post(event: Event::PadDisconnected(slot: 2), at: msAfter(began: began, ms: 15));
    w.post(event: Event::Text(c: '\u{00E9}'), at: msAfter(began: began, ms: 15));
    DynamicArray<Sample> samples = DynamicArray.empty();
    PadReadings pads = PadReadings.make();
    CursorAsk ask = CursorAsk.make(againAtOnce: false);
    Size size = w.size();
    bool open = pumpInto(w: w, began: began, into: samples, pads: pads, size: size, cursor: ask);
    string got = textOf(samples: samples);
    t.verdict(name: "OpenPlatform: a window's input is samples at their events' times, a key's repeat its own, a touch none",
              why: got == "K82=1@5 R82@6 K82=0@7 C0=-0.5@8 C1=0.5@8 M0=1@8 C0=-0.5@9 C1=0.5@9 M0=0@9 P2+@12 P2:5=1@13 P2:5=0@14 P2-@15 X233@15" ? "" : "got `${got}`");
    t.verdict(name: "OpenPlatform: a pump with no close request keeps the window open", why: open ? "" : "it closed");
    w.post(event: Event::CloseRequested, at: msAfter(began: began, ms: 16));
    DynamicArray<Sample> after = DynamicArray.empty();
    bool still = pumpInto(w: w, began: began, into: after, pads: pads, size: size, cursor: ask);
    t.verdict(name: "OpenPlatform: a close request ends the run", why: !still && after.length() == 0 ? "" : "it went on");
}

// The cursor (design/input.md § Decided, 2026-11-26, the sixth part's question 1): each mouse event's place in the window
// as the cursor's two samples, -1 to 1 across and up, by the window's logical size as of that event, which a `Resize`
// moves and the next pump keeps; and the window's lock as a sample, whoever asked (question 2).
unsafe fn void cursorPumpCases(ref Tally t) {
    Window w = Window.headless(width: 64, height: 48);
    Instant began = monotonicNow();
    PadReadings pads = PadReadings.make();
    CursorAsk ask = CursorAsk.make(againAtOnce: false);
    Size size = w.size();
    w.post(event: Event::PointerEnter(pointer: Pointer.at(id: 1, kind: PointerKind::Mouse, x: 32.0, y: 24.0)), at: msAfter(began: began, ms: 3));
    w.post(event: Event::Resize(width: 32, height: 24), at: msAfter(began: began, ms: 4));
    w.post(event: Event::PointerMove(pointer: Pointer.at(id: 1, kind: PointerKind::Mouse, x: 8.0, y: 6.0), dx: 0.0, dy: 0.0),
           at: msAfter(began: began, ms: 5));
    w.post(event: Event::PointerLock(locked: true), at: msAfter(began: began, ms: 6));
    w.post(event: Event::PointerLock(locked: false), at: msAfter(began: began, ms: 7));
    w.post(event: Event::PointerEnter(pointer: Pointer.at(id: 2, kind: PointerKind::Touch, x: 1.0, y: 1.0)), at: msAfter(began: began, ms: 8));
    DynamicArray<Sample> first = DynamicArray.empty();
    bool open = pumpInto(w: w, began: began, into: first, pads: pads, size: size, cursor: ask);
    string got = textOf(samples: first);
    t.verdict(name: "OpenPlatform: a mouse's place is the cursor's samples, by the window's size as of each event; a lock a sample; a touch none",
              why: got == "C0=0@3 C1=0@3 C0=-0.5@5 C1=0.5@5 L=1@6 L=0@7" ? "" : "got `${got}`");
    w.post(event: Event::PointerMove(pointer: Pointer.at(id: 1, kind: PointerKind::Mouse, x: 16.0, y: 12.0), dx: 8.0, dy: 6.0),
           at: msAfter(began: began, ms: 9));
    DynamicArray<Sample> second = DynamicArray.empty();
    bool still = pumpInto(w: w, began: began, into: second, pads: pads, size: size, cursor: ask);
    string next = textOf(samples: second);
    t.verdict(name: "OpenPlatform: the next pump places by the size the last one left",
              why: next == "C0=0@9 C1=0@9 D0=8@9 D1=6@9" ? "" : "got `${next}`");
    t.verdict(name: "OpenPlatform: and neither pump closed the window", why: open && still ? "" : "one did");
    Size unsized = Size.of(width: 0, height: 0);
    w.post(event: Event::PointerMove(pointer: Pointer.at(id: 1, kind: PointerKind::Mouse, x: 16.0, y: 12.0), dx: 0.0, dy: 0.0),
           at: msAfter(began: began, ms: 10));
    DynamicArray<Sample> third = DynamicArray.empty();
    bool fresh = pumpInto(w: w, began: began, into: third, pads: pads, size: unsized, cursor: ask);
    string read = textOf(samples: third);
    t.verdict(name: "OpenPlatform: a pump holding no size places by the window's own, which the resize posted to it moved",
              why: fresh && read == "C0=0@10 C1=0@10" ? "" : "got `${read}`");
    Window flat = Window.headless(width: 0, height: 0);
    PadReadings flatPads = PadReadings.make();
    Size flatSize = Size.of(width: 0, height: 0);
    flat.post(event: Event::PointerMove(pointer: Pointer.at(id: 1, kind: PointerKind::Mouse, x: 1.0, y: 1.0), dx: 1.0, dy: 0.0),
              at: msAfter(began: began, ms: 11));
    DynamicArray<Sample> nowhere = DynamicArray.empty();
    bool flatOpen = pumpInto(w: flat, began: began, into: nowhere, pads: flatPads, size: flatSize, cursor: ask);
    string unplaced = textOf(samples: nowhere);
    t.verdict(name: "OpenPlatform: a window with no area places no cursor, its motion still a sample",
              why: flatOpen && unplaced == "D0=1@11" ? "" : "got `${unplaced}`");
}

fn string textOf(const ref DynamicArray<Sample> samples) {
    string got = "";
    foreach (const ref Sample s in samples.iterConst()) {
        string one = sampleText(s: s);
        got = got.isEmpty() ? copy one : got + " " + one;
    }
    return got;
}

// The second part of step 8: the mouse's motion, each axis that moved a sample at its event's time, as the window
// reports it; and each pad's reading at its time (`padAt`, WIN-28), a sample for each button's travel and each stick's
// axis that moved since the reading before, placed among the events' samples by time.
unsafe fn void valuePumpCases(ref Tally t) {
    Window w = Window.headless(width: 64, height: 48);
    Instant began = monotonicNow();
    PadReadings pads = PadReadings.make();
    CursorAsk ask = CursorAsk.make(againAtOnce: false);
    Pointer mouse = Pointer.at(id: 1, kind: PointerKind::Mouse, x: 48.0, y: 36.0);
    Size size = w.size();
    w.post(event: Event::PointerMove(pointer: mouse, dx: 3.0, dy: -2.0), at: msAfter(began: began, ms: 4));
    // A key between them, or the window would join the two moves of one pointer into one (`@kama/window`'s coalescing).
    w.post(event: Event::KeyDown(key: Key::KeyQ, mods: 0, repeat: false), at: msAfter(began: began, ms: 5));
    w.post(event: Event::PointerMove(pointer: mouse, dx: 0.0, dy: 5.0), at: msAfter(began: began, ms: 6));
    w.post(event: Event::PointerMove(pointer: Pointer.at(id: 4, kind: PointerKind::Touch, x: 1.0, y: 2.0), dx: 1.0, dy: 1.0),
           at: msAfter(began: began, ms: 7));
    DynamicArray<Sample> moved = DynamicArray.empty();
    bool open = pumpInto(w: w, began: began, into: moved, pads: pads, size: size, cursor: ask);
    string motion = textOf(samples: moved);
    t.verdict(name: "OpenPlatform: the mouse's motion is a sample per axis it moved, as the window reports it; a touch's none",
              why: motion == "C0=0.5@4 C1=-0.5@4 D0=3@4 D1=-2@4 K20=1@5 C0=0.5@6 C1=-0.5@6 D1=5@6" ? "" : "got `${motion}`");

    Gamepad g = Gamepad.neutral();
    g.setValue(button: PadButton::LeftTrigger, value: 0.5);
    g.setAxis(axis: PadAxis::LeftX, value: 0.25);
    g.setAxis(axis: PadAxis::LeftY, value: -0.75);
    w.postPad(slot: 1, pad: g, at: msAfter(began: began, ms: 30));
    w.post(event: Event::KeyDown(key: Key::KeyW, mods: 0, repeat: false), at: msAfter(began: began, ms: 40));
    DynamicArray<Sample> read = DynamicArray.empty();
    bool still = pumpInto(w: w, began: began, into: read, pads: pads, size: size, cursor: ask);
    string first = textOf(samples: read);
    t.verdict(name: "OpenPlatform: a pad's reading is a sample for each travel and axis that moved, at its time, before a later event's",
              why: first == "P1+@30 P1:6=1@30 T1:6=0.5@30 A1:0=0.25@30 A1:1=-0.75@30 K26=1@40" ? "" : "got `${first}`");
    DynamicArray<Sample> same = DynamicArray.empty();
    bool steady = pumpInto(w: w, began: began, into: same, pads: pads, size: size, cursor: ask);
    string still2 = textOf(samples: same);
    t.verdict(name: "OpenPlatform: a reading where nothing moved makes no sample", why: same.length() == 0 ? "" : "got `" + still2 + "`");
    g.setAxis(axis: PadAxis::LeftX, value: 0.5);
    w.postPad(slot: 1, pad: g, at: msAfter(began: began, ms: 50));
    DynamicArray<Sample> nudged = DynamicArray.empty();
    bool again = pumpInto(w: w, began: began, into: nudged, pads: pads, size: size, cursor: ask);
    string stick = textOf(samples: nudged);
    t.verdict(name: "OpenPlatform: a stick moved alone is its axis's sample, at the reading's time",
              why: stick == "A1:0=0.5@50" ? "" : "got `${stick}`");
    w.postPad(slot: 1, pad: Gamepad.disconnected(), at: msAfter(began: began, ms: 60));
    DynamicArray<Sample> gone = DynamicArray.empty();
    bool left = pumpInto(w: w, began: began, into: gone, pads: pads, size: size, cursor: ask);
    w.postPad(slot: 1, pad: g, at: msAfter(began: began, ms: 70));
    DynamicArray<Sample> back = DynamicArray.empty();
    bool returned = pumpInto(w: w, began: began, into: back, pads: pads, size: size, cursor: ask);
    string fresh = textOf(samples: back);
    t.verdict(name: "OpenPlatform: a pad back after a disconnect reads anew, every travel and axis off rest a sample",
              why: fresh == "P1+@70 P1:6=1@70 T1:6=0.5@70 A1:0=0.5@70 A1:1=-0.75@70" ? "" : "got `${fresh}`");
    string leaving = textOf(samples: gone);
    t.verdict(name: "OpenPlatform: and its disconnect was its event's samples alone",
              why: leaving == "P1:6=0@60 P1-@60" ? "" : "got `" + leaving + "`");
}

fn void platformTests(ref Tally t) {
    requestLoopCases(t: t);
    viewLoopCases(t: t);
    cursorLoopCases(t: t);
    optionCases(t: t);
    timestampCases(t: t);
    windowCases(t: t);
    phaseCases(t: t);
    lifecycleCases(t: t);
    endCases(t: t);
    fixedCases(t: t);
    playCases(t: t);
    openCases(t: t);
    inputCases(t: t);
    pumpCases(t: t);
    valuePumpCases(t: t);
    cursorPumpCases(t: t);
    cursorAskCases(t: t);
    cursorPlatformCases(t: t);
}
