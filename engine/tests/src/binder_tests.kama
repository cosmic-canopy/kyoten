// kyoten::input's binder (the first slice's step 8, KYR-54; design/input.md § Decided): bindings read by
// `@kama/window`'s names and refused at load when they name nothing; each step's hand-off split by the samples' times;
// the decided edges; player 1 on the keyboard and the mouse throughout and the first pad pressed, locked until it
// disconnects. Every sample is written by hand, so each case states its time and its wanted value literally: a key by
// its HID usage id (ArrowUp 82, KeyW 26, KeyA 4), a mouse button by the W3C's (Left 0), a pad's button by the
// standard gamepad's index (South 0, RightShoulder 5).

import { Tally, spelled, std::collections::DynamicArray, std::collections::SortedMap, std::memory::Owned,
         std::serialization::text::json::deserializeJsonBuffer,
         kyoten::frame::Digital, kyoten::frame::Sample, kyoten::frame::Device, kyoten::frame::ActionList,
         std::math::Vec2, std::math::Vec3, std::math::sqrt, kyoten::frame::Time, kyoten::frame::Scheme,
         kyoten::records::BindingRecord,
         kyoten::input::Binder, kyoten::input::BindingError };

export { binderTests };

comptime int64 EVERYTHING = 9223372036854775807;

fn SortedMap<string, BindingRecord> bindingsOf(const ref string json) {
    Result<SortedMap<string, BindingRecord>, Owned<Error>> read = deserializeJsonBuffer::<SortedMap<string, BindingRecord>>(src: copy json, strict: true);
    return match (give read) {
        case Ok(value: m): give m;
        case Err(error: e): {
            string why = e.message();
            panic(msg: "a test's bindings read: " + why);
        }
    };
}

// The digital actions `a` and `b` (either "" for none), then a value action of each kind: an analog `throttle` (a
// state, analog 0); a vector2 `move` (a state, vector2 0) and `look` (a delta, vector2 1); a vector3 `fly` (a state);
// and a pose `hand`, which no device binds.
fn ActionList actionsOf(const ref string a, const ref string b) {
    ActionList made = ActionList.make();
    if (!a.isEmpty()) { made.addDigital(name: copy a); }
    if (!b.isEmpty()) { made.addDigital(name: copy b); }
    made.addAnalog(name: "throttle", delta: false);
    made.addVector2(name: "move", delta: false);
    made.addVector2(name: "look", delta: true);
    made.addVector3(name: "fly", delta: false);
    made.addPose(name: "hand");
    return made;
}

// A binder for player 1 and the actions `faster` and `jump`, bound by `json`; it must be accepted.
fn Binder binderFor(const ref string json) {
    ActionList actions = actionsOf(a: "faster", b: "jump");
    SortedMap<string, BindingRecord> b = bindingsOf(json: json);
    Result<Binder, BindingError> made = Binder.make(players: 1, actions: actions, bindings: b, hz: 60);
    return match (give made) {
        case Ok(value: v): give v;
        case Err(error: e): {
            string why = e.message();
            panic(msg: "a test's bindings refused: " + why);
        }
    };
}

// The refusal `json` gets, or "" when it is accepted.
fn string refusalOf(const ref string json) {
    ActionList actions = actionsOf(a: "faster", b: "jump");
    SortedMap<string, BindingRecord> b = bindingsOf(json: json);
    Result<Binder, BindingError> made = Binder.make(players: 1, actions: actions, bindings: b, hz: 60);
    return match (made) {
        case Ok(value: v): "";
        case Err(error: e): e.message();
    };
}

fn void hand(ref Binder b, Sample s) {
    DynamicArray<Sample> one = DynamicArray.empty();
    one.add(item: s);
    b.take(samples: one);
}

fn Sample key(int32 control, bool down, int64 at) {
    return Sample.make(device: Device::Keyboard, slot: 0, control: control, value: down ? 1.0 : 0.0, at: at);
}

fn Sample pad(int32 slot, int32 control, float32 value, int64 at) {
    return Sample.make(device: Device::Gamepad, slot: slot, control: control, value: value, at: at);
}

// Action `action`'s value in the hand-off of step `step` up to `until`, spelled.
fn string stepped(ref Binder b, int64 step, int64 until, int32 action) {
    Digital d = b.handoff(index: step, until: until).digital(player: 1, action: action);
    return spelled(d: d);
}

fn void expectStep(ref Tally t, ref Binder b, int64 step, int64 until, const ref string name, const ref string want) {
    string got = stepped(b: b, step: step, until: until, action: 0);
    t.verdict(name: name, why: got == want ? "" : "got ${got}, want ${want}");
}

fn void expectRefused(ref Tally t, const ref string name, const ref string json, const ref string says) {
    string why = refusalOf(json: json);
    if (why.contains(substring: says)) { t.verdict(name: name, why: ""); }
    else { t.verdict(name: name, why: "refusal `${why}` does not say `${says}`"); }
}

fn void bindingCases(ref Tally t) {
    Binder b = binderFor(json: "{ \"faster\": { \"keyboard\": \"ArrowUp\", \"gamepad\": \"RightShoulder\" } }");
    bool two = b.boundCount(action: 0) == 2 && b.boundCount(action: 1) == 0 && b.digitalActions() == 2;
    t.verdict(name: "binder: a control on each of two devices binds two, an unbound action none", why: two ? "" : "other counts");
    Binder l = binderFor(json: "{ \"faster\": { \"keyboard\": [\"ArrowUp\", \"KeyW\"], \"mouse\": \"Left\" } }");
    isize listed = l.boundCount(action: 0);
    t.verdict(name: "binder: a list binds each control, and the mouse its own", why: listed == 3 ? "" : "${listed} bound");
    string ok = refusalOf(json: "{ \"faster\": { \"keyboard\": \"ArrowUp\" }, \"jump\": { \"gamepad\": \"South\" } }");
    t.verdict(name: "binder: bindings naming the game's actions by their controls' names are accepted", why: ok);
    string trigger = refusalOf(json: "{ \"throttle\": { \"gamepad\": \"RightTrigger\" } }");
    t.verdict(name: "binder: an analog on a trigger is accepted, its travel read", why: trigger);
    string notNamed = refusalOf(json: "{ \"look\": { \"mouse\": \"Motion\" } }");
    t.verdict(name: "binder: a value action is an action the game declares, not one it names nowhere",
              why: notNamed.contains(substring: "name no action") ? "`look` called no action" : "");
    int32 analogs = b.handoff(index: 9, until: 900).analogActions();
    int32 vector2s = b.handoff(index: 9, until: 900).vector2Actions();
    float32 throttle = b.handoff(index: 9, until: 900).analog(player: 1, action: 0);
    Vec2 look = b.handoff(index: 9, until: 900).vector2(player: 1, action: 0);
    bool rested = analogs == 1 && vector2s == 2 && throttle == 0.0 && look.x == 0.0 && look.y == 0.0;
    t.verdict(name: "binder: its hand-off has room for every kind, each value at rest", why: rested ? "" : "other sizes or values");
    isize none = b.valueEntries();
    t.verdict(name: "binder: a value action bound by no entry reads none", why: none == 0 ? "" : "${none} entries");

    expectRefused(t: t, name: "binder: a binding naming no action is refused, by its name",
                  json: "{ \"dash\": { \"keyboard\": \"Space\" } }", says: "the bindings of `dash` name no action");
    expectRefused(t: t, name: "binder: a misspelled key is refused, naming it",
                  json: "{ \"faster\": { \"keyboard\": \"Arrowup\" } }", says: "names `Arrowup`, which is no keyboard control");
    expectRefused(t: t, name: "binder: and the refusal lists the keys' names",
                  json: "{ \"faster\": { \"keyboard\": \"Arrowup\" } }", says: "ArrowUp");
    expectRefused(t: t, name: "binder: a stick's axis is no gamepad button yet",
                  json: "{ \"faster\": { \"gamepad\": \"LeftX\" } }", says: "names `LeftX`, which is no gamepad control");
    expectRefused(t: t, name: "binder: a misspelling in a list is refused",
                  json: "{ \"faster\": { \"keyboard\": [\"ArrowUp\", \"KeyQQ\"] } }", says: "names `KeyQQ`");
    expectRefused(t: t, name: "binder: a key's name on the mouse is refused",
                  json: "{ \"faster\": { \"mouse\": \"ArrowUp\" } }", says: "which is no mouse control");
    expectRefused(t: t, name: "binder: an object entry is refused until KYR-54's later parts read it",
                  json: "{ \"faster\": { \"keyboard\": { \"control\": \"Space\", \"gestures\": [] } } }",
                  says: "the keyboard binding of `faster` is an object");
    string both = refusalOf(json: "{ \"dash\": { \"keyboard\": \"Space\" }, \"faster\": { \"keyboard\": \"Arrowup\" } }");
    bool all = both.contains(substring: "`dash`") && both.contains(substring: "`Arrowup`");
    t.verdict(name: "binder: every refusal is said at once", why: all ? "" : "only `${both}`");
}

fn void edgeCases(ref Tally t) {
    string json = "{ \"faster\": { \"keyboard\": [\"ArrowUp\", \"KeyW\"], \"gamepad\": \"RightShoulder\", \"mouse\": \"Left\" }, \"jump\": { \"keyboard\": \"KeyA\" } }";
    Binder b = binderFor(json: json);
    expectStep(t: t, b: b, step: 0, until: 100, name: "binder: off before any sample", want: "---");

    hand(b: b, s: key(control: 82, down: true, at: 150));
    expectStep(t: t, b: b, step: 1, until: 200, name: "binder: a press in the step's window is pressed and held", want: "HP-");
    expectStep(t: t, b: b, step: 2, until: 300, name: "binder: the next step, held alone", want: "H--");
    hand(b: b, s: key(control: 82, down: false, at: 350));
    expectStep(t: t, b: b, step: 3, until: 400, name: "binder: a release is released, not held", want: "--R");
    expectStep(t: t, b: b, step: 4, until: 500, name: "binder: then off", want: "---");

    // Split by time: a press after the step's end waits for the step whose window holds it.
    hand(b: b, s: key(control: 82, down: true, at: 650));
    expectStep(t: t, b: b, step: 5, until: 600, name: "binder: a sample after the step's end is not the step's", want: "---");
    expectStep(t: t, b: b, step: 6, until: 700, name: "binder: it is the next step's", want: "HP-");
    hand(b: b, s: key(control: 82, down: false, at: 750));

    // A tap inside one step: the press, held, then the release on the next step.
    hand(b: b, s: key(control: 82, down: true, at: 810));
    hand(b: b, s: key(control: 82, down: false, at: 820));
    expectStep(t: t, b: b, step: 7, until: 900, name: "binder: a tap inside one step shows the press, held",
               want: "HP-");
    expectStep(t: t, b: b, step: 8, until: 1000, name: "binder: and its release on the next step", want: "--R");
    expectStep(t: t, b: b, step: 9, until: 1100, name: "binder: then off", want: "---");

    // A release then a press inside one step: both edges, held.
    hand(b: b, s: key(control: 82, down: true, at: 1150));
    expectStep(t: t, b: b, step: 10, until: 1200, name: "binder: held", want: "HP-");
    hand(b: b, s: key(control: 82, down: false, at: 1210));
    hand(b: b, s: key(control: 82, down: true, at: 1220));
    expectStep(t: t, b: b, step: 11, until: 1300, name: "binder: a release and a press in one step show both, held", want: "HPR");
    hand(b: b, s: key(control: 82, down: false, at: 1350));
    expectStep(t: t, b: b, step: 12, until: 1400, name: "binder: released", want: "--R");

    // Two controls of one action: held while either is, its edges those of both together.
    hand(b: b, s: key(control: 82, down: true, at: 1450));
    expectStep(t: t, b: b, step: 13, until: 1500, name: "binder: the first of two controls presses", want: "HP-");
    hand(b: b, s: key(control: 26, down: true, at: 1550));
    expectStep(t: t, b: b, step: 14, until: 1600, name: "binder: the second, while the first is held, presses nothing", want: "H--");
    hand(b: b, s: key(control: 82, down: false, at: 1650));
    expectStep(t: t, b: b, step: 15, until: 1700, name: "binder: the first let go, while the second is held, releases nothing",
               want: "H--");
    hand(b: b, s: key(control: 82, down: true, at: 1750));
    expectStep(t: t, b: b, step: 16, until: 1800, name: "binder: a key's repeat, a down while held, presses nothing", want: "H--");
    hand(b: b, s: key(control: 82, down: false, at: 1850));
    hand(b: b, s: key(control: 26, down: false, at: 1860));
    expectStep(t: t, b: b, step: 17, until: 1900, name: "binder: both let go release it", want: "--R");

    // Another action, and another device.
    hand(b: b, s: key(control: 4, down: true, at: 1950));
    string jumpFaster = stepped(b: b, step: 18, until: 2000, action: 0);
    string jump = stepped(b: b, step: 19, until: 2000, action: 1);
    t.verdict(name: "binder: a key of another action moves that action alone",
              why: jumpFaster == "---" && jump == "H--" ? "" : "faster ${jumpFaster}, jump ${jump}");
    hand(b: b, s: key(control: 4, down: false, at: 2050));
    hand(b: b, s: Sample.make(device: Device::Mouse, slot: 0, control: 0, value: 1.0, at: 2150));
    expectStep(t: t, b: b, step: 20, until: 2200, name: "binder: the mouse's Left presses what it is bound to", want: "HP-");
    hand(b: b, s: Sample.make(device: Device::Mouse, slot: 0, control: 0, value: 0.0, at: 2250));
    hand(b: b, s: key(control: 0, down: true, at: 2260));
    expectStep(t: t, b: b, step: 21, until: 2300, name: "binder: a keyboard control with the mouse button's number is not it",
               want: "--R");

    // The last owed step takes everything that arrived.
    hand(b: b, s: key(control: 82, down: true, at: 900000));
    expectStep(t: t, b: b, step: 22, until: EVERYTHING, name: "binder: the frame's last step takes everything that arrived",
               want: "HP-");
    hand(b: b, s: key(control: 82, down: false, at: 900001));
    expectStep(t: t, b: b, step: 23, until: EVERYTHING, name: "binder: released", want: "--R");
}

fn void padCases(ref Tally t) {
    Binder b = binderFor(json: "{ \"faster\": { \"keyboard\": \"ArrowUp\", \"gamepad\": \"RightShoulder\" } }");
    t.verdict(name: "binder: no pad is locked before one is pressed", why: b.lockedPad().isNone() ? "" : "one is");
    hand(b: b, s: Sample.padConnected(slot: 2, at: 10));
    expectStep(t: t, b: b, step: 0, until: 100, name: "binder: a pad's connection presses nothing", want: "---");
    t.verdict(name: "binder: nor locks it", why: b.lockedPad().isNone() ? "" : "it locked");
    hand(b: b, s: pad(slot: 2, control: 5, value: 0.05, at: 110));
    expectStep(t: t, b: b, step: 1, until: 200, name: "binder: a button under PressedAt of its travel presses nothing", want: "---");
    t.verdict(name: "binder: nor locks its pad", why: b.lockedPad().isNone() ? "" : "it locked");

    hand(b: b, s: pad(slot: 2, control: 5, value: 1.0, at: 210));
    expectStep(t: t, b: b, step: 2, until: 300, name: "binder: the first pad pressed drives player 1", want: "HP-");
    bool locked2 = match (b.lockedPad()) { case Some(value: s): s == 2; case None: false; };
    t.verdict(name: "binder: and locks in", why: locked2 ? "" : "not slot 2");
    hand(b: b, s: pad(slot: 2, control: 5, value: 0.0, at: 310));
    expectStep(t: t, b: b, step: 3, until: 400, name: "binder: its release", want: "--R");
    hand(b: b, s: pad(slot: 0, control: 5, value: 1.0, at: 410));
    expectStep(t: t, b: b, step: 4, until: 500, name: "binder: another pad does nothing while one is locked", want: "---");
    hand(b: b, s: pad(slot: 0, control: 5, value: 0.0, at: 510));
    hand(b: b, s: key(control: 82, down: true, at: 520));
    expectStep(t: t, b: b, step: 5, until: 600, name: "binder: the keyboard drives player 1 while a pad is locked", want: "HP-");
    hand(b: b, s: key(control: 82, down: false, at: 610));
    expectStep(t: t, b: b, step: 6, until: 700, name: "binder: released", want: "--R");

    // The locked pad held, then disconnected: its lock goes, and what it held is let go at that moment.
    hand(b: b, s: pad(slot: 2, control: 5, value: 1.0, at: 710));
    expectStep(t: t, b: b, step: 7, until: 800, name: "binder: the locked pad presses again", want: "HP-");
    hand(b: b, s: Sample.padDisconnected(slot: 0, at: 810));
    expectStep(t: t, b: b, step: 8, until: 900, name: "binder: another pad's disconnection changes nothing", want: "H--");
    hand(b: b, s: Sample.padDisconnected(slot: 2, at: 910));
    expectStep(t: t, b: b, step: 9, until: 1000, name: "binder: the locked pad's disconnection releases what it held", want: "--R");
    t.verdict(name: "binder: and lets the lock go", why: b.lockedPad().isNone() ? "" : "still locked");
    hand(b: b, s: pad(slot: 0, control: 0, value: 1.0, at: 1010));
    expectStep(t: t, b: b, step: 10, until: 1100, name: "binder: an unbound button presses nothing", want: "---");
    bool locked0 = match (b.lockedPad()) { case Some(value: s): s == 0; case None: false; };
    t.verdict(name: "binder: but any button pressed takes the lock, the next pad's", why: locked0 ? "" : "not slot 0");
    hand(b: b, s: pad(slot: 0, control: 0, value: 0.0, at: 1110));
    hand(b: b, s: pad(slot: 0, control: 5, value: 1.0, at: 1120));
    expectStep(t: t, b: b, step: 11, until: 1200, name: "binder: and drives player 1", want: "HP-");
}

fn void playerCases(ref Tally t) {
    ActionList actions = actionsOf(a: "faster", b: "");
    SortedMap<string, BindingRecord> map = bindingsOf(json: "{ \"faster\": { \"keyboard\": \"ArrowUp\" } }");
    Result<Binder, BindingError> made = Binder.make(players: 2, actions: actions, bindings: map, hz: 60);
    match (give made) {
        case Ok(value: b): {
            hand(b: b, s: key(control: 82, down: true, at: 50));
            string one = spelled(d: b.handoff(index: 0, until: 100).digital(player: 1, action: 0));
            string two = spelled(d: b.handoff(index: 1, until: 100).digital(player: 2, action: 0));
            bool sized = b.players() == 2;
            t.verdict(name: "binder: the keyboard drives player 1 alone, player 2 off",
                      why: one == "HP-" && two == "---" && sized ? "" : "player 1 ${one}, player 2 ${two}");
        }
        case Err(error: e): {
            string why = e.message();
            t.verdict(name: "binder: the keyboard drives player 1 alone, player 2 off", why: why);
        }
    };
}

fn Sample travel(int32 slot, int32 button, float32 value, int64 at) { return Sample.padTravel(slot: slot, button: button, value: value, at: at); }
fn Sample stick(int32 slot, int32 index, float32 value, int64 at) { return Sample.padAxis(slot: slot, index: index, value: value, at: at); }
fn Sample motion(int32 index, float32 value, int64 at) { return Sample.mouseMotion(index: index, value: value, at: at); }

fn void expectFloat(ref Tally t, const ref string name, float32 got, float32 want) {
    t.verdict(name: name, why: got == want ? "" : "got ${got}, want ${want}");
}

fn void expectVec2(ref Tally t, const ref string name, Vec2 got, float32 x, float32 y) {
    float32 gx = got.x;
    float32 gy = got.y;
    t.verdict(name: name, why: gx == x && gy == y ? "" : "got (${gx}, ${gy}), want (${x}, ${y})");
}

fn void expectVec3(ref Tally t, const ref string name, Vec3 got, float32 x, float32 y, float32 z) {
    float32 gx = got.x;
    float32 gy = got.y;
    float32 gz = got.z;
    t.verdict(name: name, why: gx == x && gy == y && gz == z ? "" : "got (${gx}, ${gy}, ${gz}), want (${x}, ${y}, ${z})");
}

// Action `throttle`, `move`, `look` or `fly` in step `step`'s hand-off up to `until`.
fn float32 throttleAt(ref Binder b, int64 step, int64 until) { return b.handoff(index: step, until: until).analog(player: 1, action: 0); }
fn Vec2 moveAt(ref Binder b, int64 step, int64 until) { return b.handoff(index: step, until: until).vector2(player: 1, action: 0); }
fn Vec2 lookAt(ref Binder b, int64 step, int64 until) { return b.handoff(index: step, until: until).vector2(player: 1, action: 1); }
fn Vec3 flyAt(ref Binder b, int64 step, int64 until) { return b.handoff(index: step, until: until).vector3(player: 1, action: 0); }

// A value action's parts make its value (the second part of step 8): an analog's positive less its negative, keys a
// direction no longer than 1, a stick's axes with its Y turned over, up positive.
fn void partCases(ref Tally t) {
    Binder p = binderFor(json: "{ \"throttle\": { \"keyboard\": { \"positive\": \"KeyW\", \"negative\": \"KeyS\" } } }");
    hand(b: p, s: key(control: 26, down: true, at: 10));
    expectFloat(t: t, name: "binder: an analog's positive key reads 1", got: throttleAt(b: p, step: 0, until: 100), want: 1.0);
    hand(b: p, s: key(control: 22, down: true, at: 110));
    expectFloat(t: t, name: "binder: and its negative too, 0", got: throttleAt(b: p, step: 1, until: 200), want: 0.0);
    hand(b: p, s: key(control: 26, down: false, at: 210));
    expectFloat(t: t, name: "binder: its negative alone, -1", got: throttleAt(b: p, step: 2, until: 300), want: -1.0);

    Binder k = binderFor(json: "{ \"move\": { \"keyboard\": { \"up\": [\"KeyW\", \"ArrowUp\"], \"down\": \"KeyS\", \"left\": \"KeyA\", \"right\": \"KeyD\" } } }");
    hand(b: k, s: key(control: 26, down: true, at: 10));
    expectVec2(t: t, name: "binder: a vector2's up key reads up, positive", got: moveAt(b: k, step: 0, until: 100), x: 0.0, y: 1.0);
    hand(b: k, s: key(control: 7, down: true, at: 110));
    float32 two = 2.0;
    float32 diagonal = 1.0 / sqrt(x: two);
    expectVec2(t: t, name: "binder: up and right make a diagonal no longer than 1", got: moveAt(b: k, step: 1, until: 200),
               x: diagonal, y: diagonal);
    hand(b: k, s: key(control: 26, down: false, at: 210));
    hand(b: k, s: key(control: 7, down: false, at: 220));
    hand(b: k, s: key(control: 82, down: true, at: 230));
    expectVec2(t: t, name: "binder: a part's second key reads as its first", got: moveAt(b: k, step: 2, until: 300), x: 0.0, y: 1.0);
    hand(b: k, s: key(control: 22, down: true, at: 310));
    expectVec2(t: t, name: "binder: up and down cancel", got: moveAt(b: k, step: 3, until: 400), x: 0.0, y: 0.0);

    Binder a = binderFor(json: "{ \"move\": { \"gamepad\": { \"x\": \"LeftX\", \"y\": \"LeftY\" } } }");
    hand(b: a, s: pad(slot: 0, control: 0, value: 1.0, at: 5));
    hand(b: a, s: stick(slot: 0, index: 0, value: 0.5, at: 10));
    hand(b: a, s: stick(slot: 0, index: 1, value: 0.25, at: 20));
    expectVec2(t: t, name: "binder: a stick's axes read as they are, its Y turned over so up is positive",
               got: moveAt(b: a, step: 0, until: 100), x: 0.5, y: -0.25);
    hand(b: a, s: stick(slot: 1, index: 0, value: -1.0, at: 110));
    expectVec2(t: t, name: "binder: another pad's stick moves nothing while one is locked", got: moveAt(b: a, step: 1, until: 200),
               x: 0.5, y: -0.25);
    hand(b: a, s: Sample.padDisconnected(slot: 0, at: 210));
    expectVec2(t: t, name: "binder: the locked pad's disconnection sets its sticks at rest", got: moveAt(b: a, step: 2, until: 300),
               x: 0.0, y: 0.0);

    Binder f = binderFor(json: "{ \"fly\": { \"keyboard\": { \"forward\": \"KeyW\", \"up\": \"Space\" } } }");
    hand(b: f, s: key(control: 26, down: true, at: 10));
    expectVec3(t: t, name: "binder: a vector3's forward is -Z", got: flyAt(b: f, step: 0, until: 100), x: 0.0, y: 0.0, z: -1.0);
    hand(b: f, s: key(control: 44, down: true, at: 110));
    expectVec3(t: t, name: "binder: forward and up, a diagonal no longer than 1", got: flyAt(b: f, step: 1, until: 200), x: 0.0,
               y: diagonal, z: -diagonal);
}

// A trigger's travel, the lock, and which of an action's devices drives a state.
fn void travelCases(ref Tally t) {
    Binder b = binderFor(json: "{ \"throttle\": { \"keyboard\": { \"positive\": \"KeyW\" }, \"gamepad\": \"RightTrigger\" } }");
    hand(b: b, s: travel(slot: 2, button: 7, value: 0.5, at: 10));
    expectFloat(t: t, name: "binder: a trigger's travel with no pad locked moves nothing", got: throttleAt(b: b, step: 0, until: 100),
                want: 0.0);
    bool none = match (b.lockedPad()) { case Some(value: s): false; case None: true; };
    t.verdict(name: "binder: and takes no lock: a travel is no press", why: none ? "" : "a pad took the lock");
    hand(b: b, s: pad(slot: 0, control: 0, value: 1.0, at: 110));
    hand(b: b, s: travel(slot: 0, button: 7, value: 0.25, at: 120));
    expectFloat(t: t, name: "binder: the locked pad's trigger reads its travel", got: throttleAt(b: b, step: 1, until: 200), want: 0.25);
    hand(b: b, s: travel(slot: 2, button: 7, value: 0.9, at: 210));
    expectFloat(t: t, name: "binder: another pad's trigger moves nothing", got: throttleAt(b: b, step: 2, until: 300), want: 0.25);
    hand(b: b, s: key(control: 26, down: true, at: 310));
    expectFloat(t: t, name: "binder: a state reads its most actuated device, a key held over a trigger's quarter",
                got: throttleAt(b: b, step: 3, until: 400), want: 1.0);
    hand(b: b, s: key(control: 26, down: false, at: 410));
    expectFloat(t: t, name: "binder: and the trigger again once the key is up", got: throttleAt(b: b, step: 4, until: 500), want: 0.25);
    hand(b: b, s: Sample.padDisconnected(slot: 0, at: 510));
    expectFloat(t: t, name: "binder: the locked pad gone, its trigger at rest", got: throttleAt(b: b, step: 5, until: 600), want: 0.0);
}

// A delta: the mouse's motion that landed in each step, split by time, its Y turned over; a stick held, times the
// step's seconds; both devices summed.
fn void deltaCases(ref Tally t) {
    Binder m = binderFor(json: "{ \"look\": { \"mouse\": \"Motion\" } }");
    hand(b: m, s: motion(index: 0, value: 3.0, at: 10));
    hand(b: m, s: motion(index: 1, value: 2.0, at: 20));
    hand(b: m, s: motion(index: 0, value: 1.0, at: 150));
    hand(b: m, s: motion(index: 0, value: 2.0, at: 250));
    expectVec2(t: t, name: "binder: the mouse's motion in a step, its Y down the window turned over",
               got: lookAt(b: m, step: 0, until: 100), x: 3.0, y: -2.0);
    expectVec2(t: t, name: "binder: the next step's its own, split by time", got: lookAt(b: m, step: 1, until: 200), x: 1.0, y: 0.0);
    expectVec2(t: t, name: "binder: and the last step everything after", got: lookAt(b: m, step: 2, until: 300), x: 2.0, y: 0.0);
    expectVec2(t: t, name: "binder: a step with no motion moves nothing", got: lookAt(b: m, step: 3, until: 400), x: 0.0, y: 0.0);

    float32 dt = Time::dtAt(hz: 60);
    Binder s = binderFor(json: "{ \"look\": { \"mouse\": \"Motion\", \"gamepad\": { \"x\": \"RightX\", \"y\": \"RightY\" } } }");
    hand(b: s, s: pad(slot: 0, control: 0, value: 1.0, at: 5));
    hand(b: s, s: stick(slot: 0, index: 2, value: 1.0, at: 10));
    expectVec2(t: t, name: "binder: a stick held in a delta turns its value times the step's seconds", got: lookAt(b: s, step: 0, until: 100),
               x: dt, y: 0.0);
    expectVec2(t: t, name: "binder: and as much each step it is held", got: lookAt(b: s, step: 1, until: 200), x: dt, y: 0.0);
    hand(b: s, s: motion(index: 0, value: 3.0, at: 210));
    expectVec2(t: t, name: "binder: a delta sums its devices, the mouse's motion and the stick's", got: lookAt(b: s, step: 2, until: 300),
               x: 3.0 + dt, y: 0.0);
}

// What a value action's binding refuses.
fn void valueRefusalCases(ref Tally t) {
    expectRefused(t: t, name: "binder: a vector2 named by one control is refused: its parts bind it",
                  json: "{ \"move\": { \"keyboard\": \"KeyW\" } }", says: "names a control, and a `Vector2` is bound by its parts");
    expectRefused(t: t, name: "binder: a vector3 too", json: "{ \"fly\": { \"gamepad\": \"LeftX\" } }",
                  says: "a `Vector3` is bound by its parts");
    expectRefused(t: t, name: "binder: keys' parts and axes in one entry are refused",
                  json: "{ \"move\": { \"keyboard\": { \"up\": \"KeyW\", \"x\": \"KeyD\" } } }", says: "names both keys' parts and axes");
    expectRefused(t: t, name: "binder: a misspelled part is refused, naming the kind's parts",
                  json: "{ \"move\": { \"keyboard\": { \"upp\": \"KeyW\" } } }",
                  says: "names `upp`, which is no part of a `Vector2`: its parts are `up`, `down`, `left` and `right`, or `x` and `y`");
    expectRefused(t: t, name: "binder: a vector2 has no forward", json: "{ \"move\": { \"keyboard\": { \"forward\": \"KeyW\" } } }",
                  says: "names `forward`, which is no part of a `Vector2`");
    expectRefused(t: t, name: "binder: an analog's parts are positive and negative",
                  json: "{ \"throttle\": { \"keyboard\": { \"up\": \"KeyW\" } } }", says: "no part of a `Analog`: its parts are `positive` and `negative`");
    expectRefused(t: t, name: "binder: an object naming no part is refused", json: "{ \"move\": { \"keyboard\": { } } }",
                  says: "is an object naming no part");
    expectRefused(t: t, name: "binder: the mouse's motion on a state is refused: it is a distance moved",
                  json: "{ \"move\": { \"mouse\": \"Motion\" } }", says: "so `move` must be a delta");
    expectRefused(t: t, name: "binder: the mouse's motion mixed with a button held is refused",
                  json: "{ \"look\": { \"mouse\": { \"x\": \"MotionX\", \"y\": \"Left\" } } }", says: "mixes the mouse's motion");
    expectRefused(t: t, name: "binder: the mouse's motion as a key's part is refused",
                  json: "{ \"look\": { \"mouse\": { \"up\": \"MotionY\" } } }", says: "as a key's part");
    expectRefused(t: t, name: "binder: filters are refused until KYR-54's later parts",
                  json: "{ \"move\": { \"gamepad\": { \"x\": \"LeftX\", \"filters\": [ { \"radialDeadZone\": 0.2 } ] } } }",
                  says: "names filters or gestures");
    expectRefused(t: t, name: "binder: a misspelled pad control lists the buttons and the axes",
                  json: "{ \"move\": { \"gamepad\": { \"x\": \"LeftStickX\" } } }", says: "no button (");
    expectRefused(t: t, name: "binder: and the axes' names", json: "{ \"move\": { \"gamepad\": { \"x\": \"LeftStickX\" } } }",
                  says: "and no stick's axis (");
    expectRefused(t: t, name: "binder: a misspelled mouse control names the motion's names too",
                  json: "{ \"look\": { \"mouse\": { \"x\": \"MotionZ\" } } }", says: "nor the mouse's motion, `MotionX` or `MotionY`");
    expectRefused(t: t, name: "binder: a pose is bound by nothing until XR", json: "{ \"hand\": { \"keyboard\": \"KeyW\" } }",
                  says: "bind a `Pose` action, which no device binds until XR brings one");
    expectRefused(t: t, name: "binder: a digital's object entry is its filters and gestures, refused until their part",
                  json: "{ \"faster\": { \"keyboard\": { \"up\": \"KeyW\" } } }", says: "which for a `Digital` holds filters and gestures");
    string many = refusalOf(json: "{ \"move\": { \"keyboard\": \"KeyW\" }, \"fly\": { \"keyboard\": \"KeyW\" } }");
    t.verdict(name: "binder: every refusal at once", why: many.contains(substring: "`move`") && many.contains(substring: "`fly`")
              ? "" : "refused `${many}`");
}

// Player 1's scheme in step `step`'s hand-off up to `until`, as a word.
fn string schemeAt(ref Binder b, int64 step, int64 until) {
    Scheme s = b.handoff(index: step, until: until).scheme(player: 1);
    return match (s) { case KeyboardMouse: "KeyboardMouse"; case Gamepad: "Gamepad"; };
}

fn void expectScheme(ref Tally t, ref Binder b, int64 step, int64 until, const ref string name, const ref string want) {
    string got = schemeAt(b: b, step: step, until: until);
    t.verdict(name: name, why: got == want ? "" : "got ${got}, want ${want}");
}

// Player 1's active scheme: the kind of device that last drove them, a stick only past half its travel, the locked pad
// gone back to KeyboardMouse (the second part's question 1).
fn void schemeCases(ref Tally t) {
    Binder b = binderFor(json: "{ \"faster\": { \"keyboard\": \"ArrowUp\" } }");
    expectScheme(t: t, b: b, step: 0, until: 100, name: "binder: player 1 starts on KeyboardMouse", want: "KeyboardMouse");
    hand(b: b, s: pad(slot: 0, control: 0, value: 1.0, at: 110));
    expectScheme(t: t, b: b, step: 1, until: 200, name: "binder: a pad's press, taking the lock, is Gamepad", want: "Gamepad");
    hand(b: b, s: key(control: 4, down: true, at: 210));
    expectScheme(t: t, b: b, step: 2, until: 300, name: "binder: a key pressed, any key, is KeyboardMouse again", want: "KeyboardMouse");
    hand(b: b, s: key(control: 4, down: false, at: 310));
    hand(b: b, s: stick(slot: 0, index: 0, value: 0.3, at: 320));
    expectScheme(t: t, b: b, step: 3, until: 400, name: "binder: a stick short of half its travel, a drift, switches nothing", want: "KeyboardMouse");
    hand(b: b, s: stick(slot: 0, index: 1, value: -0.6, at: 410));
    expectScheme(t: t, b: b, step: 4, until: 500, name: "binder: a stick past half its travel is Gamepad", want: "Gamepad");
    hand(b: b, s: motion(index: 0, value: 2.0, at: 510));
    expectScheme(t: t, b: b, step: 5, until: 600, name: "binder: the mouse moved is KeyboardMouse", want: "KeyboardMouse");
    hand(b: b, s: travel(slot: 0, button: 7, value: 0.1, at: 610));
    expectScheme(t: t, b: b, step: 6, until: 700, name: "binder: a trigger short of PressedAt switches nothing", want: "KeyboardMouse");
    hand(b: b, s: travel(slot: 0, button: 7, value: 0.5, at: 710));
    expectScheme(t: t, b: b, step: 7, until: 800, name: "binder: a trigger past PressedAt is Gamepad", want: "Gamepad");
    hand(b: b, s: Sample.make(device: Device::Mouse, slot: 0, control: 0, value: 1.0, at: 810));
    expectScheme(t: t, b: b, step: 8, until: 900, name: "binder: a mouse button pressed is KeyboardMouse", want: "KeyboardMouse");
    hand(b: b, s: pad(slot: 1, control: 0, value: 1.0, at: 910));
    hand(b: b, s: stick(slot: 1, index: 0, value: 1.0, at: 920));
    expectScheme(t: t, b: b, step: 9, until: 1000, name: "binder: another pad, not locked, switches nothing", want: "KeyboardMouse");
    hand(b: b, s: pad(slot: 0, control: 1, value: 1.0, at: 1010));
    expectScheme(t: t, b: b, step: 10, until: 1100, name: "binder: the locked pad's press again", want: "Gamepad");
    hand(b: b, s: Sample.padDisconnected(slot: 0, at: 1110));
    expectScheme(t: t, b: b, step: 11, until: 1200, name: "binder: the locked pad gone, KeyboardMouse", want: "KeyboardMouse");
    hand(b: b, s: pad(slot: 1, control: 0, value: 0.0, at: 1210));
    expectScheme(t: t, b: b, step: 12, until: 1300, name: "binder: a pad's release takes no lock and switches nothing", want: "KeyboardMouse");
}

fn void binderTests(ref Tally t) {
    schemeCases(t: t);
    bindingCases(t: t);
    partCases(t: t);
    travelCases(t: t);
    deltaCases(t: t);
    valueRefusalCases(t: t);
    edgeCases(t: t);
    padCases(t: t);
    playerCases(t: t);
}
