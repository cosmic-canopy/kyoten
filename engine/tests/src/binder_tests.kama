// kyoten::input's binder (the first slice's step 8, KYR-54; design/input.md § Decided): bindings read by
// `@kama/window`'s names and refused at load when they name nothing; each step's hand-off split by the samples' times;
// the decided edges; player 1 on the keyboard and the mouse throughout and the first pad pressed, locked until it
// disconnects. Every sample is written by hand, so each case states its time and its wanted value literally: a key by
// its HID usage id (ArrowUp 82, KeyW 26, KeyA 4), a mouse button by the W3C's (Left 0), a pad's button by the
// standard gamepad's index (South 0, RightShoulder 5).

import { Tally, spelled, std::collections::DynamicArray, std::collections::SortedMap, std::memory::Owned,
         std::serialization::text::json::deserializeJsonBuffer,
         kyoten::frame::Digital, kyoten::frame::Sample, kyoten::frame::Device, kyoten::frame::ActionList,
         std::math::Vec2, std::math::Vec3, std::math::sqrt, std::math::exp, kyoten::frame::Time, kyoten::frame::Scheme,
         kyoten::records::BindingRecord, kyoten::records::InputRecord,
         kyoten::input::Binder, kyoten::input::BindingError };

export { binderTests };

comptime int64 EVERYTHING = 9223372036854775807;

fn SortedMap<string, BindingRecord> bindingsOf(const ref string json) {
    Result<SortedMap<string, BindingRecord>, Owned<Error>> read = deserializeJsonBuffer::<SortedMap<string, BindingRecord>>(src: copy json, strict: true);
    return match (give read) {
        case Ok(value: m): give m;
        case Err(error: e): {
            string why = e.message();
            panic(msg: "a test's bindings read: " + why);
        }
    };
}

// The digital actions `a` and `b` (either "" for none), then a value action of each kind: an analog `throttle` (a
// state, analog 0); a vector2 `move` (a state, vector2 0) and `look` (a delta, vector2 1); a vector3 `fly` (a state);
// and a pose `hand`, which no device binds.
fn ActionList actionsOf(const ref string a, const ref string b) {
    ActionList made = ActionList.make();
    if (!a.isEmpty()) { made.addDigital(name: copy a); }
    if (!b.isEmpty()) { made.addDigital(name: copy b); }
    made.addAnalog(name: "throttle", delta: false);
    made.addVector2(name: "move", delta: false);
    made.addVector2(name: "look", delta: true);
    made.addVector3(name: "fly", delta: false);
    made.addPose(name: "hand");
    return made;
}

// A binder for player 1 and the actions `faster` and `jump`, bound by `json`; it must be accepted.
fn Binder binderFor(const ref string json) {
    ActionList actions = actionsOf(a: "faster", b: "jump");
    SortedMap<string, BindingRecord> b = bindingsOf(json: json);
    InputRecord raw = InputRecord.make();
    Result<Binder, BindingError> made = Binder.make(players: 1, actions: actions, bindings: b, input: raw, hz: 60);
    return match (give made) {
        case Ok(value: v): give v;
        case Err(error: e): {
            string why = e.message();
            panic(msg: "a test's bindings refused: " + why);
        }
    };
}

// The refusal `json` gets, or "" when it is accepted.
fn string refusalOf(const ref string json) {
    ActionList actions = actionsOf(a: "faster", b: "jump");
    SortedMap<string, BindingRecord> b = bindingsOf(json: json);
    InputRecord raw = InputRecord.make();
    Result<Binder, BindingError> made = Binder.make(players: 1, actions: actions, bindings: b, input: raw, hz: 60);
    return match (made) {
        case Ok(value: v): "";
        case Err(error: e): e.message();
    };
}

fn void hand(ref Binder b, Sample s) {
    DynamicArray<Sample> one = DynamicArray.empty();
    one.add(item: s);
    b.take(samples: one);
}

fn Sample key(int32 control, bool down, int64 at) {
    return Sample.make(device: Device::Keyboard, slot: 0, control: control, value: down ? 1.0 : 0.0, at: at);
}

fn Sample pad(int32 slot, int32 control, float32 value, int64 at) {
    return Sample.make(device: Device::Gamepad, slot: slot, control: control, value: value, at: at);
}

// Action `action`'s value in the hand-off of step `step` up to `until`, spelled.
fn string stepped(ref Binder b, int64 step, int64 until, int32 action) {
    Digital d = b.handoff(index: step, until: until).digital(player: 1, action: action);
    return spelled(d: d);
}

fn void expectStep(ref Tally t, ref Binder b, int64 step, int64 until, const ref string name, const ref string want) {
    string got = stepped(b: b, step: step, until: until, action: 0);
    t.verdict(name: name, why: got == want ? "" : "got ${got}, want ${want}");
}

fn void expectRefused(ref Tally t, const ref string name, const ref string json, const ref string says) {
    string why = refusalOf(json: json);
    if (why.contains(substring: says)) { t.verdict(name: name, why: ""); }
    else { t.verdict(name: name, why: "refusal `${why}` does not say `${says}`"); }
}

fn void bindingCases(ref Tally t) {
    Binder b = binderFor(json: "{ \"faster\": { \"keyboard\": \"ArrowUp\", \"gamepad\": \"RightShoulder\" } }");
    bool two = b.boundCount(action: 0) == 2 && b.boundCount(action: 1) == 0 && b.digitalActions() == 2;
    t.verdict(name: "binder: a control on each of two devices binds two, an unbound action none", why: two ? "" : "other counts");
    Binder l = binderFor(json: "{ \"faster\": { \"keyboard\": [\"ArrowUp\", \"KeyW\"], \"mouse\": \"Left\" } }");
    isize listed = l.boundCount(action: 0);
    t.verdict(name: "binder: a list binds each control, and the mouse its own", why: listed == 3 ? "" : "${listed} bound");
    string ok = refusalOf(json: "{ \"faster\": { \"keyboard\": \"ArrowUp\" }, \"jump\": { \"gamepad\": \"South\" } }");
    t.verdict(name: "binder: bindings naming the game's actions by their controls' names are accepted", why: ok);
    string trigger = refusalOf(json: "{ \"throttle\": { \"gamepad\": \"RightTrigger\" } }");
    t.verdict(name: "binder: an analog on a trigger is accepted, its travel read", why: trigger);
    string notNamed = refusalOf(json: "{ \"look\": { \"mouse\": \"Motion\" } }");
    t.verdict(name: "binder: a value action is an action the game declares, not one it names nowhere",
              why: notNamed.contains(substring: "name no action") ? "`look` called no action" : "");
    int32 analogs = b.handoff(index: 9, until: 900).analogActions();
    int32 vector2s = b.handoff(index: 9, until: 900).vector2Actions();
    float32 throttle = b.handoff(index: 9, until: 900).analog(player: 1, action: 0);
    Vec2 look = b.handoff(index: 9, until: 900).vector2(player: 1, action: 0);
    bool rested = analogs == 1 && vector2s == 2 && throttle == 0.0 && look.x == 0.0 && look.y == 0.0;
    t.verdict(name: "binder: its hand-off has room for every kind, each value at rest", why: rested ? "" : "other sizes or values");
    isize none = b.valueEntries();
    t.verdict(name: "binder: a value action bound by no entry reads none", why: none == 0 ? "" : "${none} entries");

    expectRefused(t: t, name: "binder: a binding naming no action is refused, by its name",
                  json: "{ \"dash\": { \"keyboard\": \"Space\" } }", says: "the bindings of `dash` name no action");
    expectRefused(t: t, name: "binder: a misspelled key is refused, naming it",
                  json: "{ \"faster\": { \"keyboard\": \"Arrowup\" } }", says: "names `Arrowup`, which is no keyboard control");
    expectRefused(t: t, name: "binder: and the refusal lists the keys' names",
                  json: "{ \"faster\": { \"keyboard\": \"Arrowup\" } }", says: "ArrowUp");
    expectRefused(t: t, name: "binder: a stick's axis is no gamepad button yet",
                  json: "{ \"faster\": { \"gamepad\": \"LeftX\" } }", says: "names `LeftX`, which is no gamepad control");
    expectRefused(t: t, name: "binder: a misspelling in a list is refused",
                  json: "{ \"faster\": { \"keyboard\": [\"ArrowUp\", \"KeyQQ\"] } }", says: "names `KeyQQ`");
    expectRefused(t: t, name: "binder: a key's name on the mouse is refused",
                  json: "{ \"faster\": { \"mouse\": \"ArrowUp\" } }", says: "which is no mouse control");
    expectRefused(t: t, name: "binder: an entry naming gestures is refused until their part reads them",
                  json: "{ \"faster\": { \"keyboard\": { \"control\": \"Space\", \"gestures\": [] } } }",
                  says: "the keyboard binding of `faster` names gestures, which KYR-54's later part reads");
    string both = refusalOf(json: "{ \"dash\": { \"keyboard\": \"Space\" }, \"faster\": { \"keyboard\": \"Arrowup\" } }");
    bool all = both.contains(substring: "`dash`") && both.contains(substring: "`Arrowup`");
    t.verdict(name: "binder: every refusal is said at once", why: all ? "" : "only `${both}`");
}

fn void edgeCases(ref Tally t) {
    string json = "{ \"faster\": { \"keyboard\": [\"ArrowUp\", \"KeyW\"], \"gamepad\": \"RightShoulder\", \"mouse\": \"Left\" }, \"jump\": { \"keyboard\": \"KeyA\" } }";
    Binder b = binderFor(json: json);
    expectStep(t: t, b: b, step: 0, until: 100, name: "binder: off before any sample", want: "---");

    hand(b: b, s: key(control: 82, down: true, at: 150));
    expectStep(t: t, b: b, step: 1, until: 200, name: "binder: a press in the step's window is pressed and held", want: "HP-");
    expectStep(t: t, b: b, step: 2, until: 300, name: "binder: the next step, held alone", want: "H--");
    hand(b: b, s: key(control: 82, down: false, at: 350));
    expectStep(t: t, b: b, step: 3, until: 400, name: "binder: a release is released, not held", want: "--R");
    expectStep(t: t, b: b, step: 4, until: 500, name: "binder: then off", want: "---");

    // Split by time: a press after the step's end waits for the step whose window holds it.
    hand(b: b, s: key(control: 82, down: true, at: 650));
    expectStep(t: t, b: b, step: 5, until: 600, name: "binder: a sample after the step's end is not the step's", want: "---");
    expectStep(t: t, b: b, step: 6, until: 700, name: "binder: it is the next step's", want: "HP-");
    hand(b: b, s: key(control: 82, down: false, at: 750));

    // A tap inside one step: the press, held, then the release on the next step.
    hand(b: b, s: key(control: 82, down: true, at: 810));
    hand(b: b, s: key(control: 82, down: false, at: 820));
    expectStep(t: t, b: b, step: 7, until: 900, name: "binder: a tap inside one step shows the press, held",
               want: "HP-");
    expectStep(t: t, b: b, step: 8, until: 1000, name: "binder: and its release on the next step", want: "--R");
    expectStep(t: t, b: b, step: 9, until: 1100, name: "binder: then off", want: "---");

    // A release then a press inside one step: both edges, held.
    hand(b: b, s: key(control: 82, down: true, at: 1150));
    expectStep(t: t, b: b, step: 10, until: 1200, name: "binder: held", want: "HP-");
    hand(b: b, s: key(control: 82, down: false, at: 1210));
    hand(b: b, s: key(control: 82, down: true, at: 1220));
    expectStep(t: t, b: b, step: 11, until: 1300, name: "binder: a release and a press in one step show both, held", want: "HPR");
    hand(b: b, s: key(control: 82, down: false, at: 1350));
    expectStep(t: t, b: b, step: 12, until: 1400, name: "binder: released", want: "--R");

    // Two controls of one action: held while either is, its edges those of both together.
    hand(b: b, s: key(control: 82, down: true, at: 1450));
    expectStep(t: t, b: b, step: 13, until: 1500, name: "binder: the first of two controls presses", want: "HP-");
    hand(b: b, s: key(control: 26, down: true, at: 1550));
    expectStep(t: t, b: b, step: 14, until: 1600, name: "binder: the second, while the first is held, presses nothing", want: "H--");
    hand(b: b, s: key(control: 82, down: false, at: 1650));
    expectStep(t: t, b: b, step: 15, until: 1700, name: "binder: the first let go, while the second is held, releases nothing",
               want: "H--");
    hand(b: b, s: key(control: 82, down: true, at: 1750));
    expectStep(t: t, b: b, step: 16, until: 1800, name: "binder: a key's repeat, a down while held, presses nothing", want: "H--");
    hand(b: b, s: key(control: 82, down: false, at: 1850));
    hand(b: b, s: key(control: 26, down: false, at: 1860));
    expectStep(t: t, b: b, step: 17, until: 1900, name: "binder: both let go release it", want: "--R");

    // Another action, and another device.
    hand(b: b, s: key(control: 4, down: true, at: 1950));
    string jumpFaster = stepped(b: b, step: 18, until: 2000, action: 0);
    string jump = stepped(b: b, step: 19, until: 2000, action: 1);
    t.verdict(name: "binder: a key of another action moves that action alone",
              why: jumpFaster == "---" && jump == "H--" ? "" : "faster ${jumpFaster}, jump ${jump}");
    hand(b: b, s: key(control: 4, down: false, at: 2050));
    hand(b: b, s: Sample.make(device: Device::Mouse, slot: 0, control: 0, value: 1.0, at: 2150));
    expectStep(t: t, b: b, step: 20, until: 2200, name: "binder: the mouse's Left presses what it is bound to", want: "HP-");
    hand(b: b, s: Sample.make(device: Device::Mouse, slot: 0, control: 0, value: 0.0, at: 2250));
    hand(b: b, s: key(control: 0, down: true, at: 2260));
    expectStep(t: t, b: b, step: 21, until: 2300, name: "binder: a keyboard control with the mouse button's number is not it",
               want: "--R");

    // The last owed step takes everything that arrived.
    hand(b: b, s: key(control: 82, down: true, at: 900000));
    expectStep(t: t, b: b, step: 22, until: EVERYTHING, name: "binder: the frame's last step takes everything that arrived",
               want: "HP-");
    hand(b: b, s: key(control: 82, down: false, at: 900001));
    expectStep(t: t, b: b, step: 23, until: EVERYTHING, name: "binder: released", want: "--R");
}

fn void padCases(ref Tally t) {
    Binder b = binderFor(json: "{ \"faster\": { \"keyboard\": \"ArrowUp\", \"gamepad\": \"RightShoulder\" } }");
    t.verdict(name: "binder: no pad is locked before one is pressed", why: b.lockedPad().isNone() ? "" : "one is");
    hand(b: b, s: Sample.padConnected(slot: 2, at: 10));
    expectStep(t: t, b: b, step: 0, until: 100, name: "binder: a pad's connection presses nothing", want: "---");
    t.verdict(name: "binder: nor locks it", why: b.lockedPad().isNone() ? "" : "it locked");
    hand(b: b, s: pad(slot: 2, control: 5, value: 0.05, at: 110));
    expectStep(t: t, b: b, step: 1, until: 200, name: "binder: a button under PressedAt of its travel presses nothing", want: "---");
    t.verdict(name: "binder: nor locks its pad", why: b.lockedPad().isNone() ? "" : "it locked");

    hand(b: b, s: pad(slot: 2, control: 5, value: 1.0, at: 210));
    expectStep(t: t, b: b, step: 2, until: 300, name: "binder: the first pad pressed drives player 1", want: "HP-");
    bool locked2 = match (b.lockedPad()) { case Some(value: s): s == 2; case None: false; };
    t.verdict(name: "binder: and locks in", why: locked2 ? "" : "not slot 2");
    hand(b: b, s: pad(slot: 2, control: 5, value: 0.0, at: 310));
    expectStep(t: t, b: b, step: 3, until: 400, name: "binder: its release", want: "--R");
    hand(b: b, s: pad(slot: 0, control: 5, value: 1.0, at: 410));
    expectStep(t: t, b: b, step: 4, until: 500, name: "binder: another pad does nothing while one is locked", want: "---");
    hand(b: b, s: pad(slot: 0, control: 5, value: 0.0, at: 510));
    hand(b: b, s: key(control: 82, down: true, at: 520));
    expectStep(t: t, b: b, step: 5, until: 600, name: "binder: the keyboard drives player 1 while a pad is locked", want: "HP-");
    hand(b: b, s: key(control: 82, down: false, at: 610));
    expectStep(t: t, b: b, step: 6, until: 700, name: "binder: released", want: "--R");

    // The locked pad held, then disconnected: its lock goes, and what it held is let go at that moment.
    hand(b: b, s: pad(slot: 2, control: 5, value: 1.0, at: 710));
    expectStep(t: t, b: b, step: 7, until: 800, name: "binder: the locked pad presses again", want: "HP-");
    hand(b: b, s: Sample.padDisconnected(slot: 0, at: 810));
    expectStep(t: t, b: b, step: 8, until: 900, name: "binder: another pad's disconnection changes nothing", want: "H--");
    hand(b: b, s: Sample.padDisconnected(slot: 2, at: 910));
    expectStep(t: t, b: b, step: 9, until: 1000, name: "binder: the locked pad's disconnection releases what it held", want: "--R");
    t.verdict(name: "binder: and lets the lock go", why: b.lockedPad().isNone() ? "" : "still locked");
    hand(b: b, s: pad(slot: 0, control: 0, value: 1.0, at: 1010));
    expectStep(t: t, b: b, step: 10, until: 1100, name: "binder: an unbound button presses nothing", want: "---");
    bool locked0 = match (b.lockedPad()) { case Some(value: s): s == 0; case None: false; };
    t.verdict(name: "binder: but any button pressed takes the lock, the next pad's", why: locked0 ? "" : "not slot 0");
    hand(b: b, s: pad(slot: 0, control: 0, value: 0.0, at: 1110));
    hand(b: b, s: pad(slot: 0, control: 5, value: 1.0, at: 1120));
    expectStep(t: t, b: b, step: 11, until: 1200, name: "binder: and drives player 1", want: "HP-");
}

fn void playerCases(ref Tally t) {
    ActionList actions = actionsOf(a: "faster", b: "");
    SortedMap<string, BindingRecord> map = bindingsOf(json: "{ \"faster\": { \"keyboard\": \"ArrowUp\" } }");
    InputRecord raw = InputRecord.make();
    Result<Binder, BindingError> made = Binder.make(players: 2, actions: actions, bindings: map, input: raw, hz: 60);
    match (give made) {
        case Ok(value: b): {
            hand(b: b, s: key(control: 82, down: true, at: 50));
            string one = spelled(d: b.handoff(index: 0, until: 100).digital(player: 1, action: 0));
            string two = spelled(d: b.handoff(index: 1, until: 100).digital(player: 2, action: 0));
            bool sized = b.players() == 2;
            t.verdict(name: "binder: the keyboard drives player 1 alone, player 2 off",
                      why: one == "HP-" && two == "---" && sized ? "" : "player 1 ${one}, player 2 ${two}");
        }
        case Err(error: e): {
            string why = e.message();
            t.verdict(name: "binder: the keyboard drives player 1 alone, player 2 off", why: why);
        }
    };
}

fn Sample travel(int32 slot, int32 button, float32 value, int64 at) { return Sample.padTravel(slot: slot, button: button, value: value, at: at); }
fn Sample stick(int32 slot, int32 index, float32 value, int64 at) { return Sample.padAxis(slot: slot, index: index, value: value, at: at); }
fn Sample motion(int32 index, float32 value, int64 at) { return Sample.mouseMotion(index: index, value: value, at: at); }

fn void expectFloat(ref Tally t, const ref string name, float32 got, float32 want) {
    t.verdict(name: name, why: got == want ? "" : "got ${got}, want ${want}");
}

fn void expectVec2(ref Tally t, const ref string name, Vec2 got, float32 x, float32 y) {
    float32 gx = got.x;
    float32 gy = got.y;
    t.verdict(name: name, why: gx == x && gy == y ? "" : "got (${gx}, ${gy}), want (${x}, ${y})");
}

fn void expectVec3(ref Tally t, const ref string name, Vec3 got, float32 x, float32 y, float32 z) {
    float32 gx = got.x;
    float32 gy = got.y;
    float32 gz = got.z;
    t.verdict(name: name, why: gx == x && gy == y && gz == z ? "" : "got (${gx}, ${gy}, ${gz}), want (${x}, ${y}, ${z})");
}

// Action `throttle`, `move`, `look` or `fly` in step `step`'s hand-off up to `until`.
fn float32 throttleAt(ref Binder b, int64 step, int64 until) { return b.handoff(index: step, until: until).analog(player: 1, action: 0); }
fn Vec2 moveAt(ref Binder b, int64 step, int64 until) { return b.handoff(index: step, until: until).vector2(player: 1, action: 0); }
fn Vec2 lookAt(ref Binder b, int64 step, int64 until) { return b.handoff(index: step, until: until).vector2(player: 1, action: 1); }
fn Vec3 flyAt(ref Binder b, int64 step, int64 until) { return b.handoff(index: step, until: until).vector3(player: 1, action: 0); }

// A value action's parts make its value (the second part of step 8): an analog's positive less its negative, keys a
// direction no longer than 1, a stick's axes with its Y turned over, up positive.
fn void partCases(ref Tally t) {
    Binder p = binderFor(json: "{ \"throttle\": { \"keyboard\": { \"positive\": \"KeyW\", \"negative\": \"KeyS\" } } }");
    hand(b: p, s: key(control: 26, down: true, at: 10));
    expectFloat(t: t, name: "binder: an analog's positive key reads 1", got: throttleAt(b: p, step: 0, until: 100), want: 1.0);
    hand(b: p, s: key(control: 22, down: true, at: 110));
    expectFloat(t: t, name: "binder: and its negative too, 0", got: throttleAt(b: p, step: 1, until: 200), want: 0.0);
    hand(b: p, s: key(control: 26, down: false, at: 210));
    expectFloat(t: t, name: "binder: its negative alone, -1", got: throttleAt(b: p, step: 2, until: 300), want: -1.0);

    Binder k = binderFor(json: "{ \"move\": { \"keyboard\": { \"up\": [\"KeyW\", \"ArrowUp\"], \"down\": \"KeyS\", \"left\": \"KeyA\", \"right\": \"KeyD\" } } }");
    hand(b: k, s: key(control: 26, down: true, at: 10));
    expectVec2(t: t, name: "binder: a vector2's up key reads up, positive", got: moveAt(b: k, step: 0, until: 100), x: 0.0, y: 1.0);
    hand(b: k, s: key(control: 7, down: true, at: 110));
    float32 two = 2.0;
    float32 diagonal = 1.0 / sqrt(x: two);
    expectVec2(t: t, name: "binder: up and right make a diagonal no longer than 1", got: moveAt(b: k, step: 1, until: 200),
               x: diagonal, y: diagonal);
    hand(b: k, s: key(control: 26, down: false, at: 210));
    hand(b: k, s: key(control: 7, down: false, at: 220));
    hand(b: k, s: key(control: 82, down: true, at: 230));
    expectVec2(t: t, name: "binder: a part's second key reads as its first", got: moveAt(b: k, step: 2, until: 300), x: 0.0, y: 1.0);
    hand(b: k, s: key(control: 22, down: true, at: 310));
    expectVec2(t: t, name: "binder: up and down cancel", got: moveAt(b: k, step: 3, until: 400), x: 0.0, y: 0.0);

    Binder a = binderFor(json: "{ \"move\": { \"gamepad\": { \"x\": \"LeftX\", \"y\": \"LeftY\" } } }");
    hand(b: a, s: pad(slot: 0, control: 0, value: 1.0, at: 5));
    hand(b: a, s: stick(slot: 0, index: 0, value: 0.5, at: 10));
    hand(b: a, s: stick(slot: 0, index: 1, value: 0.25, at: 20));
    expectVec2(t: t, name: "binder: a stick's axes read as they are, its Y turned over so up is positive",
               got: moveAt(b: a, step: 0, until: 100), x: 0.5, y: -0.25);
    hand(b: a, s: stick(slot: 1, index: 0, value: -1.0, at: 110));
    expectVec2(t: t, name: "binder: another pad's stick moves nothing while one is locked", got: moveAt(b: a, step: 1, until: 200),
               x: 0.5, y: -0.25);
    hand(b: a, s: Sample.padDisconnected(slot: 0, at: 210));
    expectVec2(t: t, name: "binder: the locked pad's disconnection sets its sticks at rest", got: moveAt(b: a, step: 2, until: 300),
               x: 0.0, y: 0.0);

    Binder f = binderFor(json: "{ \"fly\": { \"keyboard\": { \"forward\": \"KeyW\", \"up\": \"Space\" } } }");
    hand(b: f, s: key(control: 26, down: true, at: 10));
    expectVec3(t: t, name: "binder: a vector3's forward is -Z", got: flyAt(b: f, step: 0, until: 100), x: 0.0, y: 0.0, z: -1.0);
    hand(b: f, s: key(control: 44, down: true, at: 110));
    expectVec3(t: t, name: "binder: forward and up, a diagonal no longer than 1", got: flyAt(b: f, step: 1, until: 200), x: 0.0,
               y: diagonal, z: -diagonal);
}

// A trigger's travel, the lock, and which of an action's devices drives a state.
fn void travelCases(ref Tally t) {
    Binder b = binderFor(json: "{ \"throttle\": { \"keyboard\": { \"positive\": \"KeyW\" }, \"gamepad\": \"RightTrigger\" } }");
    hand(b: b, s: travel(slot: 2, button: 7, value: 0.5, at: 10));
    expectFloat(t: t, name: "binder: a trigger's travel with no pad locked moves nothing", got: throttleAt(b: b, step: 0, until: 100),
                want: 0.0);
    bool none = match (b.lockedPad()) { case Some(value: s): false; case None: true; };
    t.verdict(name: "binder: and takes no lock: a travel is no press", why: none ? "" : "a pad took the lock");
    hand(b: b, s: pad(slot: 0, control: 0, value: 1.0, at: 110));
    hand(b: b, s: travel(slot: 0, button: 7, value: 0.25, at: 120));
    expectFloat(t: t, name: "binder: the locked pad's trigger reads its travel", got: throttleAt(b: b, step: 1, until: 200), want: 0.25);
    hand(b: b, s: travel(slot: 2, button: 7, value: 0.9, at: 210));
    expectFloat(t: t, name: "binder: another pad's trigger moves nothing", got: throttleAt(b: b, step: 2, until: 300), want: 0.25);
    hand(b: b, s: key(control: 26, down: true, at: 310));
    expectFloat(t: t, name: "binder: a state reads its most actuated device, a key held over a trigger's quarter",
                got: throttleAt(b: b, step: 3, until: 400), want: 1.0);
    hand(b: b, s: key(control: 26, down: false, at: 410));
    expectFloat(t: t, name: "binder: and the trigger again once the key is up", got: throttleAt(b: b, step: 4, until: 500), want: 0.25);
    hand(b: b, s: Sample.padDisconnected(slot: 0, at: 510));
    expectFloat(t: t, name: "binder: the locked pad gone, its trigger at rest", got: throttleAt(b: b, step: 5, until: 600), want: 0.0);
}

// A delta: the mouse's motion that landed in each step, split by time, its Y turned over; a stick held, times the
// step's seconds; both devices summed.
fn void deltaCases(ref Tally t) {
    Binder m = binderFor(json: "{ \"look\": { \"mouse\": \"Motion\" } }");
    hand(b: m, s: motion(index: 0, value: 3.0, at: 10));
    hand(b: m, s: motion(index: 1, value: 2.0, at: 20));
    hand(b: m, s: motion(index: 0, value: 1.0, at: 150));
    hand(b: m, s: motion(index: 0, value: 2.0, at: 250));
    expectVec2(t: t, name: "binder: the mouse's motion in a step, its Y down the window turned over",
               got: lookAt(b: m, step: 0, until: 100), x: 3.0, y: -2.0);
    expectVec2(t: t, name: "binder: the next step's its own, split by time", got: lookAt(b: m, step: 1, until: 200), x: 1.0, y: 0.0);
    expectVec2(t: t, name: "binder: and the last step everything after", got: lookAt(b: m, step: 2, until: 300), x: 2.0, y: 0.0);
    expectVec2(t: t, name: "binder: a step with no motion moves nothing", got: lookAt(b: m, step: 3, until: 400), x: 0.0, y: 0.0);

    float32 dt = Time::dtAt(hz: 60);
    Binder s = binderFor(json: "{ \"look\": { \"mouse\": \"Motion\", \"gamepad\": { \"x\": \"RightX\", \"y\": \"RightY\" } } }");
    hand(b: s, s: pad(slot: 0, control: 0, value: 1.0, at: 5));
    hand(b: s, s: stick(slot: 0, index: 2, value: 1.0, at: 10));
    expectVec2(t: t, name: "binder: a stick held in a delta turns its value times the step's seconds", got: lookAt(b: s, step: 0, until: 100),
               x: dt, y: 0.0);
    expectVec2(t: t, name: "binder: and as much each step it is held", got: lookAt(b: s, step: 1, until: 200), x: dt, y: 0.0);
    hand(b: s, s: motion(index: 0, value: 3.0, at: 210));
    expectVec2(t: t, name: "binder: a delta sums its devices, the mouse's motion and the stick's", got: lookAt(b: s, step: 2, until: 300),
               x: 3.0 + dt, y: 0.0);
}

// What a value action's binding refuses.
fn void valueRefusalCases(ref Tally t) {
    expectRefused(t: t, name: "binder: a vector2 named by one control is refused: its parts bind it",
                  json: "{ \"move\": { \"keyboard\": \"KeyW\" } }", says: "names a control, and a `Vector2` is bound by its parts");
    expectRefused(t: t, name: "binder: a vector3 too", json: "{ \"fly\": { \"gamepad\": \"LeftX\" } }",
                  says: "a `Vector3` is bound by its parts");
    expectRefused(t: t, name: "binder: keys' parts and axes in one entry are refused",
                  json: "{ \"move\": { \"keyboard\": { \"up\": \"KeyW\", \"x\": \"KeyD\" } } }", says: "names both keys' parts and axes");
    expectRefused(t: t, name: "binder: a misspelled part is refused, naming the kind's parts",
                  json: "{ \"move\": { \"keyboard\": { \"upp\": \"KeyW\" } } }",
                  says: "names `upp`, which is no part of a `Vector2`: its parts are `up`, `down`, `left` and `right`, or `x` and `y`");
    expectRefused(t: t, name: "binder: a vector2 has no forward", json: "{ \"move\": { \"keyboard\": { \"forward\": \"KeyW\" } } }",
                  says: "names `forward`, which is no part of a `Vector2`");
    expectRefused(t: t, name: "binder: an analog's parts are positive and negative",
                  json: "{ \"throttle\": { \"keyboard\": { \"up\": \"KeyW\" } } }", says: "no part of a `Analog`: its parts are `positive` and `negative`");
    expectRefused(t: t, name: "binder: an object naming no part is refused", json: "{ \"move\": { \"keyboard\": { } } }",
                  says: "is an object naming no part");
    expectRefused(t: t, name: "binder: the mouse's motion on a state is refused: it is a distance moved",
                  json: "{ \"move\": { \"mouse\": \"Motion\" } }", says: "so `move` must be a delta");
    expectRefused(t: t, name: "binder: the mouse's motion mixed with a button held is refused",
                  json: "{ \"look\": { \"mouse\": { \"x\": \"MotionX\", \"y\": \"Left\" } } }", says: "mixes the mouse's motion");
    expectRefused(t: t, name: "binder: the mouse's motion as a key's part is refused",
                  json: "{ \"look\": { \"mouse\": { \"up\": \"MotionY\" } } }", says: "as a key's part");
    expectRefused(t: t, name: "binder: gestures are refused until KYR-54's later part",
                  json: "{ \"move\": { \"gamepad\": { \"x\": \"LeftX\", \"gestures\": [ { \"multiTap\": 2 } ] } } }",
                  says: "names gestures");
    expectRefused(t: t, name: "binder: a misspelled pad control lists the buttons and the axes",
                  json: "{ \"move\": { \"gamepad\": { \"x\": \"LeftStickX\" } } }", says: "no button (");
    expectRefused(t: t, name: "binder: and the axes' names", json: "{ \"move\": { \"gamepad\": { \"x\": \"LeftStickX\" } } }",
                  says: "and no stick's axis (");
    expectRefused(t: t, name: "binder: a misspelled mouse control names the motion's names too",
                  json: "{ \"look\": { \"mouse\": { \"x\": \"MotionZ\" } } }", says: "nor the mouse's motion, `MotionX` or `MotionY`");
    expectRefused(t: t, name: "binder: a pose is bound by nothing until XR", json: "{ \"hand\": { \"keyboard\": \"KeyW\" } }",
                  says: "bind a `Pose` action, which no device binds until XR brings one");
    expectRefused(t: t, name: "binder: a digital's object entry names its controls under `control`, no other part",
                  json: "{ \"faster\": { \"keyboard\": { \"up\": \"KeyW\" } } }",
                  says: "names `up`, which is no part of a `Digital`'s entry: its controls go under `control`, a name or a list");
    string many = refusalOf(json: "{ \"move\": { \"keyboard\": \"KeyW\" }, \"fly\": { \"keyboard\": \"KeyW\" } }");
    t.verdict(name: "binder: every refusal at once", why: many.contains(substring: "`move`") && many.contains(substring: "`fly`")
              ? "" : "refused `${many}`");
}

// Player 1's scheme in step `step`'s hand-off up to `until`, as a word.
fn string schemeAt(ref Binder b, int64 step, int64 until) {
    Scheme s = b.handoff(index: step, until: until).scheme(player: 1);
    return match (s) { case KeyboardMouse: "KeyboardMouse"; case Gamepad: "Gamepad"; };
}

fn void expectScheme(ref Tally t, ref Binder b, int64 step, int64 until, const ref string name, const ref string want) {
    string got = schemeAt(b: b, step: step, until: until);
    t.verdict(name: name, why: got == want ? "" : "got ${got}, want ${want}");
}

// Player 1's active scheme: the kind of device that last drove them, a stick only past half its travel, the locked pad
// gone back to KeyboardMouse (the second part's question 1).
fn void schemeCases(ref Tally t) {
    Binder b = binderFor(json: "{ \"faster\": { \"keyboard\": \"ArrowUp\" } }");
    expectScheme(t: t, b: b, step: 0, until: 100, name: "binder: player 1 starts on KeyboardMouse", want: "KeyboardMouse");
    hand(b: b, s: pad(slot: 0, control: 0, value: 1.0, at: 110));
    expectScheme(t: t, b: b, step: 1, until: 200, name: "binder: a pad's press, taking the lock, is Gamepad", want: "Gamepad");
    hand(b: b, s: key(control: 4, down: true, at: 210));
    expectScheme(t: t, b: b, step: 2, until: 300, name: "binder: a key pressed, any key, is KeyboardMouse again", want: "KeyboardMouse");
    hand(b: b, s: key(control: 4, down: false, at: 310));
    hand(b: b, s: stick(slot: 0, index: 0, value: 0.3, at: 320));
    expectScheme(t: t, b: b, step: 3, until: 400, name: "binder: a stick short of half its travel, a drift, switches nothing", want: "KeyboardMouse");
    hand(b: b, s: stick(slot: 0, index: 1, value: -0.6, at: 410));
    expectScheme(t: t, b: b, step: 4, until: 500, name: "binder: a stick past half its travel is Gamepad", want: "Gamepad");
    hand(b: b, s: motion(index: 0, value: 2.0, at: 510));
    expectScheme(t: t, b: b, step: 5, until: 600, name: "binder: the mouse moved is KeyboardMouse", want: "KeyboardMouse");
    hand(b: b, s: travel(slot: 0, button: 7, value: 0.1, at: 610));
    expectScheme(t: t, b: b, step: 6, until: 700, name: "binder: a trigger short of PressedAt switches nothing", want: "KeyboardMouse");
    hand(b: b, s: travel(slot: 0, button: 7, value: 0.5, at: 710));
    expectScheme(t: t, b: b, step: 7, until: 800, name: "binder: a trigger past PressedAt is Gamepad", want: "Gamepad");
    hand(b: b, s: Sample.make(device: Device::Mouse, slot: 0, control: 0, value: 1.0, at: 810));
    expectScheme(t: t, b: b, step: 8, until: 900, name: "binder: a mouse button pressed is KeyboardMouse", want: "KeyboardMouse");
    hand(b: b, s: pad(slot: 1, control: 0, value: 1.0, at: 910));
    hand(b: b, s: stick(slot: 1, index: 0, value: 1.0, at: 920));
    expectScheme(t: t, b: b, step: 9, until: 1000, name: "binder: another pad, not locked, switches nothing", want: "KeyboardMouse");
    hand(b: b, s: pad(slot: 0, control: 1, value: 1.0, at: 1010));
    expectScheme(t: t, b: b, step: 10, until: 1100, name: "binder: the locked pad's press again", want: "Gamepad");
    hand(b: b, s: Sample.padDisconnected(slot: 0, at: 1110));
    expectScheme(t: t, b: b, step: 11, until: 1200, name: "binder: the locked pad gone, KeyboardMouse", want: "KeyboardMouse");
    hand(b: b, s: pad(slot: 1, control: 0, value: 0.0, at: 1210));
    expectScheme(t: t, b: b, step: 12, until: 1300, name: "binder: a pad's release takes no lock and switches nothing", want: "KeyboardMouse");
}

// Output's newest (frame-phases § Decided: a presentation read takes the newest sample each frame): every sample taken
// so far applied, each state as of the newest, each delta since Output's last frame at the frame's seconds, every
// digital off; and what the next step takes, its edges and its motion, kept for it.
fn void newestCases(ref Tally t) {
    Binder a = binderFor(json: "{ \"faster\": { \"keyboard\": \"ArrowUp\" }, \"throttle\": { \"keyboard\": { \"positive\": \"KeyW\" } } }");
    hand(b: a, s: key(control: 82, down: true, at: 10));
    hand(b: a, s: key(control: 26, down: true, at: 20));
    float32 early = a.newest(seconds: 0.5).analog(player: 1, action: 0);
    expectFloat(t: t, name: "binder: Output's newest reads a state as of the newest sample, before any step takes it",
                got: early, want: 1.0);
    Digital shown = a.newest(seconds: 0.5).digital(player: 1, action: 0);
    t.verdict(name: "binder: and every digital off, since Output reads a digital's edges by steps",
              why: spelled(d: shown) == "---" ? "" : "got " + spelled(d: shown));
    expectStep(t: t, b: a, step: 0, until: 100, name: "binder: a press the newest applied early still lands in the next step",
               want: "HP-");
    expectFloat(t: t, name: "binder: and its state too", got: throttleAt(b: a, step: 1, until: 200), want: 1.0);

    Binder m = binderFor(json: "{ \"look\": { \"mouse\": \"Motion\" } }");
    hand(b: m, s: motion(index: 0, value: 3.0, at: 30));
    Vec2 first = m.newest(seconds: 0.5).vector2(player: 1, action: 1);
    expectVec2(t: t, name: "binder: Output's newest holds the mouse's motion since its last frame", got: first, x: 3.0, y: 0.0);
    Vec2 again = m.newest(seconds: 0.5).vector2(player: 1, action: 1);
    expectVec2(t: t, name: "binder: and none it has shown already", got: again, x: 0.0, y: 0.0);
    hand(b: m, s: motion(index: 0, value: 2.0, at: 40));
    expectVec2(t: t, name: "binder: the next step takes all the motion since the last step, shown or not",
               got: lookAt(b: m, step: 0, until: 100), x: 5.0, y: 0.0);
    Vec2 after = m.newest(seconds: 0.5).vector2(player: 1, action: 1);
    expectVec2(t: t, name: "binder: and Output the motion since its own last frame", got: after, x: 2.0, y: 0.0);

    Binder s = binderFor(json: "{ \"look\": { \"gamepad\": { \"x\": \"RightX\", \"y\": \"RightY\" } } }");
    hand(b: s, s: pad(slot: 0, control: 0, value: 1.0, at: 5));
    hand(b: s, s: stick(slot: 0, index: 2, value: 1.0, at: 10));
    Vec2 turned = s.newest(seconds: 0.5).vector2(player: 1, action: 1);
    expectVec2(t: t, name: "binder: a stick held in a delta turns its value times the frame's seconds for Output", got: turned,
               x: 0.5, y: 0.0);
    Scheme scheme = s.newest(seconds: 0.5).scheme(player: 1);
    bool onPad = match (scheme) { case Gamepad: true; case KeyboardMouse: false; };
    t.verdict(name: "binder: Output's newest carries the player's scheme", why: onPad ? "" : "KeyboardMouse");
}

// What reading `json` as bindings refuses, or "" when it reads: a filter or a parameter misspelt is the reader's.
fn string readRefusalOf(const ref string json) {
    Result<SortedMap<string, BindingRecord>, Owned<Error>> read = deserializeJsonBuffer::<SortedMap<string, BindingRecord>>(src: copy json, strict: true);
    return match (read) {
        case Ok(value: m): "";
        case Err(error: e): e.message();
    };
}

fn void expectReadRefused(ref Tally t, const ref string name, const ref string json, const ref string says) {
    string why = readRefusalOf(json: json);
    if (why.contains(substring: says)) { t.verdict(name: name, why: ""); }
    else { t.verdict(name: name, why: "read refusal `${why}` does not say `${says}`"); }
}

fn float32 absOf(float32 x) { return x < 0.0 ? 0.0 - x : x; }

// Within a millionth: a filter's arithmetic in float32, held to the formula worked here.
fn void expectNear(ref Tally t, const ref string name, float32 got, float32 want) {
    t.verdict(name: name, why: absOf(x: got - want) <= 0.000001 ? "" : "got ${got}, want ${want}");
}

fn void expectVec2Near(ref Tally t, const ref string name, Vec2 got, float32 x, float32 y) {
    float32 gx = got.x;
    float32 gy = got.y;
    bool near = absOf(x: gx - x) <= 0.000001 && absOf(x: gy - y) <= 0.000001;
    t.verdict(name: name, why: near ? "" : "got (${gx}, ${gy}), want (${x}, ${y})");
}

// `move` bound to the left stick through `filters`, its pad locked, then the stick at (`x`, `y`) as the W3C reports
// it (down positive), read in the next step.
fn Vec2 stickThrough(const ref string filters, float32 x, float32 y) {
    Binder b = binderFor(json: "{ \"move\": { \"gamepad\": { \"x\": \"LeftX\", \"y\": \"LeftY\", \"filters\": " + filters + " } } }");
    hand(b: b, s: pad(slot: 0, control: 0, value: 1.0, at: 5));
    hand(b: b, s: stick(slot: 0, index: 0, value: x, at: 10));
    hand(b: b, s: stick(slot: 0, index: 1, value: y, at: 20));
    return moveAt(b: b, step: 0, until: 100);
}

// Each filter's formula, worked at chosen points (design/input.md § Decided, 2026-11-23, the third part).
fn void filterShapeCases(ref Tally t) {
    string zone = "[ { \"deadZone\": { \"lower\": 0.5, \"upper\": 0.9 } } ]";
    expectVec2(t: t, name: "binder: a dead zone zeroes a stick inside it", got: stickThrough(filters: zone, x: 0.3, y: 0.0), x: 0.0, y: 0.0);
    expectVec2Near(t: t, name: "binder: a scaled radial dead zone rescales the length from its lower end to its upper, keeping the direction",
                   got: stickThrough(filters: zone, x: 0.45, y: 0.6), x: 0.375, y: -0.5);
    expectVec2Near(t: t, name: "binder: and past its upper end the stick is a direction of length 1",
                   got: stickThrough(filters: zone, x: 0.57, y: 0.76), x: 0.6, y: -0.8);
    expectVec2Near(t: t, name: "binder: a dead zone's upper end is 1 unless written",
                   got: stickThrough(filters: "[ { \"deadZone\": 0.5 } ]", x: 0.45, y: 0.6), x: 0.3, y: -0.4);
    expectVec2Near(t: t, name: "binder: an axial dead zone takes each axis apart",
                   got: stickThrough(filters: "[ { \"deadZone\": { \"lower\": 0.5, \"shape\": \"Axial\" } } ]", x: 0.75, y: 0.25),
                   x: 0.5, y: 0.0);
    string unscaled = "[ { \"deadZone\": { \"lower\": 0.5, \"upper\": 0.9, \"scaled\": false } } ]";
    expectVec2Near(t: t, name: "binder: an unscaled dead zone keeps what is past its lower end as it is",
                   got: stickThrough(filters: unscaled, x: 0.45, y: 0.6), x: 0.45, y: -0.6);
    expectVec2Near(t: t, name: "binder: and holds its length to its upper end",
                   got: stickThrough(filters: unscaled, x: 0.6, y: 0.8), x: 0.54, y: -0.72);
    expectVec2(t: t, name: "binder: and zeroes inside it", got: stickThrough(filters: unscaled, x: 0.3, y: 0.0), x: 0.0, y: 0.0);
    expectVec2Near(t: t, name: "binder: a dead zone of 0 reads the stick raw",
                   got: stickThrough(filters: "[ { \"deadZone\": 0 } ]", x: 0.05, y: -0.02), x: 0.05, y: 0.02);

    expectVec2Near(t: t, name: "binder: a scale per axis", got: stickThrough(filters: "[ { \"scale\": { \"x\": 2, \"y\": 3 } } ]", x: 0.25, y: 0.5),
                   x: 0.5, y: -1.5);
    expectVec2Near(t: t, name: "binder: one scale for every axis", got: stickThrough(filters: "[ { \"scale\": 4 } ]", x: 0.25, y: 0.125),
                   x: 1.0, y: -0.5);
    expectVec2Near(t: t, name: "binder: invert turns over the axes named",
                   got: stickThrough(filters: "[ { \"invert\": { \"y\": true } } ]", x: 0.25, y: 0.5), x: 0.25, y: 0.5);
    expectVec2Near(t: t, name: "binder: and true turns over every axis", got: stickThrough(filters: "[ { \"invert\": true } ]", x: 0.25, y: 0.5),
                   x: -0.25, y: 0.5);
    expectVec2Near(t: t, name: "binder: a curve raises each axis to its exponent, its sign kept",
                   got: stickThrough(filters: "[ { \"curve\": 2 } ]", x: 0.5, y: 0.5), x: 0.25, y: -0.25);
    expectVec2Near(t: t, name: "binder: an exponent per axis, 1 where unnamed",
                   got: stickThrough(filters: "[ { \"curve\": { \"x\": 3 } } ]", x: 0.5, y: 0.5), x: 0.125, y: -0.5);
    expectVec2Near(t: t, name: "binder: a curve through points, linear between them, its sign kept",
                   got: stickThrough(filters: "[ { \"curve\": { \"points\": [ [0, 0], [0.5, 0.25], [1, 1] ] } } ]", x: 0.75, y: 0.25),
                   x: 0.625, y: -0.125);
    expectVec2Near(t: t, name: "binder: a curve's points hold their last output past them",
                   got: stickThrough(filters: "[ { \"curve\": { \"points\": [ [0, 0], [0.5, 0.25] ] } } ]", x: 0.75, y: 0.0),
                   x: 0.25, y: 0.0);
    expectVec2Near(t: t, name: "binder: a clamp by length", got: stickThrough(filters: "[ { \"clamp\": { \"length\": 0.5 } } ]", x: 0.6, y: 0.8),
                   x: 0.3, y: -0.4);
    expectVec2Near(t: t, name: "binder: a clamp per axis", got: stickThrough(filters: "[ { \"clamp\": { \"min\": -0.5, \"max\": 0.25 } } ]", x: 0.6, y: 0.8),
                   x: 0.25, y: -0.5);
    expectVec2Near(t: t, name: "binder: normalize makes a direction of length 1",
                   got: stickThrough(filters: "[ { \"normalize\": true } ]", x: 0.3, y: 0.4), x: 0.6, y: -0.8);
    expectVec2(t: t, name: "binder: and leaves a stick at rest at rest", got: stickThrough(filters: "[ { \"normalize\": true } ]", x: 0.0, y: 0.0),
               x: 0.0, y: 0.0);
    expectVec2(t: t, name: "binder: digital makes each axis -1, 0 or 1",
               got: stickThrough(filters: "[ { \"digital\": true } ]", x: -0.2, y: 0.7), x: -1.0, y: -1.0);
    expectVec2(t: t, name: "binder: and 0 stays 0", got: stickThrough(filters: "[ { \"digital\": true } ]", x: 0.3, y: 0.0), x: 1.0, y: 0.0);
    float32 half = 1.0 / sqrt(x: 2.0f32);
    expectVec2Near(t: t, name: "binder: a filter reads only the axes its action has: a vector2's remap leaves its z at 0",
                   got: stickThrough(filters: "[ { \"remap\": { \"from\": [0, 1], \"to\": [0.5, 1] } }, { \"normalize\": true } ]", x: 0.0, y: 0.0),
                   x: half, y: half);
    Binder two = binderFor(json: "{ \"throttle\": { \"keyboard\": { \"positive\": \"KeyW\", \"filters\": [ { \"curve\": { \"points\": [ [0, 0], [1, 0.5] ] } } ] }, \"gamepad\": { \"positive\": \"RightTrigger\", \"filters\": [ { \"curve\": { \"points\": [ [0, 0], [1, 0.25] ] } } ] } } }");
    hand(b: two, s: pad(slot: 0, control: 0, value: 1.0, at: 5));
    hand(b: two, s: travel(slot: 0, button: 7, value: 1.0, at: 10));
    expectNear(t: t, name: "binder: each entry reads its own curve's points", got: throttleAt(b: two, step: 0, until: 100), want: 0.25);
    expectVec2Near(t: t, name: "binder: a filter written false does nothing",
                   got: stickThrough(filters: "[ { \"normalize\": false }, { \"digital\": false } ]", x: 0.3, y: 0.4), x: 0.3, y: -0.4);

    Binder r = binderFor(json: "{ \"throttle\": { \"keyboard\": { \"positive\": \"KeyW\", \"filters\": [ { \"remap\": { \"from\": [0, 1], \"to\": [0.25, 0.75] } } ] } } }");
    expectNear(t: t, name: "binder: a remap takes a key up from 0 to its range's start", got: throttleAt(b: r, step: 0, until: 100), want: 0.25);
    hand(b: r, s: key(control: 26, down: true, at: 110));
    expectNear(t: t, name: "binder: and down from 1 to its end: a digital as a float from X to Y", got: throttleAt(b: r, step: 1, until: 200),
               want: 0.75);
}

// The order written, a delta, Output, smoothing over time.
fn void filterOrderCases(ref Tally t) {
    expectVec2Near(t: t, name: "binder: filters run in the order written: a scale, then a dead zone",
                   got: stickThrough(filters: "[ { \"scale\": 2 }, { \"deadZone\": 0.5 } ]", x: 0.4, y: 0.0), x: 0.6, y: 0.0);
    expectVec2(t: t, name: "binder: and a dead zone, then a scale", got: stickThrough(filters: "[ { \"deadZone\": 0.5 }, { \"scale\": 2 } ]", x: 0.4, y: 0.0),
               x: 0.0, y: 0.0);

    float32 dt = Time::dtAt(hz: 60);
    Binder s = binderFor(json: "{ \"look\": { \"gamepad\": { \"x\": \"RightX\", \"y\": \"RightY\", \"filters\": [ { \"scale\": 3 } ] } } }");
    hand(b: s, s: pad(slot: 0, control: 0, value: 1.0, at: 5));
    hand(b: s, s: stick(slot: 0, index: 2, value: 1.0, at: 10));
    expectVec2Near(t: t, name: "binder: a delta's stick is filtered before its seconds: a full push scaled is turned each second",
                   got: lookAt(b: s, step: 0, until: 100), x: 3.0 * dt, y: 0.0);
    Binder z = binderFor(json: "{ \"look\": { \"gamepad\": { \"x\": \"RightX\", \"y\": \"RightY\", \"filters\": [ { \"deadZone\": 0.5 } ] } } }");
    hand(b: z, s: pad(slot: 0, control: 0, value: 1.0, at: 5));
    hand(b: z, s: stick(slot: 0, index: 2, value: 0.8, at: 10));
    expectVec2Near(t: t, name: "binder: and a dead zone on it acts on the push, not on the step's turn",
                   got: lookAt(b: z, step: 0, until: 100), x: 0.6 * dt, y: 0.0);
    Binder m = binderFor(json: "{ \"look\": { \"mouse\": { \"x\": \"MotionX\", \"y\": \"MotionY\", \"filters\": [ { \"scale\": 0.5 }, { \"invert\": { \"y\": true } } ] } } }");
    hand(b: m, s: motion(index: 0, value: 4.0, at: 10));
    hand(b: m, s: motion(index: 1, value: 2.0, at: 20));
    expectVec2Near(t: t, name: "binder: the mouse's motion scaled per count, and its Y turned over again",
                   got: lookAt(b: m, step: 0, until: 100), x: 2.0, y: 1.0);

    Binder o = binderFor(json: "{ \"move\": { \"gamepad\": { \"x\": \"LeftX\", \"y\": \"LeftY\", \"filters\": [ { \"deadZone\": { \"lower\": 0.5, \"upper\": 0.9 } } ] } } }");
    hand(b: o, s: pad(slot: 0, control: 0, value: 1.0, at: 5));
    hand(b: o, s: stick(slot: 0, index: 0, value: 0.45, at: 10));
    hand(b: o, s: stick(slot: 0, index: 1, value: 0.6, at: 20));
    Vec2 shown = o.newest(seconds: 0.5).vector2(player: 1, action: 0);
    expectVec2Near(t: t, name: "binder: Output's newest is filtered too", got: shown, x: 0.375, y: -0.5);

    float32 tau = 0.05;
    float32 step = 1.0 - exp(x: 0.0 - dt / tau);
    Binder k = binderFor(json: "{ \"throttle\": { \"keyboard\": { \"positive\": \"KeyW\", \"filters\": [ { \"smooth\": 0.05 } ] } } }");
    hand(b: k, s: key(control: 26, down: true, at: 10));
    float32 first = step;
    expectNear(t: t, name: "binder: smooth moves a state toward its value by its time's share of a step",
               got: throttleAt(b: k, step: 0, until: 100), want: first);
    float32 frame = 1.0 - exp(x: 0.0 - 0.5 / tau);
    float32 shownSmooth = k.newest(seconds: 0.5).analog(player: 1, action: 0);
    expectNear(t: t, name: "binder: and Output's by its frame's seconds, from its own last value", got: shownSmooth, want: frame);
    float32 second = first + (1.0 - first) * step;
    expectNear(t: t, name: "binder: the next step goes on from the step's own, which Output left alone",
               got: throttleAt(b: k, step: 1, until: 200), want: second);

    Binder w = binderFor(json: "{ \"look\": { \"mouse\": { \"x\": \"MotionX\", \"y\": \"MotionY\", \"filters\": [ { \"smooth\": 0.05 } ] } } }");
    hand(b: w, s: motion(index: 0, value: 3.0, at: 10));
    float32 moved = 3.0 * step;
    expectNear(t: t, name: "binder: smooth on the mouse's motion smooths its speed: a share of the step's motion now",
               got: lookAt(b: w, step: 0, until: 100).x, want: moved);
    expectNear(t: t, name: "binder: and the rest over the steps after", got: lookAt(b: w, step: 1, until: 200).x, want: moved * (1.0 - step));

    Binder v = binderFor(json: "{ \"look\": { \"mouse\": { \"x\": \"MotionX\", \"y\": \"MotionY\", \"filters\": [ { \"smooth\": 0.05 } ] } } }");
    hand(b: v, s: motion(index: 0, value: 3.0, at: 10));
    float32 lengthy = 1.0 - exp(x: 0.0 - 0.5 / tau);
    float32 brief = 1.0 - exp(x: 0.0 - 0.25 / tau);
    float32 speed = 3.0 / 0.5 * lengthy;
    expectNear(t: t, name: "binder: smooth on the mouse's motion in Output's frames: a share of the motion in the first",
               got: v.newest(seconds: 0.5).vector2(player: 1, action: 1).x, want: speed * 0.5);
    expectNear(t: t, name: "binder: and its speed kept, not its distance, in a frame half as long",
               got: v.newest(seconds: 0.25).vector2(player: 1, action: 1).x, want: speed * (1.0 - brief) * 0.25);
    hand(b: v, s: motion(index: 0, value: 2.0, at: 20));
    expectNear(t: t, name: "binder: an Output frame of no time passes the mouse's motion through",
               got: v.newest(seconds: 0.0).vector2(player: 1, action: 1).x, want: 2.0);
}

// What the reader and the binder refuse of filters.
fn void filterRefusalCases(ref Tally t) {
    expectReadRefused(t: t, name: "binder: a misspelt filter is refused by the reader, naming every filter",
                      json: "{ \"move\": { \"gamepad\": { \"x\": \"LeftX\", \"filters\": [ { \"deadzone\": 0.2 } ] } } }",
                      says: "`deadzone` is not a `filter`");
    expectReadRefused(t: t, name: "binder: and lists them", json: "{ \"move\": { \"gamepad\": { \"x\": \"LeftX\", \"filters\": [ { \"deadzone\": 0.2 } ] } } }",
                      says: "`deadZone`, `scale`, `invert`, `curve`, `clamp`, `remap`, `normalize`, `digital`, `smooth` or `threshold`");
    expectReadRefused(t: t, name: "binder: a misspelt parameter is refused, naming where",
                      json: "{ \"move\": { \"gamepad\": { \"x\": \"LeftX\", \"filters\": [ { \"deadZone\": { \"lowr\": 0.2 } } ] } } }",
                      says: "filters[0].deadZone.lowr");
    expectReadRefused(t: t, name: "binder: a dead zone's shape misspelt names the shapes",
                      json: "{ \"move\": { \"gamepad\": { \"x\": \"LeftX\", \"filters\": [ { \"deadZone\": { \"shape\": \"Round\" } } ] } } }",
                      says: "`Round` is not a `DeadZoneShape`");
    expectReadRefused(t: t, name: "binder: a filter's value of the wrong kind is refused, naming where",
                      json: "{ \"move\": { \"gamepad\": { \"x\": \"LeftX\", \"filters\": [ { \"scale\": \"big\" } ] } } }",
                      says: "type mismatch at `move.gamepad.filters[0].scale`");
    expectReadRefused(t: t, name: "binder: two filters in one object are refused: each is its own",
                      json: "{ \"move\": { \"gamepad\": { \"x\": \"LeftX\", \"filters\": [ { \"scale\": 2, \"invert\": true } ] } } }",
                      says: "`invert` is not a `filter's second key`");
    expectReadRefused(t: t, name: "binder: filters written twice in one entry are refused",
                      json: "{ \"move\": { \"gamepad\": { \"x\": \"LeftX\", \"filters\": [ ], \"filters\": [ { \"scale\": 2 } ] } } }",
                      says: "duplicate key");
    expectReadRefused(t: t, name: "binder: filters not written as a list are refused",
                      json: "{ \"move\": { \"gamepad\": { \"x\": \"LeftX\", \"filters\": { \"scale\": 2 } } } }",
                      says: "type mismatch at `move.gamepad.filters`");
    expectReadRefused(t: t, name: "binder: a curve's point of three numbers is refused",
                      json: "{ \"move\": { \"gamepad\": { \"x\": \"LeftX\", \"filters\": [ { \"curve\": { \"points\": [ [0, 0, 1] ] } } ] } } }",
                      says: "too many elements");

    expectRefused(t: t, name: "binder: a dead zone on the mouse's motion is refused: it would change with the step's length",
                  json: "{ \"look\": { \"mouse\": { \"x\": \"MotionX\", \"filters\": [ { \"deadZone\": 0.2 } ] } } }",
                  says: "a `deadZone` on the mouse's motion");
    expectRefused(t: t, name: "binder: and a curve", json: "{ \"look\": { \"mouse\": { \"x\": \"MotionX\", \"filters\": [ { \"curve\": 2 } ] } } }",
                  says: "a `curve` on the mouse's motion");
    expectRefused(t: t, name: "binder: a threshold on a value is refused: it makes a button",
                  json: "{ \"throttle\": { \"gamepad\": { \"positive\": \"RightTrigger\", \"filters\": [ { \"threshold\": 0.5 } ] } } }",
                  says: "a `threshold` makes a button");
    expectRefused(t: t, name: "binder: a dead zone's lower end at or past its upper is refused",
                  json: "{ \"move\": { \"gamepad\": { \"x\": \"LeftX\", \"filters\": [ { \"deadZone\": { \"lower\": 0.9, \"upper\": 0.5 } } ] } } }",
                  says: "its `lower`, 0.9, must be below its `upper`, 0.5");
    expectRefused(t: t, name: "binder: a negative dead zone is refused",
                  json: "{ \"move\": { \"gamepad\": { \"x\": \"LeftX\", \"filters\": [ { \"deadZone\": -0.1 } ] } } }",
                  says: "its `lower`, -0.1, must be 0 or more");
    expectRefused(t: t, name: "binder: a curve's exponent of 0 or less is refused",
                  json: "{ \"move\": { \"gamepad\": { \"x\": \"LeftX\", \"filters\": [ { \"curve\": 0 } ] } } }",
                  says: "a `curve`'s exponent must be more than 0");
    expectRefused(t: t, name: "binder: a curve's points not rising in input are refused",
                  json: "{ \"move\": { \"gamepad\": { \"x\": \"LeftX\", \"filters\": [ { \"curve\": { \"points\": [ [0, 0], [0.5, 0.2], [0.5, 1] ] } } ] } } }",
                  says: "a `curve`'s points must rise in input");
    expectRefused(t: t, name: "binder: a curve of one point is refused",
                  json: "{ \"move\": { \"gamepad\": { \"x\": \"LeftX\", \"filters\": [ { \"curve\": { \"points\": [ [0, 0] ] } } ] } } }",
                  says: "a `curve` through points needs two or more");
    expectRefused(t: t, name: "binder: a remap from a range of no width is refused",
                  json: "{ \"throttle\": { \"keyboard\": { \"positive\": \"KeyW\", \"filters\": [ { \"remap\": { \"from\": [1, 1], \"to\": [0, 1] } } ] } } }",
                  says: "a `remap`'s `from` must span a range");
    expectRefused(t: t, name: "binder: a smooth of no time is refused",
                  json: "{ \"throttle\": { \"keyboard\": { \"positive\": \"KeyW\", \"filters\": [ { \"smooth\": 0 } ] } } }",
                  says: "a `smooth`'s seconds must be more than 0");
    expectRefused(t: t, name: "binder: a clamp naming no bound is refused",
                  json: "{ \"throttle\": { \"keyboard\": { \"positive\": \"KeyW\", \"filters\": [ { \"clamp\": { } } ] } } }",
                  says: "a `clamp` names its `min`, its `max` or its `length`");
    expectRefused(t: t, name: "binder: a clamp whose least is past its most is refused",
                  json: "{ \"throttle\": { \"keyboard\": { \"positive\": \"KeyW\", \"filters\": [ { \"clamp\": { \"min\": 1, \"max\": 0 } } ] } } }",
                  says: "a `clamp`'s `min` must be at most its `max`");
    string accepted = refusalOf(json: "{ \"faster\": { \"gamepad\": { \"control\": \"RightTrigger\", \"filters\": [ { \"threshold\": 0.5 } ] } } }");
    t.verdict(name: "binder: a digital's gamepad entry may name its controls and a threshold", why: accepted);
}

// The engine's decided defaults, as engine/content/input.records.json writes them (design/input.md § Decided,
// 2026-11-23, the third part's question 1).
fn string defaults() {
    return "{ \"stickDeadZone\": { \"lower\": 0.125, \"upper\": 0.925 }, \"triggerDeadZone\": { \"lower\": 0.11764706 }, \"stickThreshold\": { \"press\": 0.5, \"release\": 0.375 } }";
}

fn InputRecord inputOf(const ref string json) {
    Result<InputRecord, Owned<Error>> read = deserializeJsonBuffer::<InputRecord>(src: copy json, strict: true);
    return match (give read) {
        case Ok(value: r): give r;
        case Err(error: e): {
            string why = e.message();
            panic(msg: "a test's input record read: " + why);
        }
    };
}

// A binder for the actions `faster` and `jump` and the value actions, bound by `json`, with the input record `input`.
fn Binder binderWith(const ref string json, const ref string input) {
    ActionList actions = actionsOf(a: "faster", b: "jump");
    SortedMap<string, BindingRecord> b = bindingsOf(json: json);
    InputRecord record = inputOf(json: input);
    Result<Binder, BindingError> made = Binder.make(players: 1, actions: actions, bindings: b, input: record, hz: 60);
    return match (give made) {
        case Ok(value: v): give v;
        case Err(error: e): {
            string why = e.message();
            panic(msg: "a test's bindings refused: " + why);
        }
    };
}

fn string refusalWith(const ref string json, const ref string input) {
    ActionList actions = actionsOf(a: "faster", b: "jump");
    SortedMap<string, BindingRecord> b = bindingsOf(json: json);
    InputRecord record = inputOf(json: input);
    Result<Binder, BindingError> made = Binder.make(players: 1, actions: actions, bindings: b, input: record, hz: 60);
    return match (made) {
        case Ok(value: v): "";
        case Err(error: e): e.message();
    };
}

// `move` bound to the left stick by `entry` (its parts and filters), with the engine's defaults, its pad locked, then
// the stick at (`x`, `y`) as the W3C reports it, read in the next step.
fn Vec2 stickWithDefaults(const ref string entry, float32 x, float32 y) {
    Binder b = binderWith(json: "{ \"move\": { \"gamepad\": " + entry + " } }", input: defaults());
    hand(b: b, s: pad(slot: 0, control: 0, value: 1.0, at: 5));
    hand(b: b, s: stick(slot: 0, index: 0, value: x, at: 10));
    hand(b: b, s: stick(slot: 0, index: 1, value: y, at: 20));
    return moveAt(b: b, step: 0, until: 100);
}

// `throttle` bound by `entry` on the pad, with the engine's defaults, its pad locked, then `sample` taken.
fn float32 throttleWithDefaults(const ref string entry, Sample sample) {
    Binder b = binderWith(json: "{ \"throttle\": { \"gamepad\": " + entry + " } }", input: defaults());
    hand(b: b, s: pad(slot: 0, control: 0, value: 1.0, at: 5));
    hand(b: b, s: sample);
    return throttleAt(b: b, step: 0, until: 100);
}

// The `input` record's defaults (the third part's question 1): every stick an entry reads, radial on one stick's pair
// and per axis otherwise, and every trigger's travel, unless the entry names a dead zone of its own.
fn void defaultZoneCases(ref Tally t) {
    string pair = "{ \"x\": \"LeftX\", \"y\": \"LeftY\" }";
    expectVec2(t: t, name: "binder: a stick at rest inside the default dead zone reads 0, its drift gone",
               got: stickWithDefaults(entry: pair, x: 0.06, y: -0.04), x: 0.0, y: 0.0);
    expectVec2Near(t: t, name: "binder: one stick's pair takes the default radially, rescaled from 0.125 to 0.925",
                   got: stickWithDefaults(entry: pair, x: 0.45, y: 0.6), x: 0.46875, y: -0.625);
    expectVec2Near(t: t, name: "binder: and past 0.925 is a direction of length 1", got: stickWithDefaults(entry: pair, x: 0.57, y: 0.76),
                   x: 0.6, y: -0.8);
    expectVec2Near(t: t, name: "binder: a pair read the other way about is still one stick's, radial",
                   got: stickWithDefaults(entry: "{ \"x\": \"LeftY\", \"y\": \"LeftX\" }", x: 0.45, y: 0.6), x: -0.625, y: 0.46875);
    Binder two = binderWith(json: "{ \"move\": { \"gamepad\": { \"x\": \"LeftX\", \"y\": \"RightY\" } } }", input: defaults());
    hand(b: two, s: pad(slot: 0, control: 0, value: 1.0, at: 5));
    hand(b: two, s: stick(slot: 0, index: 0, value: 0.45, at: 10));
    hand(b: two, s: stick(slot: 0, index: 3, value: 0.6, at: 20));
    expectVec2Near(t: t, name: "binder: two sticks' axes take the default each on its own axis",
                   got: moveAt(b: two, step: 0, until: 100), x: 0.40625, y: -0.59375);
    expectVec2Near(t: t, name: "binder: the default comes before the entry's own filters",
                   got: stickWithDefaults(entry: "{ \"x\": \"LeftX\", \"y\": \"LeftY\", \"filters\": [ { \"scale\": 2 } ] }", x: 0.45, y: 0.6),
                   x: 0.9375, y: -1.25);
    expectVec2Near(t: t, name: "binder: an entry's own dead zone takes the default's place",
                   got: stickWithDefaults(entry: "{ \"x\": \"LeftX\", \"y\": \"LeftY\", \"filters\": [ { \"deadZone\": 0 } ] }", x: 0.06, y: -0.04),
                   x: 0.06, y: 0.04);

    expectNear(t: t, name: "binder: a stick's one axis takes the default on its own",
               got: throttleWithDefaults(entry: "{ \"positive\": \"LeftX\" }", sample: stick(slot: 0, index: 0, value: 0.5, at: 10)),
               want: 0.46875);
    expectNear(t: t, name: "binder: and a dead zone of its own takes its place",
               got: throttleWithDefaults(entry: "{ \"positive\": \"LeftX\", \"filters\": [ { \"deadZone\": 0 } ] }",
                                         sample: stick(slot: 0, index: 0, value: 0.05, at: 10)), want: 0.05);
    float32 pressed = 0.11764706;
    expectNear(t: t, name: "binder: a trigger's travel takes the trigger's default, from 30/255",
               got: throttleWithDefaults(entry: "\"RightTrigger\"", sample: travel(slot: 0, button: 7, value: 0.5, at: 10)),
               want: (0.5 - pressed) / (1.0 - pressed));
    expectNear(t: t, name: "binder: and short of it reads 0",
               got: throttleWithDefaults(entry: "\"RightTrigger\"", sample: travel(slot: 0, button: 7, value: 0.1, at: 10)), want: 0.0);
    expectNear(t: t, name: "binder: the left trigger too",
               got: throttleWithDefaults(entry: "\"LeftTrigger\"", sample: travel(slot: 0, button: 6, value: 0.1, at: 10)), want: 0.0);
    expectNear(t: t, name: "binder: another button's travel takes none: the default is the triggers'",
               got: throttleWithDefaults(entry: "\"South\"", sample: travel(slot: 0, button: 0, value: 0.05, at: 10)), want: 0.05);

    Binder o = binderWith(json: "{ \"move\": { \"gamepad\": { \"x\": \"LeftX\", \"y\": \"LeftY\" } } }", input: defaults());
    hand(b: o, s: pad(slot: 0, control: 0, value: 1.0, at: 5));
    hand(b: o, s: stick(slot: 0, index: 0, value: 0.45, at: 10));
    hand(b: o, s: stick(slot: 0, index: 1, value: 0.6, at: 20));
    expectVec2Near(t: t, name: "binder: Output's newest takes the defaults too", got: o.newest(seconds: 0.5).vector2(player: 1, action: 0),
                   x: 0.46875, y: -0.625);

    string wrong = refusalWith(json: "{ \"faster\": { \"keyboard\": \"ArrowUp\" } }",
                               input: "{ \"stickDeadZone\": { \"lower\": 0.9, \"upper\": 0.5 } }");
    t.verdict(name: "binder: an input record's dead zone out of its range is refused, naming the record",
              why: wrong.contains(substring: "the `input` record's `stickDeadZone` has a dead zone: its `lower`, 0.9, must be below its `upper`, 0.5")
              ? "" : "refused `${wrong}`");
    string trig = refusalWith(json: "{ \"faster\": { \"keyboard\": \"ArrowUp\" } }", input: "{ \"triggerDeadZone\": { \"lower\": -1 } }");
    t.verdict(name: "binder: the trigger's too", why: trig.contains(substring: "the `input` record's `triggerDeadZone`") ? "" : "refused `${trig}`");
}

// A digital bound by `json` with the engine's defaults, its pad locked by a press of North, which `faster` is not bound to.
fn Binder digitalWith(const ref string json) {
    Binder b = binderWith(json: json, input: defaults());
    hand(b: b, s: pad(slot: 0, control: 3, value: 1.0, at: 5));
    return b;
}

// A stick's directions as controls, and a value made a button pressing at one point and letting go at a lower one (the
// third part's question 2).
fn void thresholdCases(ref Tally t) {
    Binder d = digitalWith(json: "{ \"faster\": { \"gamepad\": [\"DpadUp\", \"LeftStickUp\"] } }");
    hand(b: d, s: stick(slot: 0, index: 1, value: -0.7, at: 10));
    expectStep(t: t, b: d, step: 0, until: 100, name: "binder: a stick pushed up past the press point presses `LeftStickUp`", want: "HP-");
    hand(b: d, s: stick(slot: 0, index: 1, value: -0.5, at: 110));
    expectStep(t: t, b: d, step: 1, until: 200, name: "binder: and back under it, above the release point, holds it", want: "H--");
    hand(b: d, s: stick(slot: 0, index: 1, value: -0.4, at: 210));
    expectStep(t: t, b: d, step: 2, until: 300, name: "binder: at the release point or under, lets go", want: "--R");
    hand(b: d, s: stick(slot: 0, index: 1, value: -0.5, at: 310));
    expectStep(t: t, b: d, step: 3, until: 400, name: "binder: and between the two once let go, stays up: no chatter", want: "---");
    hand(b: d, s: pad(slot: 0, control: 12, value: 1.0, at: 410));
    expectStep(t: t, b: d, step: 4, until: 500, name: "binder: the d-pad beside it still presses by its events", want: "HP-");
    hand(b: d, s: pad(slot: 0, control: 12, value: 0.0, at: 510));
    hand(b: d, s: stick(slot: 0, index: 1, value: 0.9, at: 520));
    expectStep(t: t, b: d, step: 5, until: 600, name: "binder: a stick pushed down is not up", want: "--R");

    Binder down = digitalWith(json: "{ \"faster\": { \"gamepad\": \"LeftStickDown\" } }");
    hand(b: down, s: stick(slot: 0, index: 1, value: 0.7, at: 10));
    expectStep(t: t, b: down, step: 0, until: 100, name: "binder: `LeftStickDown` is the stick pushed down", want: "HP-");
    Binder left = digitalWith(json: "{ \"faster\": { \"gamepad\": \"LeftStickLeft\" } }");
    hand(b: left, s: stick(slot: 0, index: 0, value: -0.7, at: 10));
    expectStep(t: t, b: left, step: 0, until: 100, name: "binder: `LeftStickLeft` is the stick pushed left", want: "HP-");
    Binder right = digitalWith(json: "{ \"faster\": { \"gamepad\": \"RightStickRight\" } }");
    hand(b: right, s: stick(slot: 0, index: 0, value: -0.9, at: 10));
    hand(b: right, s: stick(slot: 0, index: 2, value: 0.7, at: 20));
    expectStep(t: t, b: right, step: 0, until: 100, name: "binder: `RightStickRight` is the right stick, not the left", want: "HP-");
    Binder rup = digitalWith(json: "{ \"faster\": { \"gamepad\": \"RightStickUp\" } }");
    hand(b: rup, s: stick(slot: 0, index: 1, value: 0.9, at: 10));
    hand(b: rup, s: stick(slot: 0, index: 3, value: -0.7, at: 20));
    expectStep(t: t, b: rup, step: 0, until: 100, name: "binder: `RightStickUp` is the right stick's Y, turned over", want: "HP-");
    hand(b: rup, s: Sample.padDisconnected(slot: 0, at: 110));
    expectStep(t: t, b: rup, step: 1, until: 200, name: "binder: the locked pad gone, a stick's direction lets go", want: "--R");

    Binder own = digitalWith(json: "{ \"faster\": { \"gamepad\": { \"control\": \"LeftStickUp\", \"filters\": [ { \"threshold\": { \"press\": 0.8, \"release\": 0.2 } } ] } } }");
    hand(b: own, s: stick(slot: 0, index: 1, value: -0.7, at: 10));
    expectStep(t: t, b: own, step: 0, until: 100, name: "binder: an entry's own threshold takes the record's place: 0.7 short of 0.8", want: "---");
    hand(b: own, s: stick(slot: 0, index: 1, value: -0.9, at: 110));
    hand(b: own, s: stick(slot: 0, index: 1, value: -0.3, at: 120));
    expectStep(t: t, b: own, step: 1, until: 200, name: "binder: and presses past its own press point", want: "HP-");
    expectStep(t: t, b: own, step: 2, until: 300, name: "binder: and holds down to its own release point", want: "H--");

    Binder trig = digitalWith(json: "{ \"faster\": { \"gamepad\": { \"control\": \"RightTrigger\", \"filters\": [ { \"threshold\": 0.8 } ] } } }");
    hand(b: trig, s: pad(slot: 0, control: 7, value: 0.5, at: 10));
    hand(b: trig, s: travel(slot: 0, button: 7, value: 0.5, at: 11));
    hand(b: trig, s: travel(slot: 0, button: 7, value: 0.82, at: 12));
    expectStep(t: t, b: trig, step: 0, until: 100, name: "binder: a trigger with a threshold reads its travel through its dead zone, not the window's press at 30/255: 0.82 short of 0.8", want: "---");
    hand(b: trig, s: travel(slot: 0, button: 7, value: 0.9, at: 110));
    expectStep(t: t, b: trig, step: 1, until: 200, name: "binder: past its threshold through the trigger's dead zone, pressed", want: "HP-");
    hand(b: trig, s: travel(slot: 0, button: 7, value: 0.7, at: 210));
    expectStep(t: t, b: trig, step: 2, until: 300, name: "binder: a bare number lets go at three quarters of it: held above", want: "H--");
    hand(b: trig, s: travel(slot: 0, button: 7, value: 0.6, at: 310));
    expectStep(t: t, b: trig, step: 3, until: 400, name: "binder: and let go at it or under", want: "--R");

    Binder record = binderWith(json: "{ \"faster\": { \"gamepad\": \"LeftStickUp\" } }",
                               input: "{ \"stickThreshold\": { \"press\": 0.6 } }");
    hand(b: record, s: pad(slot: 0, control: 3, value: 1.0, at: 5));
    hand(b: record, s: stick(slot: 0, index: 1, value: -0.55, at: 10));
    expectStep(t: t, b: record, step: 0, until: 100, name: "binder: the record's press point, raw with no dead zone named: 0.55 short of 0.6", want: "---");
    hand(b: record, s: stick(slot: 0, index: 1, value: -0.65, at: 110));
    hand(b: record, s: stick(slot: 0, index: 1, value: -0.46, at: 120));
    expectStep(t: t, b: record, step: 1, until: 200, name: "binder: the record's press point reached", want: "HP-");
    expectStep(t: t, b: record, step: 2, until: 300, name: "binder: its release three quarters of it where unnamed: 0.46 above 0.45 holds", want: "H--");

    Binder part = binderFor(json: "{ \"throttle\": { \"gamepad\": { \"positive\": \"LeftStickUp\", \"negative\": \"LeftStickDown\" } } }");
    hand(b: part, s: pad(slot: 0, control: 3, value: 1.0, at: 5));
    hand(b: part, s: stick(slot: 0, index: 1, value: -0.25, at: 10));
    expectNear(t: t, name: "binder: a stick's directions as an analog's parts: up its half", got: throttleAt(b: part, step: 0, until: 100), want: 0.25);
    hand(b: part, s: stick(slot: 0, index: 1, value: 0.75, at: 110));
    expectNear(t: t, name: "binder: and down its other", got: throttleAt(b: part, step: 1, until: 200), want: -0.75);
    Binder keys = binderFor(json: "{ \"move\": { \"gamepad\": { \"up\": \"LeftStickUp\", \"right\": \"LeftStickRight\" } } }");
    hand(b: keys, s: pad(slot: 0, control: 3, value: 1.0, at: 5));
    hand(b: keys, s: stick(slot: 0, index: 0, value: 0.8, at: 10));
    hand(b: keys, s: stick(slot: 0, index: 1, value: -0.6, at: 20));
    expectVec2Near(t: t, name: "binder: and as a vector2's key-style parts", got: moveAt(b: keys, step: 0, until: 100), x: 0.8, y: 0.6);
    expectVec2Near(t: t, name: "binder: a stick's directions as an entry's x and y take the default on each, not as one stick's pair",
                   got: stickWithDefaults(entry: "{ \"x\": \"LeftStickRight\", \"y\": \"LeftStickUp\" }", x: 0.45, y: -0.6),
                   x: 0.40625, y: 0.59375);
    expectNear(t: t, name: "binder: a stick's direction reads after the stick's default dead zone",
               got: throttleWithDefaults(entry: "{ \"positive\": \"LeftStickUp\" }", sample: stick(slot: 0, index: 1, value: -0.525, at: 10)),
               want: 0.5);

    string none = refusalOf(json: "{ \"faster\": { \"gamepad\": \"LeftStickUp\" } }");
    t.verdict(name: "binder: a stick's direction as a button with no press point anywhere is refused",
              why: none.contains(substring: "names `LeftStickUp`, a stick's direction, which as a button needs a press point") ? "" : "refused `${none}`");
    expectRefused(t: t, name: "binder: a threshold letting go at or above its press is refused",
                  json: "{ \"faster\": { \"gamepad\": { \"control\": \"RightTrigger\", \"filters\": [ { \"threshold\": { \"press\": 0.5, \"release\": 0.5 } } ] } } }",
                  says: "a `threshold`'s `release` is from 0 to below its `press`, 0.5");
    expectRefused(t: t, name: "binder: a threshold pressing past 1 is refused",
                  json: "{ \"faster\": { \"gamepad\": { \"control\": \"RightTrigger\", \"filters\": [ { \"threshold\": 1.5 } ] } } }",
                  says: "a `threshold`'s `press` is above 0 and at most 1");
    expectRefused(t: t, name: "binder: a threshold pressing at 0 is refused",
                  json: "{ \"faster\": { \"gamepad\": { \"control\": \"RightTrigger\", \"filters\": [ { \"threshold\": 0 } ] } } }",
                  says: "a `threshold`'s `press` is above 0 and at most 1");
    expectRefused(t: t, name: "binder: a threshold on a key is refused: a key is a button already",
                  json: "{ \"faster\": { \"keyboard\": { \"control\": \"Space\", \"filters\": [ { \"threshold\": 0.5 } ] } } }",
                  says: "a key or a mouse button is a button already");
    expectRefused(t: t, name: "binder: a filter other than a threshold on a digital is refused",
                  json: "{ \"faster\": { \"gamepad\": { \"control\": \"RightTrigger\", \"filters\": [ { \"scale\": 2 } ] } } }",
                  says: "a `Digital` takes a `threshold` alone of the filters");
    expectRefused(t: t, name: "binder: two thresholds on one entry are refused",
                  json: "{ \"faster\": { \"gamepad\": { \"control\": \"RightTrigger\", \"filters\": [ { \"threshold\": 0.5 }, { \"threshold\": 0.6 } ] } } }",
                  says: "lists two thresholds");
    expectRefused(t: t, name: "binder: a digital's object naming no control is refused",
                  json: "{ \"faster\": { \"gamepad\": { \"filters\": [ { \"threshold\": 0.5 } ] } } }",
                  says: "names no control");
    expectRefused(t: t, name: "binder: a digital's gestures are refused until their part",
                  json: "{ \"faster\": { \"gamepad\": { \"control\": \"South\", \"gestures\": [ { \"hold\": 0.5 } ] } } }",
                  says: "names gestures");
    expectRefused(t: t, name: "binder: a misspelt stick direction lists the directions",
                  json: "{ \"faster\": { \"gamepad\": \"LeftStickUpp\" } }", says: "no stick's direction (`LeftStickUp`, `LeftStickDown`");
    string wrong = refusalWith(json: "{ \"faster\": { \"keyboard\": \"ArrowUp\" } }", input: "{ \"stickThreshold\": { \"press\": 0.4, \"release\": 0.6 } }");
    t.verdict(name: "binder: the input record's threshold out of its range is refused, naming the record",
              why: wrong.contains(substring: "the `input` record's `stickThreshold` has a `threshold` letting go at 0.6") ? "" : "refused `${wrong}`");
}

fn void binderTests(ref Tally t) {
    thresholdCases(t: t);
    defaultZoneCases(t: t);
    filterShapeCases(t: t);
    filterOrderCases(t: t);
    filterRefusalCases(t: t);
    newestCases(t: t);
    schemeCases(t: t);
    bindingCases(t: t);
    partCases(t: t);
    travelCases(t: t);
    deltaCases(t: t);
    valueRefusalCases(t: t);
    edgeCases(t: t);
    padCases(t: t);
    playerCases(t: t);
}
