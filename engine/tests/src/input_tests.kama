// The frame tier's input (the first slice's step 8, KYR-54): `Digital`, the action kind a processor reads as on or off;
// `ActionList`, a game's actions by kind; `Pose`; `Sample`, one input from a device as a platform hands it in;
// `Handoff`, one step's action values; and `PlayerActions`, the world's record of them across steps, from which each
// processor's view is made, whatever its rate: a state as of its last step, a delta summed over its window
// (design/input.md § Decided, the second part's question 1).

import { Tally, std::math::Vec2, std::math::Vec3, std::math::Quat,
         kyoten::frame::Digital, kyoten::frame::Sample, kyoten::frame::SampleKind, kyoten::frame::Device,
         kyoten::frame::Handoff, kyoten::frame::PlayerActions, kyoten::frame::ActionList, kyoten::frame::Pose,
         kyoten::frame::Clock, kyoten::frame::Scheme, kyoten::frame::TextEntry, kyoten::frame::Text,
         kyoten::frame::Requests, kyoten::frame::ZoneCoord, kyoten::frame::DrawnView, std::math::Mat4,
         kyoten::frame::Cursor, kyoten::frame::CursorMode, kyoten::frame::PadLock, std::memory::Owned,
         std::serialization::text::json::deserializeJsonBuffer };

export { inputTests, spelled, digitalOf, lineOf, modeWord };

// A processor reads an action through a `const ref`, so its fields must read there.
fn bool heldThrough(const ref Digital d) { return d.held; }

// "held pressed released" as three letters, H, P and R, a dash for each off.
fn string spelled(Digital d) {
    string h = d.held ? "H" : "-";
    string p = d.pressed ? "P" : "-";
    string r = d.released ? "R" : "-";
    return h + p + r;
}

fn void expectSpelled(ref Tally t, const ref string name, Digital d, const ref string want) {
    string got = spelled(d: d);
    t.verdict(name: name, why: got == want ? "" : "got ${got}, want ${want}");
}

fn Digital digitalOf(bool held, bool pressed, bool released) {
    Digital d = Digital.off();
    d.held = held;
    d.pressed = pressed;
    d.released = released;
    return d;
}

fn void expectFloat(ref Tally t, const ref string name, float32 got, float32 want) {
    t.verdict(name: name, why: got == want ? "" : "got ${got}, want ${want}");
}

fn void expectVec2(ref Tally t, const ref string name, Vec2 got, float32 x, float32 y) {
    float32 gx = got.x;
    float32 gy = got.y;
    t.verdict(name: name, why: gx == x && gy == y ? "" : "got (${gx}, ${gy}), want (${x}, ${y})");
}

fn void expectVec3(ref Tally t, const ref string name, Vec3 got, float32 x, float32 y, float32 z) {
    float32 gx = got.x;
    float32 gy = got.y;
    float32 gz = got.z;
    t.verdict(name: name, why: gx == x && gy == y && gz == z ? "" : "got (${gx}, ${gy}, ${gz}), want (${x}, ${y}, ${z})");
}

fn bool atRest(Pose p) {
    return p.zone.equals(other: ZoneCoord.origin()) && p.position.x == 0.0 && p.position.y == 0.0 && p.position.z == 0.0 && p.orientation.x == 0.0
        && p.orientation.y == 0.0 && p.orientation.z == 0.0 && p.orientation.w == 1.0;
}

fn Pose poseAt(float32 x, float32 y, float32 z) {
    Pose p = Pose.identity();
    p.zone = ZoneCoord.of(x: cast<int32>(x), y: -2, z: 3);
    p.position = Vec3.of(x: x, y: y, z: z);
    p.orientation = Quat.of(x: 0.0, y: 1.0, z: 0.0, w: 0.0);
    return p;
}

// Two digital actions, as the first part's cases hold.
fn ActionList twoDigital() {
    ActionList a = ActionList.make();
    a.addDigital(name: "faster");
    a.addDigital(name: "jump");
    return a;
}

// One digital action, then one of each value kind, a state and a delta where a kind may be either: `throttle` and
// `zoom` (analog), `move` and `look` (vector2), `fly` (vector3, a delta) and `hand` (a pose); and a third vector2,
// `aim`, so no two kinds count alike.
fn ActionList everyKind() {
    ActionList a = ActionList.make();
    a.addDigital(name: "fire");
    a.addAnalog(name: "throttle", delta: false);
    a.addAnalog(name: "zoom", delta: true);
    a.addVector2(name: "move", delta: false);
    a.addVector2(name: "look", delta: true);
    a.addVector2(name: "aim", delta: false);
    a.addVector3(name: "fly", delta: true);
    a.addPose(name: "hand");
    return a;
}

fn void digitalCases(ref Tally t) {
    Digital off = Digital.default();
    bool ok = !off.held && !off.pressed && !off.released && off.progress == 0.0;
    t.verdict(name: "Digital: off by default, neither held nor pressed nor released, no progress", why: ok ? "" : "not all off");

    Digital on = Digital.default();
    on.held = true;
    on.pressed = true;
    bool seen = heldThrough(d: on) && on.pressed && !on.released;
    t.verdict(name: "Digital: its fields read through a const ref", why: seen ? "" : "held or pressed not read");

    // An `Actions` row holds one per action, so its size feeds the chunk size (components question 6, choice 4): three
    // flags and, since the fourth part of step 8 (design/input.md § Decided, 2026-11-24, question 1), a float32's
    // progress, aligned to 4.
    usize size = sizeof(Digital);
    t.verdict(name: "Digital: 8 bytes on every target", why: size == 8 ? "" : "${size} bytes");
}

fn void actionListCases(ref Tally t) {
    ActionList none = ActionList.make();
    t.verdict(name: "ActionList: a game with no action is empty", why: none.isEmpty() ? "" : "not empty");
    ActionList a = everyKind();
    bool counted = a.digitalCount() == 1 && a.analogCount() == 2 && a.vector2Count() == 3 && a.vector3Count() == 1
        && a.poseCount() == 1 && !a.isEmpty();
    t.verdict(name: "ActionList: each kind counts its own actions", why: counted ? "" : "other counts");
    bool named = a.analogNames()[0] == "throttle" && a.analogNames()[1] == "zoom" && a.vector2Names()[1] == "look"
        && a.digitalNames()[0] == "fire" && a.vector3Names()[0] == "fly" && a.poseNames()[0] == "hand";
    t.verdict(name: "ActionList: each kind's names in the order added", why: named ? "" : "another order");
    bool deltas = !a.analogDelta(action: 0) && a.analogDelta(action: 1) && !a.vector2Delta(action: 0)
        && a.vector2Delta(action: 1) && a.vector3Delta(action: 0);
    t.verdict(name: "ActionList: which value actions are deltas, by kind", why: deltas ? "" : "another flag");
    bool past = !a.analogDelta(action: 2) && !a.vector2Delta(action: -1) && !a.vector3Delta(action: 1);
    t.verdict(name: "ActionList: an action it does not hold is no delta", why: past ? "" : "one past its room is");
    ActionList one = ActionList.make();
    one.addPose(name: "hand");
    t.verdict(name: "ActionList: a game with a pose alone is not empty", why: one.isEmpty() ? "empty" : "");
}

fn void poseCases(ref Tally t) {
    t.verdict(name: "Pose: at rest by default, at the origin zone's centre and turned as the world is",
              why: atRest(p: Pose.default()) ? "" : "not at rest");
    Pose p = poseAt(x: 1.0, y: 2.0, z: 3.0);
    bool set = p.position.y == 2.0 && p.orientation.y == 1.0 && p.orientation.w == 0.0
        && p.zone.equals(other: ZoneCoord.of(x: 1, y: -2, z: 3));
    t.verdict(name: "Pose: a zone, a position and an orientation of its own", why: set ? "" : "a field differs");
    Pose away = Pose.identity();
    away.zone = ZoneCoord.of(x: 5, y: 0, z: 0);
    t.verdict(name: "Pose: in another zone, it is not at rest", why: atRest(p: away) ? "at rest" : "");
}

// What a `Text` holds, as a line.
fn string lineOf(Text x) {
    string line = "";
    x.appendTo(text: line);
    return line;
}

fn Text textOf(const ref string s) {
    Text x = Text.empty();
    foreach (char c in s.chars()) { _ = x.add(point: c); }
    return x;
}

// The text that entered (design/input.md § Decided, 2026-11-25, the fifth part's question 1): code points in order, up
// to its capacity, read by index, by `foreach`, and added to a line.
fn void textCases(ref Tally t) {
    Text e = Text.default();
    t.verdict(name: "Text: empty by default", why: e.isEmpty() && e.length() == 0 ? "" : "not empty");
    Text one = Text.empty();
    _ = one.add(point: 'z');
    t.verdict(name: "Text: one code point is not empty", why: !one.isEmpty() && one.length() == 1 ? "" : "it is");
    Text x = Text.empty();
    bool a = x.add(point: 'h');
    bool b = x.add(point: '\u{00E9}');
    t.verdict(name: "Text: code points added in order, read by index",
              why: a && b && x.length() == 2 && x.at(index: 0) == 'h' && x.at(index: 1) == '\u{00E9}' && !x.isEmpty() ? "" : "they differ");
    int32 sum = 0;
    foreach (char c in x.chars()) { sum = sum + cast<int32>(c); }
    t.verdict(name: "Text: its code points by `foreach`, oldest first", why: sum == 104 + 233 ? "" : "summed ${sum}");
    string line = "say ";
    x.appendTo(text: line);
    t.verdict(name: "Text: added to the end of a line", why: line == "say hé" ? "" : "got `${line}`");
    Text full = Text.empty();
    int32 i = 0;
    bool kept = true;
    while (i < Text::capacity) { kept = kept && full.add(point: 'x'); i = i + 1; }
    bool past = full.add(point: 'y');
    t.verdict(name: "Text: holds its capacity, 64, and refuses one past it",
              why: kept && !past && full.length() == 64 && full.at(index: 63) == 'x' ? "" : "it did not");
}

// A game's text actions in the list, the hand-off and the world's record: each step's joined over a run's window,
// oldest first, so a run sees each code point once (the fifth part's question 1).
fn void textActionCases(ref Tally t) {
    ActionList only = ActionList.make();
    only.addText(name: "chat");
    t.verdict(name: "ActionList: a game with a text action alone is not empty",
              why: !only.isEmpty() && only.textCount() == 1 && only.textNames()[0] == "chat" ? "" : "it is");
    ActionList two = ActionList.make();
    two.addDigital(name: "faster");
    two.addText(name: "chat");
    two.addText(name: "note");
    Handoff h = Handoff.make(players: 2, actions: two);
    t.verdict(name: "Handoff: a text action is empty until set", why: h.text(player: 1, action: 1).isEmpty() && h.textActions() == 2 ? "" : "not");
    h.setText(player: 2, action: 1, value: textOf(s: "ok"));
    string set = lineOf(x: h.text(player: 2, action: 1));
    string other = lineOf(x: h.text(player: 1, action: 1));
    t.verdict(name: "Handoff: a text set is read back by its player and action alone",
              why: set == "ok" && other.isEmpty() ? "" : "player 2 `${set}`, player 1 `${other}`");
    t.verdict(name: "Handoff: a text past its room reads empty",
              why: h.text(player: 3, action: 0).isEmpty() && h.text(player: 1, action: 2).isEmpty() ? "" : "it is not");
    h.clear();
    t.verdict(name: "Handoff: clear empties every text", why: h.text(player: 2, action: 1).isEmpty() ? "" : "it did not");

    PlayerActions w = PlayerActions.make(players: 1, actions: two, window: 1);
    Handoff s = Handoff.make(players: 1, actions: two);
    s.setText(player: 1, action: 0, value: textOf(s: "ab"));
    s.setText(player: 1, action: 1, value: textOf(s: "N"));
    w.take(handoff: s, step: 0);
    s.clear();
    s.setText(player: 1, action: 0, value: textOf(s: "c"));
    w.take(handoff: s, step: 1);
    s.clear();
    w.take(handoff: s, step: 2);
    string all = lineOf(x: w.text(player: 1, action: 0, after: -1, upTo: 2));
    string last = lineOf(x: w.text(player: 1, action: 0, after: 1, upTo: 2));
    string middle = lineOf(x: w.text(player: 1, action: 0, after: 0, upTo: 1));
    string note = lineOf(x: w.text(player: 1, action: 1, after: -1, upTo: 2));
    t.verdict(name: "PlayerActions: a text joins its window's steps, oldest first",
              why: all == "abc" ? "" : "got `${all}`");
    t.verdict(name: "PlayerActions: a run sees only its window's text, so each code point once",
              why: last.isEmpty() && middle == "c" ? "" : "after step 1 `${last}`, step 1 alone `${middle}`");
    t.verdict(name: "PlayerActions: each text action its own", why: note == "N" ? "" : "got `${note}`");
    t.verdict(name: "PlayerActions: a text for a player or an action it has no room for is empty",
              why: w.text(player: 2, action: 0, after: -1, upTo: 2).isEmpty() && w.text(player: 1, action: 2, after: -1, upTo: 2).isEmpty() ? "" : "not");
    expectInt(t: t, name: "PlayerActions: a world keeps a frame's most steps at least", got: PlayerActions::keptFor(window: 3), want: 5);
    expectInt(t: t, name: "PlayerActions: and a wider window whole", got: PlayerActions::keptFor(window: 8), want: 8);
}

fn void expectInt(ref Tally t, const ref string name, int64 got, int64 want) {
    t.verdict(name: name, why: got == want ? "" : "got ${got}, want ${want}");
}

// What a game asks of its devices (the fifth part's question 3): whether each player is typing.
fn void requestCases(ref Tally t) {
    Requests r = Requests.make();
    t.verdict(name: "Requests: name no player at first", why: r.players() == 0 && !r.typing(player: 1) ? "" : "they do");
    r.reset(players: 2);
    r.setTyping(player: 2, on: true);
    t.verdict(name: "Requests: a player typing, the other not",
              why: r.players() == 2 && r.typing(player: 2) && !r.typing(player: 1) ? "" : "read wrong");
    t.verdict(name: "Requests: a player it does not name is not typing",
              why: !r.typing(player: 0) && !r.typing(player: 3) ? "" : "one is");
    Requests c = Requests.make();
    c.copyFrom(other: r);
    r.reset(players: 1);
    t.verdict(name: "Requests: reset turns every request off, sized anew",
              why: r.players() == 1 && !r.typing(player: 1) && !r.typing(player: 2) ? "" : "it did not");
    t.verdict(name: "Requests: a copy keeps what it copied", why: c.players() == 2 && c.typing(player: 2) ? "" : "it did not");
}

// One view as drawn for a player, Output's own state (design/input.md § Decided, 2026-11-26, the sixth part's question
// 1): by default it names no player and no view, over the whole window, its camera at rest with no projection; and two
// are the same only when every field is.
fn void viewCases(ref Tally t) {
    DrawnView v = DrawnView.default();
    bool rest = v.player == 0 && v.view == -1 && v.at.equals(other: Vec2.zero()) && v.span.equals(other: Vec2.one())
        && v.size.equals(other: Vec2.one()) && v.zone.equals(other: ZoneCoord.origin()) && v.position.equals(other: Vec3.zero())
        && v.rotation.w == 1.0 && v.rotation.x == 0.0 && v.viewFromClip.get(c: 2, r: 2) == 1.0
        && v.viewFromClip.get(c: 3, r: 2) == 0.0;
    t.verdict(name: "DrawnView: names no player and no view by default, over the whole window, its camera at rest",
              why: rest ? "" : "another default");
    DrawnView same = drawnView(player: 1, view: 0);
    DrawnView copied = same;
    t.verdict(name: "DrawnView: the same view drawn the same way is the same", why: same.sameAs(other: copied) ? "" : "it is not");
    DrawnView p = drawnView(player: 1, view: 0);
    p.player = 2;
    sameNot(t: t, field: "its player", a: same, b: p);
    DrawnView w = drawnView(player: 1, view: 0);
    w.view = 1;
    sameNot(t: t, field: "which view", a: same, b: w);
    DrawnView at = drawnView(player: 1, view: 0);
    at.at = Vec2.of(x: 0.5, y: 0.25);
    sameNot(t: t, field: "its corner", a: same, b: at);
    DrawnView span = drawnView(player: 1, view: 0);
    span.span = Vec2.of(x: 1.0, y: 0.5);
    sameNot(t: t, field: "its span", a: same, b: span);
    DrawnView size = drawnView(player: 1, view: 0);
    size.size = Vec2.of(x: 1440.0, y: 811.0);
    sameNot(t: t, field: "its size", a: same, b: size);
    DrawnView zone = drawnView(player: 1, view: 0);
    zone.zone = ZoneCoord.of(x: 3, y: 0, z: -1);
    sameNot(t: t, field: "its camera's zone", a: same, b: zone);
    DrawnView moved = drawnView(player: 1, view: 0);
    moved.position = Vec3.of(x: 0.0, y: 1.0, z: 6.0);
    sameNot(t: t, field: "its camera's position", a: same, b: moved);
    DrawnView turnedX = drawnView(player: 1, view: 0);
    turnedX.rotation = Quat.of(x: 0.125, y: 0.0, z: 0.0, w: 1.0);
    sameNot(t: t, field: "its camera's rotation, its x alone", a: same, b: turnedX);
    DrawnView turnedY = drawnView(player: 1, view: 0);
    turnedY.rotation = Quat.of(x: 0.0, y: 0.125, z: 0.0, w: 1.0);
    sameNot(t: t, field: "its camera's rotation, its y alone", a: same, b: turnedY);
    DrawnView turnedZ = drawnView(player: 1, view: 0);
    turnedZ.rotation = Quat.of(x: 0.0, y: 0.0, z: 0.125, w: 1.0);
    sameNot(t: t, field: "its camera's rotation, its z alone", a: same, b: turnedZ);
    DrawnView turnedW = drawnView(player: 1, view: 0);
    turnedW.rotation = Quat.of(x: 0.0, y: 0.0, z: 0.0, w: 0.5);
    sameNot(t: t, field: "its camera's rotation, its w alone", a: same, b: turnedW);
    DrawnView lens = drawnView(player: 1, view: 0);
    lens.viewFromClip = Mat4.scale(s: Vec3.of(x: 2.0, y: 1.0, z: 1.0));
    sameNot(t: t, field: "its projection", a: same, b: lens);
    DrawnView deep = drawnView(player: 1, view: 0);
    deep.viewFromClip = Mat4.translation(t: Vec3.of(x: 0.0, y: 0.0, z: -1.0));
    sameNot(t: t, field: "its projection's last column", a: same, b: deep);
}

// A view drawn for `player`: a HUD-sized view over the window's left half, its camera turned and placed in a zone.
fn DrawnView drawnView(int32 player, int32 view) {
    DrawnView v = DrawnView.default();
    v.player = player;
    v.view = view;
    v.at = Vec2.of(x: 0.0, y: 0.0);
    v.span = Vec2.of(x: 0.5, y: 1.0);
    v.size = Vec2.of(x: 1440.0, y: 810.0);
    v.zone = ZoneCoord.of(x: 2, y: 0, z: -1);
    v.position = Vec3.of(x: 0.0, y: 1.0, z: 5.0);
    v.rotation = Quat.of(x: 0.0, y: 0.0, z: 0.0, w: 1.0);
    return v;
}

fn void sameNot(ref Tally t, const ref string field, const ref DrawnView a, const ref DrawnView b) {
    t.verdict(name: "DrawnView: one drawn with another ${field} is another", why: a.sameAs(other: b) ? "the same" : "");
}

// The views the world drew after Output (the sixth part's question 1): one for each player and view, a later one
// replacing the earlier, reset with the players and copied whole.
fn void requestViewCases(ref Tally t) {
    Requests r = Requests.make();
    r.reset(players: 2);
    t.verdict(name: "Requests: hold no view at first", why: r.viewCount() == 0 ? "" : "they hold one");
    r.setView(view: drawnView(player: 1, view: 0));
    r.setView(view: drawnView(player: 1, view: 1));
    r.setView(view: drawnView(player: 2, view: 0));
    t.verdict(name: "Requests: a view for each player and view", why: r.viewCount() == 3 ? "" : "another count");
    DrawnView moved = drawnView(player: 1, view: 1);
    moved.position = Vec3.of(x: 9.0, y: 1.0, z: 5.0);
    r.setView(view: moved);
    Optional<DrawnView> got = r.viewOf(player: 1, view: 1);
    bool replaced = match (got) { case Some(value: v): v.position.x == 9.0; case None: false; };
    t.verdict(name: "Requests: a view drawn again for the same player and view replaces it",
              why: replaced && r.viewCount() == 3 ? "" : "it did not");
    Optional<DrawnView> other = r.viewOf(player: 2, view: 0);
    bool kept = match (other) { case Some(value: v): v.player == 2 && v.position.x == 0.0; case None: false; };
    t.verdict(name: "Requests: and the other player's same view is its own", why: kept ? "" : "it is not");
    DrawnView third = r.viewAt(index: 2);
    t.verdict(name: "Requests: its views in the order they were first drawn", why: third.player == 2 ? "" : "another order");
    Optional<DrawnView> none = r.viewOf(player: 2, view: 1);
    bool absent = match (none) { case Some(value: v): false; case None: true; };
    t.verdict(name: "Requests: a view not drawn is none", why: absent ? "" : "one was found");
    Requests c = Requests.make();
    c.copyFrom(other: r);
    Optional<DrawnView> copied = c.viewOf(player: 1, view: 1);
    bool whole = match (copied) { case Some(value: v): v.sameAs(other: moved); case None: false; };
    t.verdict(name: "Requests: a copy keeps every view drawn", why: whole && c.viewCount() == 3 ? "" : "it did not");
    r.reset(players: 1);
    t.verdict(name: "Requests: reset forgets every view", why: r.viewCount() == 0 ? "" : "it kept one");
}

// A player's text entry, Output's own state (design/input.md § Decided, 2026-11-25, the fifth part's question 3): by
// default it names no player and is off, so a prefab that lists it types nothing until an Output processor says so.
fn void textEntryCases(ref Tally t) {
    TextEntry e = TextEntry.default();
    t.verdict(name: "TextEntry: names no player and is off by default",
              why: e.player == 0 && !e.on ? "" : "player ${e.player}, on ${e.on}");
}

// A cursor's mode as its case name.
fn string modeWord(CursorMode m) { return match (m) { case Normal: "Normal"; case Hidden: "Hidden"; case Locked: "Locked"; }; }

// A `Cursor` read from `json`, or why not, as "refused: " and the reader's words.
fn string cursorRead(const ref string json) {
    Result<Cursor, Owned<Error>> read = deserializeJsonBuffer::<Cursor>(src: copy json, strict: true);
    match (give read) {
        case Ok(value: c): {
            int32 p = c.player;
            string m = modeWord(m: c.mode);
            return "player ${p} ${m}";
        }
        case Err(error: e): {
            string why = e.message();
            return "refused: " + why;
        }
    };
}

// The cursor's mode a game asks for a player, Output's own state (design/input.md § Decided, 2026-11-26, the sixth
// part's question 2): by default it names no player and asks `Normal`, so a prefab that lists it asks nothing until an
// Output processor says so; a record names its mode by case name, and a misspelling is refused with every name listed.
// A prefab naming no mode takes the default's through the loader, which spin's content holds.
fn void cursorCases(ref Tally t) {
    Cursor c = Cursor.default();
    string m = modeWord(m: c.mode);
    t.verdict(name: "Cursor: names no player and asks Normal by default", why: c.player == 0 && c.mode == CursorMode::Normal ? "" : "player ${c.player}, ${m}");
    string locked = cursorRead(json: "{ \"player\": 1, \"mode\": \"Locked\" }");
    t.verdict(name: "Cursor: a record names its mode by case name", why: locked == "player 1 Locked" ? "" : "read `${locked}`");
    string hidden = cursorRead(json: "{ \"player\": 2, \"mode\": \"Hidden\" }");
    t.verdict(name: "Cursor: each mode by its own name", why: hidden == "player 2 Hidden" ? "" : "read `${hidden}`");
    string wrong = cursorRead(json: "{ \"player\": 1, \"mode\": \"Lockd\" }");
    t.verdict(name: "Cursor: a misspelt mode is refused, every name listed",
              why: wrong.startsWith(prefix: "refused: ") && wrong.contains(substring: "Normal") && wrong.contains(substring: "Hidden")
                   && wrong.contains(substring: "Locked") ? "" : "read `${wrong}`");
}

// Each player's cursor mode a game asks (the sixth part's question 2): `Normal` until asked, the strongest ask since the
// reset kept whatever order the asks come in, `Normal` for a player it does not name, and reset and copied as the rest.
fn void requestCursorCases(ref Tally t) {
    Requests r = Requests.make();
    r.reset(players: 3);
    string first = modeWord(m: r.cursorMode(player: 1));
    t.verdict(name: "Requests: every player's cursor Normal until asked", why: first == "Normal" ? "" : "player 1 ${first}");
    r.askCursor(player: 1, mode: CursorMode::Hidden);
    r.askCursor(player: 1, mode: CursorMode::Normal);
    string kept = modeWord(m: r.cursorMode(player: 1));
    t.verdict(name: "Requests: a Normal ask after a Hidden one leaves it Hidden", why: kept == "Hidden" ? "" : "player 1 ${kept}");
    r.askCursor(player: 2, mode: CursorMode::Hidden);
    r.askCursor(player: 2, mode: CursorMode::Locked);
    string raised = modeWord(m: r.cursorMode(player: 2));
    t.verdict(name: "Requests: a Locked ask after a Hidden one makes it Locked", why: raised == "Locked" ? "" : "player 2 ${raised}");
    r.askCursor(player: 3, mode: CursorMode::Locked);
    r.askCursor(player: 3, mode: CursorMode::Hidden);
    string held = modeWord(m: r.cursorMode(player: 3));
    t.verdict(name: "Requests: a Hidden ask after a Locked one leaves it Locked", why: held == "Locked" ? "" : "player 3 ${held}");
    string beyond = modeWord(m: r.cursorMode(player: 4));
    string none = modeWord(m: r.cursorMode(player: 0));
    t.verdict(name: "Requests: a player it does not name is Normal", why: beyond == "Normal" && none == "Normal" ? "" : "${none} and ${beyond}");
    Requests c = Requests.make();
    c.copyFrom(other: r);
    string one = modeWord(m: c.cursorMode(player: 1));
    string two = modeWord(m: c.cursorMode(player: 2));
    t.verdict(name: "Requests: a copy keeps each player's cursor", why: one == "Hidden" && two == "Locked" ? "" : "${one} and ${two}");
    r.reset(players: 2);
    string back = modeWord(m: r.cursorMode(player: 2));
    t.verdict(name: "Requests: reset puts every cursor back to Normal", why: back == "Normal" ? "" : "player 2 ${back}");
}

// The game letting go of a player's pad lock, Output's own state (design/input.md § Decided, 2026-11-26, the sixth part's
// question 3): by default it names no player and holds on; and `Requests`' let-go, each player's apart, false for a
// player it does not name, reset and copied as the rest.
fn void padLockCases(ref Tally t) {
    PadLock l = PadLock.default();
    t.verdict(name: "PadLock: names no player and holds on by default", why: l.player == 0 && !l.letGo ? "" : "player ${l.player}, letGo ${l.letGo}");
    Requests r = Requests.make();
    r.reset(players: 2);
    t.verdict(name: "Requests: no player's pad let go until asked", why: !r.letsGo(player: 1) && !r.letsGo(player: 2) ? "" : "one is");
    r.setLetGo(player: 2, on: true);
    t.verdict(name: "Requests: a player's pad let go, the other's not", why: r.letsGo(player: 2) && !r.letsGo(player: 1) ? "" : "read wrong");
    t.verdict(name: "Requests: a player it does not name lets go of nothing", why: !r.letsGo(player: 0) && !r.letsGo(player: 3) ? "" : "one does");
    Requests c = Requests.make();
    c.copyFrom(other: r);
    t.verdict(name: "Requests: a copy keeps each let-go", why: c.letsGo(player: 2) && !c.letsGo(player: 1) ? "" : "it did not");
    r.reset(players: 2);
    t.verdict(name: "Requests: reset holds every pad on again", why: !r.letsGo(player: 2) ? "" : "player 2 still lets go");
}

fn void sampleCases(ref Tally t) {
    Sample key = Sample.make(device: Device::Keyboard, slot: 0, control: 82, value: 1.0, at: 1234);
    bool keyOk = key.kind == SampleKind::Control && key.device == Device::Keyboard && key.slot == 0 && key.control == 82
        && key.value == 1.0 && key.at == 1234;
    t.verdict(name: "Sample: a control's device, slot, number, value and time", why: keyOk ? "" : "a field differs");
    Sample on = Sample.padConnected(slot: 3, at: 50);
    Sample off = Sample.padDisconnected(slot: 3, at: 60);
    bool padOk = on.kind == SampleKind::Connected && off.kind == SampleKind::Disconnected && on.device == Device::Gamepad
        && off.device == Device::Gamepad && on.slot == 3 && off.slot == 3 && on.at == 50 && off.at == 60;
    t.verdict(name: "Sample: a pad's connection and disconnection, by slot, at their times", why: padOk ? "" : "a field differs");
    Sample across = Sample.cursorAt(index: 0, value: -0.25, at: 70);
    Sample upward = Sample.cursorAt(index: 1, value: 0.75, at: 71);
    bool placeOk = across.kind == SampleKind::Cursor && upward.kind == SampleKind::Cursor && across.device == Device::Mouse
        && across.control == 0 && upward.control == 1 && across.value == -0.25 && upward.value == 0.75 && across.at == 70
        && upward.at == 71;
    t.verdict(name: "Sample: the cursor's place, an axis and its value, at its time", why: placeOk ? "" : "a field differs");
    Sample held = Sample.cursorLock(locked: true, at: 80);
    Sample freed = Sample.cursorLock(locked: false, at: 81);
    bool lockOk = held.kind == SampleKind::Lock && freed.kind == SampleKind::Lock && held.device == Device::Mouse
        && held.value == 1.0 && freed.value == 0.0 && held.at == 80 && freed.at == 81;
    t.verdict(name: "Sample: the window's lock on the cursor, held or let go, at its time", why: lockOk ? "" : "a field differs");
}

fn void handoffCases(ref Tally t) {
    Handoff h = Handoff.make(players: 2, actions: twoDigital());
    bool sized = h.players() == 2 && h.digitalActions() == 2 && h.analogActions() == 0 && h.vector2Actions() == 0;
    t.verdict(name: "Handoff: room for its players and actions", why: sized ? "" : "another size");
    bool allOff = true;
    int32 p = 1;
    while (p <= 2) {
        int32 a = 0;
        while (a < 2) {
            if (spelled(d: h.digital(player: p, action: a)) != "---") { allOff = false; }
            a = a + 1;
        }
        p = p + 1;
    }
    t.verdict(name: "Handoff: every value off when made", why: allOff ? "" : "one is on");

    h.setDigital(player: 2, action: 0, value: digitalOf(held: true, pressed: true, released: false));
    expectSpelled(t: t, name: "Handoff: a value set is read back by its player and action", d: h.digital(player: 2, action: 0),
                  want: "HP-");
    expectSpelled(t: t, name: "Handoff: another player's same action is its own", d: h.digital(player: 1, action: 0), want: "---");
    expectSpelled(t: t, name: "Handoff: the same player's next action is its own", d: h.digital(player: 2, action: 1), want: "---");
    expectSpelled(t: t, name: "Handoff: player 0 is no player, off", d: h.digital(player: 0, action: 0), want: "---");
    expectSpelled(t: t, name: "Handoff: a player past its room, off", d: h.digital(player: 3, action: 0), want: "---");
    expectSpelled(t: t, name: "Handoff: an action past its room, off", d: h.digital(player: 2, action: 2), want: "---");
    expectSpelled(t: t, name: "Handoff: a negative action, off", d: h.digital(player: 2, action: -1), want: "---");
    h.clear();
    expectSpelled(t: t, name: "Handoff: clear turns every value off", d: h.digital(player: 2, action: 0), want: "---");
}

fn void valueHandoffCases(ref Tally t) {
    Handoff h = Handoff.make(players: 2, actions: everyKind());
    bool sized = h.digitalActions() == 1 && h.analogActions() == 2 && h.vector2Actions() == 3 && h.vector3Actions() == 1
        && h.poseActions() == 1;
    t.verdict(name: "Handoff: room for each kind's actions", why: sized ? "" : "another size");
    expectFloat(t: t, name: "Handoff: an analog is 0 when made", got: h.analog(player: 2, action: 1), want: 0.0);
    expectVec2(t: t, name: "Handoff: a vector2 is zero when made", got: h.vector2(player: 2, action: 1), x: 0.0, y: 0.0);
    t.verdict(name: "Handoff: a pose is at rest when made", why: atRest(p: h.pose(player: 1, action: 0)) ? "" : "it is not");

    h.setAnalog(player: 2, action: 1, value: 0.5);
    h.setVector2(player: 2, action: 0, value: Vec2.of(x: -1.0, y: 0.25));
    h.setVector3(player: 1, action: 0, value: Vec3.of(x: 1.0, y: 2.0, z: 3.0));
    h.setPose(player: 2, action: 0, value: poseAt(x: 4.0, y: 5.0, z: 6.0));
    expectFloat(t: t, name: "Handoff: an analog set is read back by its player and action", got: h.analog(player: 2, action: 1),
                want: 0.5);
    expectFloat(t: t, name: "Handoff: the same player's other analog is its own", got: h.analog(player: 2, action: 0), want: 0.0);
    expectFloat(t: t, name: "Handoff: another player's same analog is its own", got: h.analog(player: 1, action: 1), want: 0.0);
    expectVec2(t: t, name: "Handoff: a vector2 set is read back", got: h.vector2(player: 2, action: 0), x: -1.0, y: 0.25);
    expectVec2(t: t, name: "Handoff: its neighbour is its own", got: h.vector2(player: 2, action: 1), x: 0.0, y: 0.0);
    h.setVector2(player: 2, action: 2, value: Vec2.of(x: 7.0, y: 8.0));
    expectVec2(t: t, name: "Handoff: a kind's last action, for the last player, past every other kind's count",
               got: h.vector2(player: 2, action: 2), x: 7.0, y: 8.0);
    expectVec3(t: t, name: "Handoff: a vector3 set is read back", got: h.vector3(player: 1, action: 0), x: 1.0, y: 2.0, z: 3.0);
    expectVec3(t: t, name: "Handoff: another player's same vector3 is its own", got: h.vector3(player: 2, action: 0), x: 0.0,
               y: 0.0, z: 0.0);
    Pose hand = h.pose(player: 2, action: 0);
    t.verdict(name: "Handoff: a pose set is read back, its zone too",
              why: hand.position.z == 6.0 && hand.orientation.y == 1.0 && hand.zone.equals(other: ZoneCoord.of(x: 4, y: -2, z: 3))
                  ? "" : "another");
    expectFloat(t: t, name: "Handoff: an analog past its room is 0", got: h.analog(player: 2, action: 2), want: 0.0);
    expectVec2(t: t, name: "Handoff: a vector2 for player 0 is zero", got: h.vector2(player: 0, action: 0), x: 0.0, y: 0.0);
    expectVec3(t: t, name: "Handoff: a vector3 for a player past its room is zero", got: h.vector3(player: 3, action: 0),
               x: 0.0, y: 0.0, z: 0.0);
    t.verdict(name: "Handoff: a pose past its room is at rest", why: atRest(p: h.pose(player: 2, action: 1)) ? "" : "it is not");
    h.clear();
    expectFloat(t: t, name: "Handoff: clear sets every analog to 0", got: h.analog(player: 2, action: 1), want: 0.0);
    expectVec2(t: t, name: "Handoff: and every vector2 to zero", got: h.vector2(player: 2, action: 0), x: 0.0, y: 0.0);
    expectVec3(t: t, name: "Handoff: and every vector3", got: h.vector3(player: 1, action: 0), x: 0.0, y: 0.0, z: 0.0);
    t.verdict(name: "Handoff: and every pose at rest", why: atRest(p: h.pose(player: 2, action: 0)) ? "" : "one is not");
}

fn void playerActionCases(ref Tally t) {
    PlayerActions w = PlayerActions.make(players: 2, actions: twoDigital(), window: 4);
    Handoff h = Handoff.make(players: 2, actions: twoDigital());
    expectSpelled(t: t, name: "PlayerActions: every action off before its first hand-off",
                  d: w.digital(player: 1, action: 0, after: -1, upTo: 0), want: "---");

    // Step 10: player 1's action 0 pressed, player 2's action 1 held from before with no edge.
    h.setDigital(player: 1, action: 0, value: digitalOf(held: true, pressed: true, released: false));
    h.setDigital(player: 2, action: 1, value: digitalOf(held: true, pressed: false, released: false));
    w.take(handoff: h, step: 10);
    expectSpelled(t: t, name: "PlayerActions: a run at the base rate sees its own step's press",
                  d: w.digital(player: 1, action: 0, after: 9, upTo: 10), want: "HP-");
    expectSpelled(t: t, name: "PlayerActions: a held action with no edge reads held alone",
                  d: w.digital(player: 2, action: 1, after: 9, upTo: 10), want: "H--");
    expectSpelled(t: t, name: "PlayerActions: another player's same action is its own",
                  d: w.digital(player: 2, action: 0, after: 9, upTo: 10), want: "---");

    // Step 11: no edge, still held.
    h.clear();
    h.setDigital(player: 1, action: 0, value: digitalOf(held: true, pressed: false, released: false));
    w.take(handoff: h, step: 11);
    expectSpelled(t: t, name: "PlayerActions: the next step at the base rate sees the press no more",
                  d: w.digital(player: 1, action: 0, after: 10, upTo: 11), want: "H--");
    expectSpelled(t: t, name: "PlayerActions: a run every 4 steps, at step 12, sees step 10's press once",
                  d: w.digital(player: 1, action: 0, after: 8, upTo: 12), want: "HP-");
    expectSpelled(t: t, name: "PlayerActions: its window excludes the step it last ran on",
                  d: w.digital(player: 1, action: 0, after: 10, upTo: 12), want: "H--");

    // Step 12: released.
    h.clear();
    h.setDigital(player: 1, action: 0, value: digitalOf(held: false, pressed: false, released: true));
    w.take(handoff: h, step: 12);
    expectSpelled(t: t, name: "PlayerActions: a release at the base rate",
                  d: w.digital(player: 1, action: 0, after: 11, upTo: 12), want: "--R");
    expectSpelled(t: t, name: "PlayerActions: a slow run whose window holds both edges sees both, held as now",
                  d: w.digital(player: 1, action: 0, after: 8, upTo: 12), want: "-PR");
    expectSpelled(t: t, name: "PlayerActions: an Output whose window is empty sees no edge",
                  d: w.digital(player: 1, action: 0, after: 12, upTo: 12), want: "---");
    expectSpelled(t: t, name: "PlayerActions: player 0 is no player, off", d: w.digital(player: 0, action: 0, after: 8, upTo: 12),
                  want: "---");
    expectSpelled(t: t, name: "PlayerActions: an action past its room, off", d: w.digital(player: 1, action: 2, after: 8, upTo: 12),
                  want: "---");

    // A gesture's progress is a state, as of the last step taken (design/input.md § Decided, 2026-11-24, question 1).
    PlayerActions held = PlayerActions.make(players: 1, actions: twoDigital(), window: 4);
    Handoff part = Handoff.make(players: 1, actions: twoDigital());
    Digital under = Digital.off();
    under.progress = 0.25;
    part.setDigital(player: 1, action: 1, value: under);
    held.take(handoff: part, step: 0);
    under.progress = 0.75;
    part.setDigital(player: 1, action: 1, value: under);
    held.take(handoff: part, step: 1);
    float32 seen = held.digital(player: 1, action: 1, after: -1, upTo: 1).progress;
    t.verdict(name: "PlayerActions: a digital's progress is its last step's", why: seen == 0.75 ? "" : "${seen}");
    float32 other = held.digital(player: 1, action: 0, after: -1, upTo: 1).progress;
    t.verdict(name: "PlayerActions: another action's progress is its own", why: other == 0.0 ? "" : "${other}");

    // A run at a slower rate on step 0 has a window that starts before it (every 2 steps: after -2), and sees no press
    // or release that never was: found by the spin fixture's 30 Hz `tally`.
    PlayerActions fresh = PlayerActions.make(players: 1, actions: twoDigital(), window: 2);
    Handoff quiet = Handoff.make(players: 1, actions: twoDigital());
    fresh.take(handoff: quiet, step: 0);
    expectSpelled(t: t, name: "PlayerActions: a slower run's first window, reaching before step 0, sees no edge that never was",
                  d: fresh.digital(player: 1, action: 0, after: -2, upTo: 0), want: "---");
    expectSpelled(t: t, name: "PlayerActions: nor one reaching far before it",
                  d: fresh.digital(player: 1, action: 0, after: -1000000, upTo: 0), want: "---");
}

// Steps 0 to 2 of `everyKind`'s values for player 1: throttle 0.25, 0.75, 0.5 (a state); zoom 1, 2, 4 (a delta); move
// (0.5, -1) then (1, 0) (a state); look (2, 3), (10, 0), (0, 100) (a delta); fly (1, 1, 1) each step (a delta); and the
// hand at (1, 2, 3), then (7, 8, 9).
fn void stepOf(ref PlayerActions w, int64 step) {
    Handoff h = Handoff.make(players: 2, actions: everyKind());
    float32 throttle = step == 0 ? 0.25 : (step == 1 ? 0.75 : 0.5);
    float32 zoom = step == 0 ? 1.0 : (step == 1 ? 2.0 : 4.0);
    h.setAnalog(player: 1, action: 0, value: throttle);
    h.setAnalog(player: 1, action: 1, value: zoom);
    h.setVector2(player: 1, action: 0, value: step == 0 ? Vec2.of(x: 0.5, y: -1.0) : Vec2.of(x: 1.0, y: 0.0));
    Vec2 look = step == 0 ? Vec2.of(x: 2.0, y: 3.0) : (step == 1 ? Vec2.of(x: 10.0, y: 0.0) : Vec2.of(x: 0.0, y: 100.0));
    h.setVector2(player: 1, action: 1, value: look);
    h.setVector3(player: 1, action: 0, value: Vec3.of(x: 1.0, y: 1.0, z: 1.0));
    h.setPose(player: 1, action: 0, value: step == 0 ? poseAt(x: 1.0, y: 2.0, z: 3.0) : poseAt(x: 7.0, y: 8.0, z: 9.0));
    w.take(handoff: h, step: step);
}

fn void valuePlayerCases(ref Tally t) {
    PlayerActions small = PlayerActions.make(players: 1, actions: everyKind(), window: 2);
    int64 most = cast<int64>(Clock::DefaultMaxSteps);
    int64 keptSmall = small.kept();
    t.verdict(name: "PlayerActions: it keeps Output's window at least, the clock's most steps a frame",
              why: keptSmall == most ? "" : "kept ${keptSmall}");
    PlayerActions wide = PlayerActions.make(players: 1, actions: everyKind(), window: 12);
    int64 kept = wide.kept();
    t.verdict(name: "PlayerActions: and the widest window it is made for", why: kept == 12 ? "" : "kept ${kept}");

    PlayerActions w = PlayerActions.make(players: 2, actions: everyKind(), window: 4);
    bool sized = w.analogActions() == 2 && w.vector2Actions() == 3 && w.vector3Actions() == 1 && w.poseActions() == 1;
    t.verdict(name: "PlayerActions: room for each kind's actions", why: sized ? "" : "another size");
    expectFloat(t: t, name: "PlayerActions: a state is 0 before its first hand-off", got: w.analog(player: 1, action: 0,
                after: -1, upTo: 0), want: 0.0);
    expectVec2(t: t, name: "PlayerActions: a delta sums to zero before it", got: w.vector2(player: 1, action: 1, after: -2,
               upTo: 0), x: 0.0, y: 0.0);
    t.verdict(name: "PlayerActions: a pose is at rest before it", why: atRest(p: w.pose(player: 1, action: 0, upTo: 0)) ? "" : "not");

    stepOf(w: w, step: 0);
    stepOf(w: w, step: 1);
    stepOf(w: w, step: 2);
    expectFloat(t: t, name: "PlayerActions: a run at the base rate sees a state as of its step",
                got: w.analog(player: 1, action: 0, after: 1, upTo: 2), want: 0.5);
    expectFloat(t: t, name: "PlayerActions: and a slower run sees it as of its step too, not summed",
                got: w.analog(player: 1, action: 0, after: -2, upTo: 2), want: 0.5);
    expectFloat(t: t, name: "PlayerActions: a run at the base rate sees its step's delta",
                got: w.analog(player: 1, action: 1, after: 1, upTo: 2), want: 4.0);
    expectFloat(t: t, name: "PlayerActions: a run every 2 steps sees the sum of its two",
                got: w.analog(player: 1, action: 1, after: 0, upTo: 2), want: 6.0);
    expectFloat(t: t, name: "PlayerActions: a run every 4 steps, its window reaching before step 0, sums the steps taken",
                got: w.analog(player: 1, action: 1, after: -2, upTo: 2), want: 7.0);
    expectFloat(t: t, name: "PlayerActions: an Output whose window is empty sees no motion",
                got: w.analog(player: 1, action: 1, after: 2, upTo: 2), want: 0.0);
    expectFloat(t: t, name: "PlayerActions: a run reading an earlier step sees the state as of that step",
                got: w.analog(player: 1, action: 0, after: 0, upTo: 1), want: 0.75);
    expectVec2(t: t, name: "PlayerActions: a vector2 state as of its step", got: w.vector2(player: 1, action: 0, after: 0, upTo: 2),
               x: 1.0, y: 0.0);
    expectVec2(t: t, name: "PlayerActions: a vector2 delta summed, x and y alike",
               got: w.vector2(player: 1, action: 1, after: 0, upTo: 2), x: 10.0, y: 100.0);
    expectVec2(t: t, name: "PlayerActions: over every step taken", got: w.vector2(player: 1, action: 1, after: -1, upTo: 2),
               x: 12.0, y: 103.0);
    expectVec3(t: t, name: "PlayerActions: a vector3 delta summed", got: w.vector3(player: 1, action: 0, after: -1, upTo: 2),
               x: 3.0, y: 3.0, z: 3.0);
    Pose hand = w.pose(player: 1, action: 0, upTo: 2);
    t.verdict(name: "PlayerActions: a pose as of its step, its zone too",
              why: hand.position.x == 7.0 && hand.position.z == 9.0 && hand.zone.equals(other: ZoneCoord.of(x: 7, y: -2, z: 3))
                  ? "" : "another");
    Pose first = w.pose(player: 1, action: 0, upTo: 0);
    t.verdict(name: "PlayerActions: and as of an earlier step kept", why: first.position.y == 2.0 ? "" : "another");
    expectFloat(t: t, name: "PlayerActions: another player's delta is its own",
                got: w.analog(player: 2, action: 1, after: -1, upTo: 2), want: 0.0);
    expectFloat(t: t, name: "PlayerActions: an analog past its room is 0", got: w.analog(player: 1, action: 2, after: -1, upTo: 2),
                want: 0.0);
    expectVec2(t: t, name: "PlayerActions: a vector2 for player 0 is zero", got: w.vector2(player: 0, action: 1, after: -1, upTo: 2),
               x: 0.0, y: 0.0);
    expectFloat(t: t, name: "PlayerActions: a step not taken yet reads a state at rest",
                got: w.analog(player: 1, action: 0, after: 4, upTo: 5), want: 0.0);

    // The record keeps 5 steps here (Output's window), so steps 3 to 8 wrap it: a window reads its own steps alone.
    int64 s = 3;
    while (s <= 8) { stepOf(w: w, step: s); s = s + 1; }
    expectFloat(t: t, name: "PlayerActions: once it wraps, a window sums its own steps, none older",
                got: w.analog(player: 1, action: 1, after: 6, upTo: 8), want: 8.0);
    expectFloat(t: t, name: "PlayerActions: a window as wide as it keeps sums every step in it",
                got: w.analog(player: 1, action: 1, after: 3, upTo: 8), want: 20.0);
    expectFloat(t: t, name: "PlayerActions: a step it no longer keeps reads a state at rest",
                got: w.analog(player: 1, action: 0, after: 1, upTo: 2), want: 0.0);
    expectFloat(t: t, name: "PlayerActions: a window wider than it keeps sums the newest steps kept, as Output after steps run by hand",
                got: w.analog(player: 1, action: 1, after: -1, upTo: 8), want: 20.0);
    expectVec2(t: t, name: "PlayerActions: a vector2 delta too", got: w.vector2(player: 1, action: 1, after: -1, upTo: 8),
               x: 0.0, y: 500.0);
}

fn string schemeWord(Scheme s) { return match (s) { case KeyboardMouse: "KeyboardMouse"; case Gamepad: "Gamepad"; }; }

// Each player's active scheme in the hand-off and the world's record (the second part's question 1).
fn void schemeCases(ref Tally t) {
    Handoff h = Handoff.make(players: 2, actions: twoDigital());
    string first = schemeWord(s: h.scheme(player: 1));
    t.verdict(name: "Handoff: a player's scheme is KeyboardMouse until a pad drives them", why: first == "KeyboardMouse" ? "" : first);
    h.setScheme(player: 2, value: Scheme::Gamepad);
    string two = schemeWord(s: h.scheme(player: 2));
    string one = schemeWord(s: h.scheme(player: 1));
    t.verdict(name: "Handoff: a scheme set is read back by its player, the other's its own",
              why: two == "Gamepad" && one == "KeyboardMouse" ? "" : "player 2 ${two}, player 1 ${one}");
    string past = schemeWord(s: h.scheme(player: 3));
    t.verdict(name: "Handoff: a player past its room reads KeyboardMouse", why: past == "KeyboardMouse" ? "" : past);
    h.clear();
    string cleared = schemeWord(s: h.scheme(player: 2));
    t.verdict(name: "Handoff: clear sets every scheme back", why: cleared == "KeyboardMouse" ? "" : cleared);

    PlayerActions w = PlayerActions.make(players: 2, actions: twoDigital(), window: 1);
    t.verdict(name: "PlayerActions: a player is on KeyboardMouse before the first hand-off",
              why: w.inScheme(player: 1, scheme: Scheme::KeyboardMouse) && !w.inScheme(player: 1, scheme: Scheme::Gamepad) ? "" : "it is not");
    h.setScheme(player: 2, value: Scheme::Gamepad);
    w.take(handoff: h, step: 0);
    t.verdict(name: "PlayerActions: a step's hand-off sets each player's scheme",
              why: w.inScheme(player: 2, scheme: Scheme::Gamepad) && w.inScheme(player: 1, scheme: Scheme::KeyboardMouse) ? "" : "it did not");
    t.verdict(name: "PlayerActions: a row naming no player is in no scheme",
              why: !w.inScheme(player: 0, scheme: Scheme::KeyboardMouse) && !w.inScheme(player: 0, scheme: Scheme::Gamepad) ? "" : "it is in one");
    t.verdict(name: "PlayerActions: nor one past its room", why: !w.inScheme(player: 3, scheme: Scheme::KeyboardMouse) ? "" : "it is in one");
    h.setScheme(player: 2, value: Scheme::KeyboardMouse);
    w.take(handoff: h, step: 1);
    t.verdict(name: "PlayerActions: and the next step's sets it again", why: w.inScheme(player: 2, scheme: Scheme::KeyboardMouse) ? "" : "it did not");
}

fn void inputTests(ref Tally t) {
    schemeCases(t: t);
    digitalCases(t: t);
    actionListCases(t: t);
    poseCases(t: t);
    textEntryCases(t: t);
    cursorCases(t: t);
    textCases(t: t);
    textActionCases(t: t);
    requestCases(t: t);
    viewCases(t: t);
    requestViewCases(t: t);
    requestCursorCases(t: t);
    padLockCases(t: t);
    sampleCases(t: t);
    handoffCases(t: t);
    valueHandoffCases(t: t);
    playerActionCases(t: t);
    valuePlayerCases(t: t);
}
