{
  "name": "kyoten",
  "version": "0.1.0",
  "license": "MIT OR Apache-2.0",
  "kind": "library",
  "kama": ">=0.9.876",
  "reproducible-float": true,
  "cflags": [
    { "flag": "-Wframe-larger-than=32768", "compileFor": ["!OS_WINDOWS"] },
    { "flag": "-Werror=frame-larger-than", "compileFor": ["!OS_WINDOWS"] }
  ],
  "modules": {
    ".": { "visibility": "public" },
    "frame": { "visibility": "public", "importsOnly": [] },
    "world": { "visibility": "public", "importsOnly": ["std::math"] },
    "records": { "visibility": "public", "importsOnly": ["std::collections"] }
  }
}
