// kyoten::frame::Environment — what surrounds the world: the light from everywhere at once, and what is drawn behind
// everything (the first slice's step 9, KYR-9; rendering.md § Decided, 2026-11-07, question 2's first cut, and
// 2026-11-27, step 9's kyoten half). A world component: the world holds one, which its records declare
// (`"store": "World"`).
//
// Its code defaults add nothing: no ambient light, and black behind. The ambient light the default makeup holds comes
// from the engine's record laid over them, which a game patches field by field (step 9's kyoten half, question 4).
//
// It offers what `@kama/graphics` draws: an ambient light and a background colour. A sky image and fog (rendering's
// first cut) join with the rows that draw them (GFX-3).
//
// The frame tier's, beside `DrawnView`, since the frame-tier render list carries it as it is (step 9's kyoten half,
// question 1).

import { Color };

export { Environment };

@generate(Serializable, Deserializable)
type value Environment {
    // The ambient light's colour, in sRGB, and its strength: 0, none, in code.
    @field public Color ambient = Color.white();
    @field public float32 ambientIntensity = 0.0;
    // What is drawn behind everything, in sRGB.
    @field public Color background = Color.black();

    // No ambient light, and black behind.
    public default ctor make() { }
}
