// kyoten::frame's serial driver: the four phases, Input → Update → Constraints → Output, always in that order
// (frame-phases § Decided, question 1 and step 4 question 4).
//
// - **The world is a contract, and the driver is generic over it,** so each phase call is direct: kama's SPEC, "a
//   generic bounded by a contract calls each instance directly". The generated world implements it (step 5), and a
//   test hands in a world of its own.
// - **The world, the clock and the input are injected** (AGENTS.kyoten.md § Rules): `frame` takes all three, and owns
//   none.
// - **`step` runs one simulation step with no clock,** as a replay and a test do, handed its step's input: the clock is
//   off the deterministic path, and the hand-off is what a replay records (replay-and-determinism § Decided).
// - **`frame` runs Input, Update and Constraints once per step the clock owes, then Output once.** Each owed step is
//   handed the input that arrived by its end on the clock (`Clock.stepEnd`), and the frame's last owed step
//   everything that arrived up to the pump, so a frame's input is split across its steps by time and a frame that owes
//   none keeps its input for the next step (design/input.md § Decided, question 1). Output's `Time` carries the
//   frame's real dt and the last settled step (-1 before the first step settles), and Output is handed the source's
//   newest hand-off, as presentation reads take the newest sample each frame (frame-phases § Decided; the second part
//   of step 8).
// - **Left to their own steps:** rate gating and Constraints' iterations, inside the generated phase calls (step 5);
//   the parallel schedule, behind the `PARALLEL` flag, when a measured scene asks for it.
// - **The render fraction** is computed by the clock and returned by `frame`. Output's blend reaches it when rendering
//   question 4's hand-off is built (step 9); until then `output` takes only `Time`, as decided.

import { std::collections::DynamicArray, Time, Clock, Owed, Handoff, Sample };

export { World, InputSource, step, frame };

comptime int64 EVERYTHING = 9223372036854775807;

// What the driver runs: one call per phase, each handed its `Time`, Input its step's hand-off and Output the newest.
// Output reads the simulation and never writes it; the generated world holds that by handing Output's processors their
// components as `const ref` (step 5).
type contract World for value, resource {
    fn void input(const ref Time time, const ref Handoff handoff);
    fn void update(const ref Time time);
    fn void constraints(const ref Time time);
    fn void output(const ref Time time, const ref Handoff newest);
}

// What makes each owed step's hand-off: the engine's binder (`kyoten::input`), a replay's log, or a test's script.
type contract InputSource for resource {
    // The samples a platform handed in since the last frame, in the order of their times.
    fn void take(const ref DynamicArray<Sample> samples);
    // The hand-off of the step numbered `index`, from the input that arrived by `until` (inclusive, on the frame
    // timestamp's base) and was not handed off yet.
    fn const ref Handoff handoff(int64 index, int64 until);
    // What Output reads this frame, from every sample taken so far: each state as of the newest, each delta since the
    // last call (the mouse's motion since, and each control held times `seconds`, the frame's real seconds), every
    // `Digital` off, since Output reads a digital's edges by steps. A step's hand-off still holds every sample it takes.
    fn const ref Handoff newest(float32 seconds);
}

// One simulation step: Input, Update and Constraints, with the `Time` and the hand-off the caller hands in.
fn void step<W: World>(ref W world, const ref Time time, const ref Handoff handoff) {
    world.input(time: time, handoff: handoff);
    world.update(time: time);
    world.constraints(time: time);
}

// One display frame: asks the clock what `now` (the frame source's timestamp, in nanoseconds) owes, runs each owed
// step with its base `Time` and its hand-off from `source`, then Output once, and returns what the clock owed.
fn Owed frame<W: World, S: InputSource>(ref W world, ref Clock clock, ref S source, int64 now) {
    Owed owed = clock.advance(now: now);
    float32 dt = clock.dt();
    int64 i = 0;
    while (i < owed.steps) {
        int64 until = i == owed.steps - 1 ? EVERYTHING : clock.stepEnd(i: i);
        Time time = Time.of(dt: dt, step: owed.first + i);
        step(world: world, time: time, handoff: source.handoff(index: owed.first + i, until: until));
        i = i + 1;
    }
    Time shown = Time.of(dt: owed.frameDt, step: clock.settled() - 1);
    world.output(time: shown, newest: source.newest(seconds: owed.frameDt));
    return owed;
}
