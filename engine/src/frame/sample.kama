// kyoten::frame::Sample — one input from a device, as a platform hands it to the engine (the first slice's step 8,
// KYR-54). It names no window and no target: the open platforms make samples from `@kama/window`'s events, a console's
// platform from its own, and a test or a replay writes them by hand, so the module that binds them to actions
// (`kyoten::input`) reads one shape on every platform.
//
// - **A control is numbered as the web numbers it,** as `@kama/window` does: a key by its USB HID usage id (KeyA 4,
//   ArrowUp 82), a mouse button by the W3C's `button` (Left 0, Middle 1, Right 2), and a gamepad's button by the W3C
//   standard gamepad's index (South 0, RightShoulder 5).
// - **Its time is on the frame timestamp's base,** the nanoseconds `Platform.now()` counts, so the clock's steps split
//   a frame's input by it (design/input.md § Decided, question 1).
// - **A pad's connection is a sample too,** so a pad that disconnects lets player 1's lock go at its moment
//   (design/input.md § Decided, question 4).
// - **A control's edges and its values are apart** (the second part of step 8): `Control` is a key's, a mouse button's
//   or a pad button's down and up, from the window's events, so a press and its release between two pumps are both
//   kept; `Travel` is a pad button's travel and `Axis` a stick's, read from each reading of the pad at its time
//   (`@kama/window`'s `padAt`, WIN-28); and `Motion` the mouse's, a distance moved. Each value is as the device
//   reports it, right and down positive: the binder turns a Y over, since an action's up is positive (design/input.md
//   § Decided, the second part's question 2).
// - **Typed text is a sample of its own,** `Text`, a code point at a time (the fifth part of step 8): what a key typed,
//   an IME's committed word or an on-screen keyboard's keys, never an editing key, which is a `Control`.
// - **So is a key's system repeat,** `Repeat`: the operating system's own repeat of a key held, at the player's rate,
//   which a `repeat` on the system's repeats presses again on (a held erase).

export { Sample, SampleKind, Device };

// What a sample says: a control's edge, a pad button's travel, a stick's axis, the mouse's motion, a pad's connection,
// a code point typed, or a key's system repeat.
type enum SampleKind { Control, Travel, Axis, Motion, Connected, Disconnected, Text, Repeat, Cursor, Lock }

// Which kind of device it came from: the bindings record's keys.
type enum Device { Keyboard, Mouse, Gamepad }

type value Sample {
    public SampleKind kind;
    public Device device;
    // A gamepad's slot, as `@kama/window` numbers them; 0 for the keyboard and the mouse.
    public int32 slot;
    // The control, numbered as above: a stick's axis by the standard gamepad's index (LeftX 0, LeftY 1), the mouse's
    // motion 0 across and 1 down, a typed code point's Unicode scalar value; 0 for a connection.
    public int32 control;
    // An edge's or a button's travel, 0 up to 1 (1 down and 0 up for a key), an axis from -1 to 1, or a distance moved,
    // as the device reports it.
    public float32 value;
    // When it happened, in nanoseconds on the frame timestamp's base.
    public int64 at;

    // A control's value at a moment.
    public ctor make(Device device, int32 slot, int32 control, float32 value, int64 at) {
        this.kind = SampleKind::Control;
        this.device = device;
        this.slot = slot;
        this.control = control;
        this.value = value;
        this.at = at;
    }

    // The gamepad in `slot` connected.
    public ctor padConnected(int32 slot, int64 at) {
        this.kind = SampleKind::Connected;
        this.device = Device::Gamepad;
        this.slot = slot;
        this.control = 0;
        this.value = 0.0;
        this.at = at;
    }

    // The gamepad in `slot` disconnected, after an up for each of its controls held.
    public ctor padDisconnected(int32 slot, int64 at) {
        this.kind = SampleKind::Disconnected;
        this.device = Device::Gamepad;
        this.slot = slot;
        this.control = 0;
        this.value = 0.0;
        this.at = at;
    }

    // The pad in `slot`'s button `button` (the standard gamepad's index) at `value` of its travel, 0 to 1.
    public ctor padTravel(int32 slot, int32 button, float32 value, int64 at) {
        this.kind = SampleKind::Travel;
        this.device = Device::Gamepad;
        this.slot = slot;
        this.control = button;
        this.value = value;
        this.at = at;
    }

    // The pad in `slot`'s stick axis `index` (the standard gamepad's: LeftX 0, LeftY 1, RightX 2, RightY 3) at `value`,
    // -1 to 1, right and down positive.
    public ctor padAxis(int32 slot, int32 index, float32 value, int64 at) {
        this.kind = SampleKind::Axis;
        this.device = Device::Gamepad;
        this.slot = slot;
        this.control = index;
        this.value = value;
        this.at = at;
    }

    // `point` typed on the keyboard, an IME's word or an on-screen keyboard's keys (design/input.md § Decided,
    // 2026-11-25, the fifth part's question 1).
    public ctor typed(char point, int64 at) {
        this.kind = SampleKind::Text;
        this.device = Device::Keyboard;
        this.slot = 0;
        this.control = cast<int32>(point);
        this.value = 0.0;
        this.at = at;
    }

    // The key `key` (its USB HID usage id) repeated, held, as the operating system repeats it (design/input.md §
    // Decided, 2026-11-25, the fifth part).
    public ctor repeated(int32 key, int64 at) {
        this.kind = SampleKind::Repeat;
        this.device = Device::Keyboard;
        this.slot = 0;
        this.control = key;
        this.value = 1.0;
        this.at = at;
    }

    // The mouse moved `value` along `index` (0 across, right positive; 1 down the window, down positive): logical
    // pixels, or the raw counts while the cursor is locked, as `@kama/window` reports them.
    public ctor mouseMotion(int32 index, float32 value, int64 at) {
        this.kind = SampleKind::Motion;
        this.device = Device::Mouse;
        this.slot = 0;
        this.control = index;
        this.value = value;
        this.at = at;
    }

    // The cursor's place in the window, where a mouse event happened (design/input.md § Decided, 2026-11-26, the sixth
    // part's question 1): `index` 0 across, -1 at the window's left edge and 1 at its right; 1 up, -1 at its bottom
    // and 1 at its top.
    public ctor cursorAt(int32 index, float32 value, int64 at) {
        this.kind = SampleKind::Cursor;
        this.device = Device::Mouse;
        this.slot = 0;
        this.control = index;
        this.value = value;
        this.at = at;
    }

    // The window holding the cursor locked, or letting it go, whoever asked (the sixth part's question 2): its place
    // means nothing while it is locked.
    public ctor cursorLock(bool locked, int64 at) {
        this.kind = SampleKind::Lock;
        this.device = Device::Mouse;
        this.slot = 0;
        this.control = 0;
        this.value = locked ? 1.0 : 0.0;
        this.at = at;
    }
}
