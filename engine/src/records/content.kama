// kyoten::records — the content records whose shape is the engine's: the app and the bindings. A content file at the
// root of `content/` holds keyed sections (`{ "app": … }`, `{ "bindings": … }`, `{ "prefabs": … }`), read whole as
// kyoten::content's `ContentFile`, whose prefabs are kept as JSON since a game's components are its own (REFERENCE.md
// § Records and their files; components § Decided, the loader's question 2 of 2026-11-09).

import { std::collections::DynamicArray, std::collections::SortedMap, std::memory::Owned, std::memory::replace };

export { AppRecord, WindowRecord, BindingRecord, ControlEntry };

// The game's window: its size in logical pixels, which the engine's content sets (1280 x 720) and a game's app record
// lays its own over, field by field.
@generate(Serializable, Deserializable)
type value WindowRecord {
    @field(name: "width") Optional<int32> widthField = Optional::None;
    @field(name: "height") Optional<int32> heightField = Optional::None;

    public default ctor make() { }

    public const fn Optional<int32> width() { return this.widthField; }
    public const fn Optional<int32> height() { return this.heightField; }
}

@generate(Serializable, Deserializable)
type resource AppRecord {
    @field(name: "firstScene") Optional<string> firstSceneField = Optional::None;
    @field(name: "title") Optional<string> titleField = Optional::None;
    @field(name: "window") Optional<WindowRecord> windowField = Optional::None;
    @field(name: "note", default) string noteField = "";

    public default ctor make() { }

    // None: the only scene is the first.
    public const fn const ref Optional<string> firstScene() { return this.firstSceneField; }
    // None: the game's name.
    public const fn const ref Optional<string> title() { return this.titleField; }
    public const fn Optional<WindowRecord> window() { return this.windowField; }
    public const fn const ref string note() { return this.noteField; }
}

// One action's controls, keyed by device (design/input.md § Decided, question 2): `{ "keyboard": ["ArrowUp", "KeyW"],
// "gamepad": "RightShoulder" }`. A content layer that names a device replaces that device's entry whole and leaves the
// others, as every record merges, so a player rebinding the keyboard keeps the pad's.
@generate(Deserializable)
type resource BindingRecord {
    @field(name: "keyboard") Optional<ControlEntry> keyboardField = Optional::None;
    @field(name: "mouse") Optional<ControlEntry> mouseField = Optional::None;
    @field(name: "gamepad") Optional<ControlEntry> gamepadField = Optional::None;
    @field(name: "note", default) string noteField = "";

    public default ctor make() { }

    public const fn const ref Optional<ControlEntry> keyboard() { return this.keyboardField; }
    public const fn const ref Optional<ControlEntry> mouse() { return this.mouseField; }
    public const fn const ref Optional<ControlEntry> gamepad() { return this.gamepadField; }
    public const fn const ref string note() { return this.noteField; }

    // A higher content layer's binding of the same action laid over this one: each device `above` names replaces this
    // one's entry whole, and each it does not name is kept, as a file of the higher layer merged over this one would.
    public fn void takeEntriesFrom(BindingRecord above) {
        Optional<ControlEntry> none = Optional::None;
        Optional<ControlEntry> k = replace(place: above.keyboardField, with: give none);
        match (give k) { case Some(value: e): { this.keyboardField = Optional::Some(value: give e); } case None: { } };
        Optional<ControlEntry> none2 = Optional::None;
        Optional<ControlEntry> m = replace(place: above.mouseField, with: give none2);
        match (give m) { case Some(value: e): { this.mouseField = Optional::Some(value: give e); } case None: { } };
        Optional<ControlEntry> none3 = Optional::None;
        Optional<ControlEntry> g = replace(place: above.gamepadField, with: give none3);
        match (give g) { case Some(value: e): { this.gamepadField = Optional::Some(value: give e); } case None: { } };
    }
}

// A device's entry in a binding (design/input.md § Decided, question 2): a control's name (`"ArrowUp"`), a list of
// them (`["ArrowUp", "KeyW"]`), or an object with its parts (`{ "up": "KeyW", "down": ["KeyS", "ArrowDown"] }`, each a
// name or a list), its filters and its gestures. A name is `@kama/window`'s, which `kyoten::input` resolves, refusing
// one that names no control, and a part's word is the action kind's, which the binder holds to it. An object's
// `filters` and `gestures` are noted and their values passed over here: they are KYR-54's later parts, and the binder
// refuses them until they are built.
type resource ControlEntry implements Deserializable<This> {
    DynamicArray<string> namesField = DynamicArray.empty();
    bool listedField = false;
    bool objectField = false;
    SortedMap<string, DynamicArray<string>> partsField = SortedMap.empty();
    DynamicArray<string> stepsField = DynamicArray.empty();

    public ctor Result<ControlEntry, Owned<Error>> deserialize(Deserializer r) {
        ValueKind k = r.peekKind();
        if (r.failed()) { return Result::Err(error: DeError.make(kind: r.errorKind())); }
        match (k) {
            case String: {
                string one = r.readString();
                if (r.failed()) { return Result::Err(error: DeError.make(kind: r.errorKind())); }
                this.namesField.add(item: give one);
            }
            case Array: {
                this.listedField = true;
                r.beginArray();
                isize index = 0;
                while (r.moreElems()) {
                    string named = r.readString();
                    if (r.failed()) {
                        return Result::Err(error: DeError::inElement(error: DeError.make(kind: r.errorKind()), index: index));
                    }
                    this.namesField.add(item: give named);
                    index = index + 1;
                }
                if (r.failed()) { return Result::Err(error: DeError.make(kind: r.errorKind())); }
            }
            case Object: {
                this.objectField = true;
                r.beginObject(count: 0);
                while (r.moreFields()) {
                    FieldKey key = r.field();
                    string part = match (key) { case Name(name: n): copy n; case _: ""; };
                    if (part == "filters" || part == "gestures") {
                        this.stepsField.add(item: copy part);
                        r.skipValue();
                        continue;
                    }
                    if (this.partsField.contains(key: part)) {
                        r.duplicateKey();
                        if (r.failed()) { return Result::Err(error: DeError::inField(error: DeError.make(kind: r.errorKind()), name: give part)); }
                    }
                    DynamicArray<string> named = DynamicArray.empty();
                    ValueKind pk = r.peekKind();
                    match (pk) {
                        case String: { named.add(item: r.readString()); }
                        case Array: {
                            r.beginArray();
                            while (r.moreElems()) { named.add(item: r.readString()); }
                        }
                        case _: { r.failWith(kind: DeErrorKind::TypeMismatch); }
                    };
                    if (r.failed()) { return Result::Err(error: DeError::inField(error: DeError.make(kind: r.errorKind()), name: give part)); }
                    this.partsField.put(key: give part, value: give named);
                }
                r.endObject();
                if (r.failed()) { return Result::Err(error: DeError.make(kind: r.errorKind())); }
            }
            case _: {
                r.failWith(kind: DeErrorKind::TypeMismatch);
                return Result::Err(error: DeError.make(kind: r.errorKind()));
            }
        };
        return Result::Ok(value: give this);
    }

    // The controls' names, in the order written: one for a name, any number for a list, none for an object.
    public const fn const ref DynamicArray<string> names() { return this.namesField; }
    // Written as a list.
    public const fn bool listed() { return this.listedField; }
    // Written as an object, with parts, filters or gestures.
    public const fn bool isObject() { return this.objectField; }
    // An object's parts by their words, each its controls' names in the order written.
    public const fn const ref SortedMap<string, DynamicArray<string>> parts() { return this.partsField; }
    // The steps an object names, `filters` or `gestures`, which KYR-54's later parts read.
    public const fn const ref DynamicArray<string> steps() { return this.stepsField; }
}
