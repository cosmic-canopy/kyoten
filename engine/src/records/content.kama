// kyoten::records — the content records whose shape is the engine's: the app and the bindings. A content file at the
// root of `content/` holds keyed sections (`{ "app": … }`, `{ "bindings": … }`, `{ "prefabs": … }`), read whole as
// kyoten::content's `ContentFile`, whose prefabs are kept as JSON since a game's components are its own (REFERENCE.md
// § Records and their files; components § Decided, the loader's question 2 of 2026-11-09).

import { std::collections::DynamicArray, std::collections::SortedMap, std::memory::Owned, std::memory::replace };

export { AppRecord, WindowRecord, BindingRecord, ControlEntry, FilterRecord, FilterKind, DeadZoneShape, InputRecord, ZoneRecord,
         GestureRecord, GestureKind, GestureTimes, GestureName,
         PressRecord };

// The game's window: its size in logical pixels, which the engine's content sets (1280 x 720) and a game's app record
// lays its own over, field by field.
@generate(Serializable, Deserializable)
type value WindowRecord {
    @field(name: "width") Optional<int32> widthField = Optional::None;
    @field(name: "height") Optional<int32> heightField = Optional::None;

    public default ctor make() { }

    public const fn Optional<int32> width() { return this.widthField; }
    public const fn Optional<int32> height() { return this.heightField; }
}

@generate(Serializable, Deserializable)
type resource AppRecord {
    @field(name: "firstScene") Optional<string> firstSceneField = Optional::None;
    @field(name: "title") Optional<string> titleField = Optional::None;
    @field(name: "window") Optional<WindowRecord> windowField = Optional::None;
    @field(name: "note", default) string noteField = "";

    public default ctor make() { }

    // None: the only scene is the first.
    public const fn const ref Optional<string> firstScene() { return this.firstSceneField; }
    // None: the game's name.
    public const fn const ref Optional<string> title() { return this.titleField; }
    public const fn Optional<WindowRecord> window() { return this.windowField; }
    public const fn const ref string note() { return this.noteField; }
}

// One action's controls, keyed by device (design/input.md § Decided, question 2): `{ "keyboard": ["ArrowUp", "KeyW"],
// "gamepad": "RightShoulder" }`. A content layer that names a device replaces that device's entry whole and leaves the
// others, as every record merges, so a player rebinding the keyboard keeps the pad's.
@generate(Deserializable)
type resource BindingRecord {
    @field(name: "keyboard") Optional<ControlEntry> keyboardField = Optional::None;
    @field(name: "mouse") Optional<ControlEntry> mouseField = Optional::None;
    @field(name: "gamepad") Optional<ControlEntry> gamepadField = Optional::None;
    @field(name: "note", default) string noteField = "";

    public default ctor make() { }

    public const fn const ref Optional<ControlEntry> keyboard() { return this.keyboardField; }
    public const fn const ref Optional<ControlEntry> mouse() { return this.mouseField; }
    public const fn const ref Optional<ControlEntry> gamepad() { return this.gamepadField; }
    public const fn const ref string note() { return this.noteField; }

    // A higher content layer's binding of the same action laid over this one: each device `above` names replaces this
    // one's entry whole, and each it does not name is kept, as a file of the higher layer merged over this one would.
    public fn void takeEntriesFrom(BindingRecord above) {
        Optional<ControlEntry> none = Optional::None;
        Optional<ControlEntry> k = replace(place: above.keyboardField, with: give none);
        match (give k) { case Some(value: e): { this.keyboardField = Optional::Some(value: give e); } case None: { } };
        Optional<ControlEntry> none2 = Optional::None;
        Optional<ControlEntry> m = replace(place: above.mouseField, with: give none2);
        match (give m) { case Some(value: e): { this.mouseField = Optional::Some(value: give e); } case None: { } };
        Optional<ControlEntry> none3 = Optional::None;
        Optional<ControlEntry> g = replace(place: above.gamepadField, with: give none3);
        match (give g) { case Some(value: e): { this.gamepadField = Optional::Some(value: give e); } case None: { } };
    }
}

// A device's entry in a binding (design/input.md § Decided, question 2): a control's name (`"ArrowUp"`), a list of
// them (`["ArrowUp", "KeyW"]`), or an object with its parts (`{ "up": "KeyW", "down": ["KeyS", "ArrowDown"] }`, each a
// name or a list), its filters and its gestures. A name is `@kama/window`'s, which `kyoten::input` resolves, refusing
// one that names no control, and a part's word is the action kind's, which the binder holds to it.
// - **`filters`** (the third part, design/input.md § Decided, 2026-11-23) is a list, applied in the order written, each
//   an object of one key naming the filter: `{ "deadZone": 0.2 }`, `{ "scale": { "x": 3.2, "y": 2.2 } }`. A filter or
//   a parameter misspelt is refused here, naming every one, so the `kyoten` tool refuses it at build; a value out of its
//   range is the binder's to refuse, at load, naming the action.
// - **`gestures`** (the fourth part, design/input.md § Decided, 2026-11-24) is a list, applied in the order written after
//   the filters, each an object of one key naming the gesture: `{ "hold": 0.5 }`, `{ "multiTap": { "count": 3 } }`. A
//   gesture or a parameter misspelt is refused here, naming every one, so the `kyoten` tool refuses it at build; a time
//   out of its range is the binder's to refuse, at load, naming the action.
// - **`typing`** (the fifth part, design/input.md § Decided, 2026-11-25, question 4): `true` on a keyboard entry that
//   drives its action while its player types, an erase, a submit or a cancel; every other keyboard entry is held back
//   meanwhile. False where unwritten.
type resource ControlEntry implements Deserializable<This> {
    DynamicArray<string> namesField = DynamicArray.empty();
    bool listedField = false;
    bool objectField = false;
    SortedMap<string, DynamicArray<string>> partsField = SortedMap.empty();
    DynamicArray<GestureRecord> gesturesField = DynamicArray.empty();
    // The names chords and sequences list, each marked a control's or an action's and with its step.
    DynamicArray<string> gestureNamesField = DynamicArray.empty();
    DynamicArray<GestureName> gestureMarksField = DynamicArray.empty();
    bool gesturesRead = false;
    DynamicArray<FilterRecord> filtersField = DynamicArray.empty();
    DynamicArray<float32> pointsField = DynamicArray.empty();
    bool filtersRead = false;
    bool typingField = false;
    bool typingRead = false;

    public ctor Result<ControlEntry, Owned<Error>> deserialize(Deserializer r) {
        ValueKind k = r.peekKind();
        if (r.failed()) { return Result::Err(error: DeError.make(kind: r.errorKind())); }
        match (k) {
            case String: {
                string one = r.readString();
                if (r.failed()) { return Result::Err(error: DeError.make(kind: r.errorKind())); }
                this.namesField.add(item: give one);
            }
            case Array: {
                this.listedField = true;
                r.beginArray();
                isize index = 0;
                while (r.moreElems()) {
                    string named = r.readString();
                    if (r.failed()) {
                        return Result::Err(error: DeError::inElement(error: DeError.make(kind: r.errorKind()), index: index));
                    }
                    this.namesField.add(item: give named);
                    index = index + 1;
                }
                if (r.failed()) { return Result::Err(error: DeError.make(kind: r.errorKind())); }
            }
            case Object: {
                this.objectField = true;
                r.beginObject(count: 0);
                while (r.moreFields()) {
                    FieldKey key = r.field();
                    string part = match (key) { case Name(name: n): copy n; case _: ""; };
                    if (part == "gestures") {
                        if (this.gesturesRead) {
                            r.duplicateKey();
                            if (r.failed()) { return Result::Err(error: DeError::inField(error: DeError.make(kind: r.errorKind()), name: "gestures")); }
                        }
                        ValueKind gk = r.peekKind();
                        bool listOf = match (gk) { case Array: true; case _: false; };
                        if (!listOf) {
                            r.failWith(kind: DeErrorKind::TypeMismatch);
                            return Result::Err(error: DeError::inField(error: DeError.make(kind: r.errorKind()), name: "gestures"));
                        }
                        this.gesturesRead = true;
                        r.beginArray();
                        isize at = 0;
                        while (r.moreElems()) {
                            Result<GestureRecord, Owned<Error>> one = readGesture(r: r, names: this.gestureNamesField, marks: this.gestureMarksField);
                            match (give one) {
                                case Ok(value: g): { this.gesturesField.add(item: g); }
                                case Err(error: e): {
                                    return Result::Err(error: DeError::inField(error: DeError::inElement(error: give e, index: at), name: "gestures"));
                                }
                            };
                            at = at + 1;
                        }
                        if (r.failed()) { return Result::Err(error: DeError::inField(error: DeError.make(kind: r.errorKind()), name: "gestures")); }
                        continue;
                    }
                    if (part == "filters") {
                        if (this.filtersRead) {
                            r.duplicateKey();
                            if (r.failed()) { return Result::Err(error: DeError::inField(error: DeError.make(kind: r.errorKind()), name: "filters")); }
                        }
                        ValueKind fk = r.peekKind();
                        bool list = match (fk) { case Array: true; case _: false; };
                        if (!list) {
                            r.failWith(kind: DeErrorKind::TypeMismatch);
                            return Result::Err(error: DeError::inField(error: DeError.make(kind: r.errorKind()), name: "filters"));
                        }
                        this.filtersRead = true;
                        r.beginArray();
                        isize index = 0;
                        while (r.moreElems()) {
                            Result<FilterRecord, Owned<Error>> one = readFilter(r: r, points: this.pointsField);
                            match (give one) {
                                case Ok(value: f): { this.filtersField.add(item: f); }
                                case Err(error: e): {
                                    return Result::Err(error: DeError::inField(error: DeError::inElement(error: give e, index: index), name: "filters"));
                                }
                            };
                            index = index + 1;
                        }
                        if (r.failed()) { return Result::Err(error: DeError::inField(error: DeError.make(kind: r.errorKind()), name: "filters")); }
                        continue;
                    }
                    if (part == "typing") {
                        if (this.typingRead) {
                            r.duplicateKey();
                            if (r.failed()) { return Result::Err(error: DeError::inField(error: DeError.make(kind: r.errorKind()), name: "typing")); }
                        }
                        this.typingRead = true;
                        this.typingField = r.readBool();
                        if (r.failed()) { return Result::Err(error: DeError::inField(error: DeError.make(kind: r.errorKind()), name: "typing")); }
                        continue;
                    }
                    if (this.partsField.contains(key: part)) {
                        r.duplicateKey();
                        if (r.failed()) { return Result::Err(error: DeError::inField(error: DeError.make(kind: r.errorKind()), name: give part)); }
                    }
                    DynamicArray<string> named = DynamicArray.empty();
                    ValueKind pk = r.peekKind();
                    match (pk) {
                        case String: { named.add(item: r.readString()); }
                        case Array: {
                            r.beginArray();
                            while (r.moreElems()) { named.add(item: r.readString()); }
                        }
                        case _: { r.failWith(kind: DeErrorKind::TypeMismatch); }
                    };
                    if (r.failed()) { return Result::Err(error: DeError::inField(error: DeError.make(kind: r.errorKind()), name: give part)); }
                    this.partsField.put(key: give part, value: give named);
                }
                r.endObject();
                if (r.failed()) { return Result::Err(error: DeError.make(kind: r.errorKind())); }
            }
            case _: {
                r.failWith(kind: DeErrorKind::TypeMismatch);
                return Result::Err(error: DeError.make(kind: r.errorKind()));
            }
        };
        return Result::Ok(value: give this);
    }

    // The controls' names, in the order written: one for a name, any number for a list, none for an object.
    public const fn const ref DynamicArray<string> names() { return this.namesField; }
    // Written as a list.
    public const fn bool listed() { return this.listedField; }
    // Written as an object, with parts, filters or gestures.
    public const fn bool isObject() { return this.objectField; }
    // An object's parts by their words, each its controls' names in the order written.
    public const fn const ref SortedMap<string, DynamicArray<string>> parts() { return this.partsField; }
    // Its gestures, in the order written.
    public const fn const ref DynamicArray<GestureRecord> gestures() { return this.gesturesField; }
    // The names its chords and sequences list: a gesture's are `gestureNames()[namesFrom]` up to `[namesTo]`, each marked
    // in `gestureMarks()` alike.
    public const fn const ref DynamicArray<string> gestureNames() { return this.gestureNamesField; }
    public const fn const ref DynamicArray<GestureName> gestureMarks() { return this.gestureMarksField; }
    // Its filters, in the order written.
    public const fn const ref DynamicArray<FilterRecord> filters() { return this.filtersField; }
    // Every curve's points, in pairs (in, out): a curve's are `curvePoints()[pointsFrom]` up to `[pointsTo]`.
    public const fn const ref DynamicArray<float32> curvePoints() { return this.pointsField; }
    // Whether it drives its action while its player types: an object's `"typing": true`.
    public const fn bool typing() { return this.typingField; }
}

// What a filter does to a value (design/input.md § Decided, 2026-11-23, the third part).
type enum FilterKind { DeadZone, Scale, Invert, Curve, Clamp, Remap, Normalize, Digital, Smooth, Threshold }

// A dead zone's shape: on the value's length, keeping its direction (Unity's stick dead zone, Unreal's Radial,
// Sutphin's scaled radial), or on each axis apart (Unreal's Axial, FFD's).
@generate(Deserializable)
type enum DeadZoneShape { Radial, Axial }

// One filter as a device's entry lists it. Its numbers, by kind:
// - `DeadZone`: `a` its lower end, `b` its upper (1); `radial` (true; false: each axis apart) and `scaled` (true: what
//   is between rescaled from 0 to 1; false: kept as it is, Unreal's UnscaledRadial, leafwing's exclusion);
// - `Scale`, `Curve`'s exponents and `Invert`: `a`, `b`, `c` for x, y and z (1; invert's -1 for an axis turned over);
// - `Curve`'s points, where `points`: its entry's `curvePoints()` from `pointsFrom` up to `pointsTo`, in pairs;
// - `Clamp`: `a` its least (where `hasA`) and `b` its most (where `hasB`) on each axis, or `c` the longest length (where
//   `byLength`);
// - `Remap`: `a` to `b` onto `c` to `d`, on each axis;
// - `Normalize` and `Digital`: `on` (false where written `false`: it does nothing);
// - `Smooth`: `a`, its time in seconds;
// - `Threshold`: `a` where it presses, `b` where it lets go (where `hasB`; else three quarters of `a`).
type value FilterRecord {
    public FilterKind kind;
    public float32 a = 0.0;
    public float32 b = 0.0;
    public float32 c = 0.0;
    public float32 d = 0.0;
    public bool radial = true;
    public bool scaled = true;
    public bool hasA = false;
    public bool hasB = false;
    public bool byLength = false;
    public bool points = false;
    public bool on = true;
    public isize pointsFrom = 0;
    public isize pointsTo = 0;

    public ctor make(FilterKind kind) { this.kind = kind; }
}

// Two numbers written `[a, b]`: a curve's point, its input and its output, or a remap's range.
type value NumberPair implements Deserializable<This> {
    public float32 first = 0.0;
    public float32 second = 0.0;

    public ctor of(float32 first, float32 second) {
        this.first = first;
        this.second = second;
    }

    public ctor Result<NumberPair, Owned<Error>> deserialize(Deserializer r) {
        ValueKind k = r.peekKind();
        if (!isKind(k: k, want: ValueKind::Array)) {
            r.failWith(kind: DeErrorKind::TypeMismatch);
            return Result::Err(error: DeError.make(kind: DeErrorKind::TypeMismatch));
        }
        r.beginArray();
        isize n = 0;
        while (r.moreElems()) {
            float32 v = r.readF32();
            if (n == 0) { this.first = v; } else if (n == 1) { this.second = v; }
            n = n + 1;
        }
        if (r.failed()) { return Result::Err(error: DeError.make(kind: r.errorKind())); }
        if (n > 2) { return Result::Err(error: DeError.make(kind: DeErrorKind::TooMany)); }
        if (n < 2) { return Result::Err(error: DeError.make(kind: DeErrorKind::MissingField)); }
        return Result::Ok(value: this);
    }
}

// `{ "deadZone": { … } }`'s parameters.
@generate(Deserializable)
type value DeadZoneParams {
    @field(name: "lower", default) public float32 lower = 0.0;
    @field(name: "upper", default) public float32 upper = 1.0;
    @field(name: "shape", default) public DeadZoneShape shape = DeadZoneShape::Radial;
    @field(name: "scaled", default) public bool scaled = true;
    public default ctor make() { }
}

// A number per axis: `scale`'s factors and `curve`'s exponents, each 1 where unnamed.
@generate(Deserializable)
type value AxesParams {
    @field(name: "x", default) public float32 x = 1.0;
    @field(name: "y", default) public float32 y = 1.0;
    @field(name: "z", default) public float32 z = 1.0;
    public default ctor make() { }
}

// `{ "curve": { … } }`'s parameters: an exponent per axis, or a curve through points.
@generate(Deserializable)
type resource CurveParams {
    @field(name: "x", default) float32 xField = 1.0;
    @field(name: "y", default) float32 yField = 1.0;
    @field(name: "z", default) float32 zField = 1.0;
    @field(name: "points", default) DynamicArray<NumberPair> pointsField = DynamicArray.empty();
    public default ctor make() { }

    public const fn float32 x() { return this.xField; }
    public const fn float32 y() { return this.yField; }
    public const fn float32 z() { return this.zField; }
    public const fn const ref DynamicArray<NumberPair> points() { return this.pointsField; }
}

// `{ "invert": { … } }`'s parameters: the axes turned over, each named true.
@generate(Deserializable)
type value InvertParams {
    @field(name: "x", default) public bool x = false;
    @field(name: "y", default) public bool y = false;
    @field(name: "z", default) public bool z = false;
    public default ctor make() { }
}

// `{ "clamp": { … } }`'s parameters: each axis's least and most, or the longest length.
@generate(Deserializable)
type value ClampParams {
    @field(name: "min", default) public Optional<float32> min = Optional::None;
    @field(name: "max", default) public Optional<float32> max = Optional::None;
    @field(name: "length", default) public Optional<float32> length = Optional::None;
    public default ctor make() { }
}

// `{ "remap": { "from": [a, b], "to": [c, d] } }`.
@generate(Deserializable)
type value RemapParams {
    @field(name: "from") public NumberPair from;
    @field(name: "to") public NumberPair to;
    public default ctor make() {
        this.from = NumberPair.of(first: 0.0, second: 1.0);
        this.to = NumberPair.of(first: 0.0, second: 1.0);
    }
}

// `{ "threshold": { … } }`'s parameters.
@generate(Deserializable)
type value ThresholdParams {
    @field(name: "press") public float32 press = 0.5;
    @field(name: "release", default) public Optional<float32> release = Optional::None;
    public default ctor make() { }
}

// What a gesture recognizes (design/input.md § Decided, 2026-11-24, the fourth part).
type enum GestureKind { Hold, Tap, LongTap, MultiTap, Repeat, Toggle, Delay, Chord, Sequence, Interruptible }

// One gesture as a device's entry lists it. Its numbers, by kind, each time in seconds:
// - `Hold`, `Tap` and `LongTap`: `a` its time, where `hasA` (else the `input` record's);
// - `MultiTap`: `count` its taps (2), `a` the time each tap is let go within, where `hasA`, and `b` the gap the next
//   press comes within, where `hasB`;
// - `Repeat`: `a` the delay before its second press, where `hasA`, `b` the time between the next ones, where `hasB`,
//   and `count` the most presses it makes, 0 for no limit; `system`, true where it presses again on the system's own
//   repeats of a key instead, at the player's rate;
// - `Toggle`: `on`, false where written `false`, when it passes its input on as it is;
// - `Delay`: `a` how much later its input's on comes, and `b` how much later its off;
// - `Chord`: the names it holds, its entry's `gestureNames()` from `namesFrom` up to `namesTo`, each a control or an
//   action, all of which must be held; `masks`, false where it lets the control's other bindings see its press;
// - `Sequence`: its steps, `count` of them, by those names, each marked with its step (a step may name several
//   controls, any of which counts); `a` the time each comes within, where `hasA` (else the `input` record's `gap`); and
//   `masks`;
// - `Interruptible`: `on`, false where written `false`, which the binder refuses.
type value GestureRecord {
    public GestureKind kind;
    public float64 a = 0.0;
    public float64 b = 0.0;
    public bool hasA = false;
    public bool hasB = false;
    public int32 count = 0;
    public bool on = true;
    public isize namesFrom = 0;
    public isize namesTo = 0;
    public bool masks = true;
    public bool system = false;

    public ctor make(GestureKind kind) { this.kind = kind; }
}

// How a chord or a sequence lists one name: an action's, where `action`, else a control's; and the step it is of.
type value GestureName {
    public bool action = false;
    public int32 step = 0;

    public ctor make(bool action, int32 step) {
        this.action = action;
        this.step = step;
    }
}

// `{ "hold": { … } }`'s, `tap`'s and `longTap`'s parameters: its time, the `input` record's where unnamed.
@generate(Deserializable)
type value TimeParams {
    @field(name: "seconds", default) public Optional<float64> seconds = Optional::None;
    public default ctor make() { }
}

// `{ "multiTap": { … } }`'s parameters.
@generate(Deserializable)
type value MultiTapParams {
    @field(name: "count", default) public int32 count = 2;
    @field(name: "tap", default) public Optional<float64> tap = Optional::None;
    @field(name: "gap", default) public Optional<float64> gap = Optional::None;
    public default ctor make() { }
}

// `{ "repeat": { … } }`'s parameters.
@generate(Deserializable)
type value RepeatParams {
    @field(name: "delay", default) public Optional<float64> delay = Optional::None;
    @field(name: "every", default) public Optional<float64> every = Optional::None;
    @field(name: "limit", default) public int32 limit = 0;
    @field(name: "system", default) public bool system = false;
    public default ctor make() { }
}

// `{ "delay": { … } }`'s parameters.
@generate(Deserializable)
type value DelayParams {
    @field(name: "start", default) public float64 start = 0.0;
    @field(name: "end", default) public float64 end = 0.0;
    public default ctor make() { }
}

// The gestures' default times in the `input` record, in seconds, each laid over the layer below's on its own. A time no
// layer names is none, and a gesture that names none of its own is refused at load.
@generate(Deserializable)
type value GestureTimes {
    @field(name: "hold", default) public Optional<float64> hold = Optional::None;
    @field(name: "tap", default) public Optional<float64> tap = Optional::None;
    @field(name: "longTap", default) public Optional<float64> longTap = Optional::None;
    @field(name: "gap", default) public Optional<float64> gap = Optional::None;
    @field(name: "repeatDelay", default) public Optional<float64> repeatDelay = Optional::None;
    @field(name: "repeatEvery", default) public Optional<float64> repeatEvery = Optional::None;
    public default ctor make() { }

    public fn void layOver(GestureTimes above) {
        match (above.hold) { case Some(value: v): { this.hold = Optional::Some(value: v); } case None: { } };
        match (above.tap) { case Some(value: v): { this.tap = Optional::Some(value: v); } case None: { } };
        match (above.longTap) { case Some(value: v): { this.longTap = Optional::Some(value: v); } case None: { } };
        match (above.gap) { case Some(value: v): { this.gap = Optional::Some(value: v); } case None: { } };
        match (above.repeatDelay) { case Some(value: v): { this.repeatDelay = Optional::Some(value: v); } case None: { } };
        match (above.repeatEvery) { case Some(value: v): { this.repeatEvery = Optional::Some(value: v); } case None: { } };
    }
}

// A dead zone's defaults in the `input` record, each part laid over the layer below's on its own, so a game's
// `{ "lower": 0.2 }` keeps the engine's upper end. A part no layer names takes a `deadZone` filter's own default.
@generate(Deserializable)
type value ZoneRecord {
    @field(name: "lower", default) public Optional<float32> lower = Optional::None;
    @field(name: "upper", default) public Optional<float32> upper = Optional::None;
    @field(name: "shape", default) public Optional<DeadZoneShape> shape = Optional::None;
    @field(name: "scaled", default) public Optional<bool> scaled = Optional::None;
    public default ctor make() { }

    // `above`'s parts laid over this one's.
    public fn void layOver(ZoneRecord above) {
        match (above.lower) { case Some(value: v): { this.lower = Optional::Some(value: v); } case None: { } };
        match (above.upper) { case Some(value: v): { this.upper = Optional::Some(value: v); } case None: { } };
        match (above.shape) { case Some(value: v): { this.shape = Optional::Some(value: v); } case None: { } };
        match (above.scaled) { case Some(value: v): { this.scaled = Optional::Some(value: v); } case None: { } };
    }

    // The dead zone it makes: lower 0, upper 1, radial and scaled where a part is unnamed.
    public const fn FilterRecord filter() {
        FilterRecord f = FilterRecord.make(kind: FilterKind::DeadZone);
        f.b = 1.0;
        match (this.lower) { case Some(value: v): { f.a = v; } case None: { } };
        match (this.upper) { case Some(value: v): { f.b = v; } case None: { } };
        match (this.shape) { case Some(value: s): { f.radial = s == DeadZoneShape::Radial; } case None: { } };
        match (this.scaled) { case Some(value: v): { f.scaled = v; } case None: { } };
        return f;
    }
}

// A press point's defaults in the `input` record, each part laid over the layer below's on its own. A `release` no layer
// names is three quarters of the `press`.
@generate(Deserializable)
type value PressRecord {
    @field(name: "press", default) public Optional<float32> press = Optional::None;
    @field(name: "release", default) public Optional<float32> release = Optional::None;
    public default ctor make() { }

    public fn void layOver(PressRecord above) {
        match (above.press) { case Some(value: v): { this.press = Optional::Some(value: v); } case None: { } };
        match (above.release) { case Some(value: v): { this.release = Optional::Some(value: v); } case None: { } };
    }

    // The threshold it makes: press at 0.5 where unnamed, release where named.
    public const fn FilterRecord filter() {
        FilterRecord f = FilterRecord.make(kind: FilterKind::Threshold);
        f.a = 0.5;
        match (this.press) { case Some(value: v): { f.a = v; } case None: { } };
        match (this.release) { case Some(value: v): { f.b = v; f.hasB = true; } case None: { } };
        return f;
    }
}

// The engine's defaults for every binding (design/input.md § Decided, 2026-11-23, the third part's question 1): the
// dead zone every stick an entry reads gets, radial where the entry reads both of one stick's axes and per axis
// otherwise, and every trigger's travel, unless the entry's own filters name a `deadZone`. The engine's content sets
// them (engine/content/input.records.json: sticks from 0.125 to 0.925, triggers from 30/255), and each layer above lays
// its own over them part by part, as the app record's window is. A dead zone no layer names is none: the stick raw.
// And (question 2) where a stick's direction bound to a `Digital` presses and lets go, `stickThreshold` (0.5 and 0.375,
// Unity's), unless the entry's own `threshold` says. And (the fourth part, 2026-11-24) the gestures' default times,
// `gestures`, which a gesture naming no time of its own takes (Unity's: a hold 0.4, a tap 0.2, a long tap 0.5, a
// multi-tap's gap 0.75, a repeat 0.5 then every 0.1).
@generate(Deserializable)
type resource InputRecord {
    @field(name: "stickDeadZone", default) Optional<ZoneRecord> stickZoneField = Optional::None;
    @field(name: "triggerDeadZone", default) Optional<ZoneRecord> triggerZoneField = Optional::None;
    @field(name: "stickThreshold", default) Optional<PressRecord> stickPressField = Optional::None;
    @field(name: "gestures", default) Optional<GestureTimes> gestureTimesField = Optional::None;
    @field(name: "note", default) string noteField = "";

    public default ctor make() { }

    // A higher content layer's input record laid over this one: each part it names replaces this one's.
    public fn void layOver(const ref InputRecord above) {
        this.stickZoneField = laidZone(below: this.stickZoneField, above: above.stickZoneField);
        this.triggerZoneField = laidZone(below: this.triggerZoneField, above: above.triggerZoneField);
        this.stickPressField = laidPress(below: this.stickPressField, above: above.stickPressField);
        this.gestureTimesField = laidTimes(below: this.gestureTimesField, above: above.gestureTimesField);
    }

    // The gestures' default times, each None where no layer names it.
    public const fn GestureTimes gestureTimes() {
        return match (this.gestureTimesField) { case Some(value: g): g; case None: GestureTimes.make(); };
    }

    // Every stick's dead zone, None where no layer names one.
    public const fn Optional<FilterRecord> stickDeadZone() { return zoneFilter(zone: this.stickZoneField); }
    // Every trigger's travel's dead zone, None where no layer names one.
    public const fn Optional<FilterRecord> triggerDeadZone() { return zoneFilter(zone: this.triggerZoneField); }
    // Where a stick's direction bound to a `Digital` presses and lets go, None where no layer names it.
    public const fn Optional<FilterRecord> stickThreshold() {
        return match (this.stickPressField) { case Some(value: s): Optional::Some(value: s.filter()); case None: Optional::None; };
    }
    public const fn const ref string note() { return this.noteField; }
}

fn Optional<ZoneRecord> laidZone(Optional<ZoneRecord> below, Optional<ZoneRecord> above) {
    return match (above) {
        case None: below;
        case Some(value: a): match (below) {
            case None: Optional::Some(value: a);
            case Some(value: b): laidOn(below: b, above: a);
        };
    };
}

fn Optional<ZoneRecord> laidOn(ZoneRecord below, ZoneRecord above) {
    ZoneRecord z = below;
    z.layOver(above: above);
    return Optional::Some(value: z);
}

fn Optional<PressRecord> laidPress(Optional<PressRecord> below, Optional<PressRecord> above) {
    return match (above) {
        case None: below;
        case Some(value: a): match (below) {
            case None: Optional::Some(value: a);
            case Some(value: b): pressOn(below: b, above: a);
        };
    };
}

fn Optional<PressRecord> pressOn(PressRecord below, PressRecord above) {
    PressRecord z = below;
    z.layOver(above: above);
    return Optional::Some(value: z);
}

fn Optional<GestureTimes> laidTimes(Optional<GestureTimes> below, Optional<GestureTimes> above) {
    return match (above) {
        case None: below;
        case Some(value: a): match (below) {
            case None: Optional::Some(value: a);
            case Some(value: b): timesOn(below: b, above: a);
        };
    };
}

fn Optional<GestureTimes> timesOn(GestureTimes below, GestureTimes above) {
    GestureTimes z = below;
    z.layOver(above: above);
    return Optional::Some(value: z);
}

fn Optional<FilterRecord> zoneFilter(Optional<ZoneRecord> zone) {
    return match (zone) { case Some(value: z): Optional::Some(value: z.filter()); case None: Optional::None; };
}

// The filters' names as a refusal lists them.
fn string filterNames() {
    return "`deadZone`, `scale`, `invert`, `curve`, `clamp`, `remap`, `normalize`, `digital`, `smooth` or `threshold`";
}

fn Optional<FilterKind> filterKindOf(const ref string name) {
    if (name == "deadZone") { return Optional::Some(value: FilterKind::DeadZone); }
    if (name == "scale") { return Optional::Some(value: FilterKind::Scale); }
    if (name == "invert") { return Optional::Some(value: FilterKind::Invert); }
    if (name == "curve") { return Optional::Some(value: FilterKind::Curve); }
    if (name == "clamp") { return Optional::Some(value: FilterKind::Clamp); }
    if (name == "remap") { return Optional::Some(value: FilterKind::Remap); }
    if (name == "normalize") { return Optional::Some(value: FilterKind::Normalize); }
    if (name == "digital") { return Optional::Some(value: FilterKind::Digital); }
    if (name == "smooth") { return Optional::Some(value: FilterKind::Smooth); }
    if (name == "threshold") { return Optional::Some(value: FilterKind::Threshold); }
    return Optional::None;
}

// The kind of the value the reader stands at, as a word for its refusal.
fn bool isKind(ValueKind k, ValueKind want) {
    return match (k) {
        case Null: match (want) { case Null: true; case _: false; };
        case Bool: match (want) { case Bool: true; case _: false; };
        case Number: match (want) { case Number: true; case _: false; };
        case String: match (want) { case String: true; case _: false; };
        case Array: match (want) { case Array: true; case _: false; };
        case Object: match (want) { case Object: true; case _: false; };
    };
}

// A reader's failure inside filter `name`'s value.
fn Owned<Error> failedIn(Deserializer r, const ref string name) {
    return DeError::inField(error: DeError.make(kind: r.errorKind()), name: copy name);
}

// One filter, the object of one key the reader stands at; a curve's points added to `points`.
fn Result<FilterRecord, Owned<Error>> readFilter(Deserializer r, ref DynamicArray<float32> points) {
    ValueKind k = r.peekKind();
    if (!isKind(k: k, want: ValueKind::Object)) {
        r.failWith(kind: DeErrorKind::TypeMismatch);
        return Result::Err(error: DeError.make(kind: DeErrorKind::TypeMismatch));
    }
    r.beginObject(count: 0);
    if (!r.moreFields()) {
        if (r.failed()) { return Result::Err(error: DeError.make(kind: r.errorKind())); }
        return Result::Err(error: DeError.unknownCase(key: FieldKey::Name(name: "{}"), type: "filter", cases: filterNames()));
    }
    FieldKey key = r.field();
    string name = match (key) { case Name(name: n): copy n; case _: ""; };
    Optional<FilterKind> known = filterKindOf(name: name);
    FilterKind kind = match (known) {
        case Some(value: fk): fk;
        case None: {
            return Result::Err(error: DeError.unknownCase(key: key, type: "filter", cases: filterNames()));
        }
    };
    FilterRecord f = FilterRecord.make(kind: kind);
    ValueKind vk = r.peekKind();
    bool number = isKind(k: vk, want: ValueKind::Number);
    bool truth = isKind(k: vk, want: ValueKind::Bool);
    bool object = isKind(k: vk, want: ValueKind::Object);
    match (kind) {
        case DeadZone: {
            f.b = 1.0;
            if (number) { f.a = r.readF32(); }
            else if (object) {
                Result<DeadZoneParams, Owned<Error>> got = DeadZoneParams.deserialize(r: r);
                match (give got) {
                    case Ok(value: z): {
                        f.a = z.lower;
                        f.b = z.upper;
                        bool radial = match (z.shape) { case Radial: true; case Axial: false; };
                        f.radial = radial;
                        f.scaled = z.scaled;
                    }
                    case Err(error: e): { return Result::Err(error: DeError::inField(error: give e, name: copy name)); }
                };
            } else { r.failWith(kind: DeErrorKind::TypeMismatch); }
        }
        case Scale: {
            f.a = 1.0; f.b = 1.0; f.c = 1.0;
            if (number) {
                float32 s = r.readF32();
                f.a = s; f.b = s; f.c = s;
            } else if (object) {
                Result<AxesParams, Owned<Error>> got = AxesParams.deserialize(r: r);
                match (give got) {
                    case Ok(value: x): { f.a = x.x; f.b = x.y; f.c = x.z; }
                    case Err(error: e): { return Result::Err(error: DeError::inField(error: give e, name: copy name)); }
                };
            } else { r.failWith(kind: DeErrorKind::TypeMismatch); }
        }
        case Invert: {
            f.a = 1.0; f.b = 1.0; f.c = 1.0;
            if (truth) {
                bool all = r.readBool();
                if (all) { f.a = -1.0; f.b = -1.0; f.c = -1.0; }
            } else if (object) {
                Result<InvertParams, Owned<Error>> got = InvertParams.deserialize(r: r);
                match (give got) {
                    case Ok(value: x): {
                        if (x.x) { f.a = -1.0; }
                        if (x.y) { f.b = -1.0; }
                        if (x.z) { f.c = -1.0; }
                    }
                    case Err(error: e): { return Result::Err(error: DeError::inField(error: give e, name: copy name)); }
                };
            } else { r.failWith(kind: DeErrorKind::TypeMismatch); }
        }
        case Curve: {
            f.a = 1.0; f.b = 1.0; f.c = 1.0;
            if (number) {
                float32 e = r.readF32();
                f.a = e; f.b = e; f.c = e;
            } else if (object) {
                Result<CurveParams, Owned<Error>> got = CurveParams.deserialize(r: r);
                match (give got) {
                    case Ok(value: x): {
                        f.a = x.x(); f.b = x.y(); f.c = x.z();
                        if (x.points().length() > 0) {
                            f.points = true;
                            f.pointsFrom = points.length();
                            foreach (const ref NumberPair pair in x.points().iterConst()) {
                                points.add(item: pair.first);
                                points.add(item: pair.second);
                            }
                            f.pointsTo = points.length();
                        }
                    }
                    case Err(error: e): { return Result::Err(error: DeError::inField(error: give e, name: copy name)); }
                };
            } else { r.failWith(kind: DeErrorKind::TypeMismatch); }
        }
        case Clamp: {
            if (object) {
                Result<ClampParams, Owned<Error>> got = ClampParams.deserialize(r: r);
                match (give got) {
                    case Ok(value: x): {
                        match (x.min) { case Some(value: v): { f.a = v; f.hasA = true; } case None: { } };
                        match (x.max) { case Some(value: v): { f.b = v; f.hasB = true; } case None: { } };
                        match (x.length) { case Some(value: v): { f.c = v; f.byLength = true; } case None: { } };
                    }
                    case Err(error: e): { return Result::Err(error: DeError::inField(error: give e, name: copy name)); }
                };
            } else { r.failWith(kind: DeErrorKind::TypeMismatch); }
        }
        case Remap: {
            if (object) {
                Result<RemapParams, Owned<Error>> got = RemapParams.deserialize(r: r);
                match (give got) {
                    case Ok(value: x): { f.a = x.from.first; f.b = x.from.second; f.c = x.to.first; f.d = x.to.second; }
                    case Err(error: e): { return Result::Err(error: DeError::inField(error: give e, name: copy name)); }
                };
            } else { r.failWith(kind: DeErrorKind::TypeMismatch); }
        }
        case Normalize: {
            if (truth) { f.on = r.readBool(); } else { r.failWith(kind: DeErrorKind::TypeMismatch); }
        }
        case Digital: {
            if (truth) { f.on = r.readBool(); } else { r.failWith(kind: DeErrorKind::TypeMismatch); }
        }
        case Smooth: {
            if (number) { f.a = r.readF32(); } else { r.failWith(kind: DeErrorKind::TypeMismatch); }
        }
        case Threshold: {
            if (number) { f.a = r.readF32(); }
            else if (object) {
                Result<ThresholdParams, Owned<Error>> got = ThresholdParams.deserialize(r: r);
                match (give got) {
                    case Ok(value: x): {
                        f.a = x.press;
                        match (x.release) { case Some(value: v): { f.b = v; f.hasB = true; } case None: { } };
                    }
                    case Err(error: e): { return Result::Err(error: DeError::inField(error: give e, name: copy name)); }
                };
            } else { r.failWith(kind: DeErrorKind::TypeMismatch); }
        }
    };
    if (r.failed()) { return Result::Err(error: failedIn(r: r, name: name)); }
    if (r.moreFields()) {
        FieldKey second = r.field();
        return Result::Err(error: DeError.unknownCase(key: second, type: "filter's second key",
                                                      cases: "one key to a filter, each filter its own object: `[ { \"" + name + "\": … }, { … } ]`"));
    }
    r.endObject();
    if (r.failed()) { return Result::Err(error: DeError.make(kind: r.errorKind())); }
    return Result::Ok(value: f);
}

// The gestures' names as a refusal lists them.
fn string gestureNames() {
    return "`hold`, `tap`, `longTap`, `multiTap`, `repeat`, `toggle`, `delay`, `chord`, `sequence` or `interruptible`";
}

fn Optional<GestureKind> gestureKindOf(const ref string name) {
    if (name == "hold") { return Optional::Some(value: GestureKind::Hold); }
    if (name == "tap") { return Optional::Some(value: GestureKind::Tap); }
    if (name == "longTap") { return Optional::Some(value: GestureKind::LongTap); }
    if (name == "multiTap") { return Optional::Some(value: GestureKind::MultiTap); }
    if (name == "repeat") { return Optional::Some(value: GestureKind::Repeat); }
    if (name == "toggle") { return Optional::Some(value: GestureKind::Toggle); }
    if (name == "delay") { return Optional::Some(value: GestureKind::Delay); }
    if (name == "chord") { return Optional::Some(value: GestureKind::Chord); }
    if (name == "sequence") { return Optional::Some(value: GestureKind::Sequence); }
    if (name == "interruptible") { return Optional::Some(value: GestureKind::Interruptible); }
    return Optional::None;
}

// One gesture, the object of one key the reader stands at:
// - `hold`, `tap` and `longTap`: its time in seconds, `true` for the `input` record's, or `{ "seconds": … }`;
// - `multiTap`: its count, `true` for two, or `{ "count": …, "tap": …, "gap": … }`;
// - `repeat`: `true` for the `input` record's times, or `{ "delay": …, "every": …, "limit": … }`;
// - `toggle`: `true` or `false`;
// - `delay`: one time for its on and its off alike, or `{ "start": …, "end": … }`;
// - `chord`: a control's name, a list of them, or `{ "control": …, "action": …, "masks": … }`, each part a name or a list;
// - `sequence`: a list of steps, or `{ "steps": […], "within": …, "masks": … }`, each step a control's name, or
//   `{ "control": … }` (a name or a list, any of which counts) or `{ "action": … }`;
// - `interruptible`: `true`.
fn Result<GestureRecord, Owned<Error>> readGesture(Deserializer r, ref DynamicArray<string> names,
                                                   ref DynamicArray<GestureName> marks) {
    ValueKind k = r.peekKind();
    if (!isKind(k: k, want: ValueKind::Object)) {
        r.failWith(kind: DeErrorKind::TypeMismatch);
        return Result::Err(error: DeError.make(kind: DeErrorKind::TypeMismatch));
    }
    r.beginObject(count: 0);
    if (!r.moreFields()) {
        if (r.failed()) { return Result::Err(error: DeError.make(kind: r.errorKind())); }
        return Result::Err(error: DeError.unknownCase(key: FieldKey::Name(name: "{}"), type: "gesture", cases: gestureNames()));
    }
    FieldKey key = r.field();
    string name = match (key) { case Name(name: n): copy n; case _: ""; };
    Optional<GestureKind> known = gestureKindOf(name: name);
    GestureKind kind = match (known) {
        case Some(value: gk): gk;
        case None: {
            return Result::Err(error: DeError.unknownCase(key: key, type: "gesture", cases: gestureNames()));
        }
    };
    GestureRecord g = GestureRecord.make(kind: kind);
    ValueKind vk = r.peekKind();
    bool number = isKind(k: vk, want: ValueKind::Number);
    bool truth = isKind(k: vk, want: ValueKind::Bool);
    bool object = isKind(k: vk, want: ValueKind::Object);
    bool timed = match (kind) { case Hold: true; case Tap: true; case LongTap: true; case _: false; };
    if (timed) {
        Result<GestureRecord, Owned<Error>> read = readTime(r: r, g: g, number: number, truth: truth, object: object, name: name);
        match (give read) {
            case Ok(value: t): { g = t; }
            case Err(error: e): { return Result::Err(error: give e); }
        };
    }
    match (kind) {
        case Hold: { }
        case Tap: { }
        case LongTap: { }
        case MultiTap: {
            g.count = 2;
            if (number) { g.count = r.readI32(); }
            else if (truth) {
                bool yes = r.readBool();
                if (!yes) { r.failWith(kind: DeErrorKind::TypeMismatch); }
            } else if (object) {
                Result<MultiTapParams, Owned<Error>> got = MultiTapParams.deserialize(r: r);
                match (give got) {
                    case Ok(value: m): {
                        g.count = m.count;
                        match (m.tap) { case Some(value: v): { g.a = v; g.hasA = true; } case None: { } };
                        match (m.gap) { case Some(value: v): { g.b = v; g.hasB = true; } case None: { } };
                    }
                    case Err(error: e): { return Result::Err(error: DeError::inField(error: give e, name: copy name)); }
                };
            } else { r.failWith(kind: DeErrorKind::TypeMismatch); }
        }
        case Repeat: {
            if (truth) {
                bool yes = r.readBool();
                if (!yes) { r.failWith(kind: DeErrorKind::TypeMismatch); }
            } else if (object) {
                Result<RepeatParams, Owned<Error>> got = RepeatParams.deserialize(r: r);
                match (give got) {
                    case Ok(value: p): {
                        match (p.delay) { case Some(value: v): { g.a = v; g.hasA = true; } case None: { } };
                        match (p.every) { case Some(value: v): { g.b = v; g.hasB = true; } case None: { } };
                        g.count = p.limit;
                        g.system = p.system;
                    }
                    case Err(error: e): { return Result::Err(error: DeError::inField(error: give e, name: copy name)); }
                };
            } else { r.failWith(kind: DeErrorKind::TypeMismatch); }
        }
        case Toggle: {
            if (truth) { g.on = r.readBool(); } else { r.failWith(kind: DeErrorKind::TypeMismatch); }
        }
        case Delay: {
            if (number) {
                float64 both = r.readF64();
                g.a = both;
                g.b = both;
            } else if (object) {
                Result<DelayParams, Owned<Error>> got = DelayParams.deserialize(r: r);
                match (give got) {
                    case Ok(value: p): { g.a = p.start; g.b = p.end; }
                    case Err(error: e): { return Result::Err(error: DeError::inField(error: give e, name: copy name)); }
                };
            } else { r.failWith(kind: DeErrorKind::TypeMismatch); }
        }
        case Chord: {
            Optional<Owned<Error>> wrong = readChord(r: r, g: g, names: names, marks: marks);
            match (give wrong) {
                case Some(value: e): { return Result::Err(error: DeError::inField(error: give e, name: copy name)); }
                case None: { }
            };
        }
        case Sequence: {
            Optional<Owned<Error>> wrong = readSequence(r: r, g: g, names: names, marks: marks);
            match (give wrong) {
                case Some(value: e): { return Result::Err(error: DeError::inField(error: give e, name: copy name)); }
                case None: { }
            };
        }
        case Interruptible: {
            if (truth) { g.on = r.readBool(); } else { r.failWith(kind: DeErrorKind::TypeMismatch); }
        }
    };
    if (r.failed()) { return Result::Err(error: failedIn(r: r, name: name)); }
    if (r.moreFields()) {
        FieldKey second = r.field();
        return Result::Err(error: DeError.unknownCase(key: second, type: "gesture's second key",
                                                      cases: "one key to a gesture, each gesture its own object: `[ { \"" + name + "\": … }, { … } ]`"));
    }
    r.endObject();
    if (r.failed()) { return Result::Err(error: DeError.make(kind: r.errorKind())); }
    return Result::Ok(value: g);
}

// A `hold`'s, a `tap`'s or a `longTap`'s time: a number, `true` for the `input` record's, or `{ "seconds": … }`; the
// parameters' own refusal handed back, inside the gesture's name.
fn Result<GestureRecord, Owned<Error>> readTime(Deserializer r, GestureRecord g, bool number, bool truth, bool object,
                                                const ref string name) {
    GestureRecord made = g;
    if (number) {
        made.a = r.readF64();
        made.hasA = true;
    } else if (truth) {
        bool yes = r.readBool();
        if (!yes) { r.failWith(kind: DeErrorKind::TypeMismatch); }
    } else if (object) {
        Result<TimeParams, Owned<Error>> got = TimeParams.deserialize(r: r);
        match (give got) {
            case Ok(value: p): { match (p.seconds) { case Some(value: v): { made.a = v; made.hasA = true; } case None: { } }; }
            case Err(error: e): { return Result::Err(error: DeError::inField(error: give e, name: copy name)); }
        };
    } else { r.failWith(kind: DeErrorKind::TypeMismatch); }
    return Result::Ok(value: made);
}

// Names the reader stands at, a string or a list of them, into `names`, each marked an action's where `action`, of step
// `step`.
fn void readNames(Deserializer r, ref DynamicArray<string> names, ref DynamicArray<GestureName> marks, bool action,
                  int32 step) {
    ValueKind k = r.peekKind();
    if (isKind(k: k, want: ValueKind::String)) {
        names.add(item: r.readString());
        marks.add(item: GestureName.make(action: action, step: step));
    } else if (isKind(k: k, want: ValueKind::Array)) {
        r.beginArray();
        while (r.moreElems()) {
            names.add(item: r.readString());
            marks.add(item: GestureName.make(action: action, step: step));
        }
    } else { r.failWith(kind: DeErrorKind::TypeMismatch); }
}

// A chord: a control's name, a list of them, or `{ "control": …, "action": …, "masks": … }`; why it is refused, or None.
fn Optional<Owned<Error>> readChord(Deserializer r, ref GestureRecord g, ref DynamicArray<string> names,
                                    ref DynamicArray<GestureName> marks) {
    g.namesFrom = names.length();
    ValueKind k = r.peekKind();
    if (isKind(k: k, want: ValueKind::Object)) {
        r.beginObject(count: 0);
        while (r.moreFields()) {
            FieldKey key = r.field();
            string part = match (key) { case Name(name: n): copy n; case _: ""; };
            if (part == "control") { readNames(r: r, names: names, marks: marks, action: false, step: 0); }
            else if (part == "action") { readNames(r: r, names: names, marks: marks, action: true, step: 0); }
            else if (part == "masks") { g.masks = r.readBool(); }
            else { return Optional::Some(value: DeError.unknownCase(key: key, type: "chord's part", cases: "`control`, `action` or `masks`")); }
            if (r.failed()) { return Optional::Some(value: DeError::inField(error: DeError.make(kind: r.errorKind()), name: give part)); }
        }
        r.endObject();
    } else {
        readNames(r: r, names: names, marks: marks, action: false, step: 0);
    }
    g.namesTo = names.length();
    if (r.failed()) { return Optional::Some(value: DeError.make(kind: r.errorKind())); }
    return Optional::None;
}

// One step of a sequence, numbered `step`: a control's name, or `{ "control": … }` or `{ "action": … }`.
fn Optional<Owned<Error>> readStep(Deserializer r, ref DynamicArray<string> names, ref DynamicArray<GestureName> marks,
                                   int32 step) {
    ValueKind k = r.peekKind();
    if (isKind(k: k, want: ValueKind::String)) {
        names.add(item: r.readString());
        marks.add(item: GestureName.make(action: false, step: step));
        return Optional::None;
    }
    if (!isKind(k: k, want: ValueKind::Object)) {
        r.failWith(kind: DeErrorKind::TypeMismatch);
        return Optional::Some(value: DeError.make(kind: r.errorKind()));
    }
    r.beginObject(count: 0);
    while (r.moreFields()) {
        FieldKey key = r.field();
        string part = match (key) { case Name(name: n): copy n; case _: ""; };
        if (part == "control") { readNames(r: r, names: names, marks: marks, action: false, step: step); }
        else if (part == "action") { readNames(r: r, names: names, marks: marks, action: true, step: step); }
        else { return Optional::Some(value: DeError.unknownCase(key: key, type: "sequence step's part", cases: "`control` or `action`")); }
        if (r.failed()) { return Optional::Some(value: DeError::inField(error: DeError.make(kind: r.errorKind()), name: give part)); }
    }
    r.endObject();
    if (r.failed()) { return Optional::Some(value: DeError.make(kind: r.errorKind())); }
    return Optional::None;
}

// A list of steps, the reader at its `[`, into `names`; why it is refused, or None. `count` takes how many.
fn Optional<Owned<Error>> readSteps(Deserializer r, ref GestureRecord g, ref DynamicArray<string> names,
                                    ref DynamicArray<GestureName> marks) {
    r.beginArray();
    int32 step = 0;
    while (r.moreElems()) {
        Optional<Owned<Error>> wrong = readStep(r: r, names: names, marks: marks, step: step);
        match (give wrong) {
            case Some(value: e): { return Optional::Some(value: DeError::inElement(error: give e, index: cast<isize>(step))); }
            case None: { }
        };
        step = step + 1;
    }
    g.count = step;
    if (r.failed()) { return Optional::Some(value: DeError.make(kind: r.errorKind())); }
    return Optional::None;
}

// A sequence: a list of steps, or `{ "steps": […], "within": …, "masks": … }`; why it is refused, or None.
fn Optional<Owned<Error>> readSequence(Deserializer r, ref GestureRecord g, ref DynamicArray<string> names,
                                       ref DynamicArray<GestureName> marks) {
    g.namesFrom = names.length();
    ValueKind k = r.peekKind();
    if (isKind(k: k, want: ValueKind::Array)) {
        Optional<Owned<Error>> wrong = readSteps(r: r, g: g, names: names, marks: marks);
        match (give wrong) { case Some(value: e): { return Optional::Some(value: give e); } case None: { } };
    } else if (isKind(k: k, want: ValueKind::Object)) {
        r.beginObject(count: 0);
        while (r.moreFields()) {
            FieldKey key = r.field();
            string part = match (key) { case Name(name: n): copy n; case _: ""; };
            if (part == "steps") {
                ValueKind sk = r.peekKind();
                if (!isKind(k: sk, want: ValueKind::Array)) {
                    r.failWith(kind: DeErrorKind::TypeMismatch);
                    return Optional::Some(value: DeError::inField(error: DeError.make(kind: r.errorKind()), name: "steps"));
                }
                Optional<Owned<Error>> wrong = readSteps(r: r, g: g, names: names, marks: marks);
                match (give wrong) {
                    case Some(value: e): { return Optional::Some(value: DeError::inField(error: give e, name: "steps")); }
                    case None: { }
                };
            } else if (part == "within") {
                g.a = r.readF64();
                g.hasA = true;
            } else if (part == "masks") {
                g.masks = r.readBool();
            } else {
                return Optional::Some(value: DeError.unknownCase(key: key, type: "sequence's part", cases: "`steps`, `within` or `masks`"));
            }
            if (r.failed()) { return Optional::Some(value: DeError::inField(error: DeError.make(kind: r.errorKind()), name: give part)); }
        }
        r.endObject();
    } else {
        r.failWith(kind: DeErrorKind::TypeMismatch);
    }
    g.namesTo = names.length();
    if (r.failed()) { return Optional::Some(value: DeError.make(kind: r.errorKind())); }
    return Optional::None;
}
